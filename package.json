{
  "name": "faako-new",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:portfolio": "pnpm --filter @faako/bynana-portfolio run dev",
    "dev:faako": "pnpm run predeploy:faako-api && node ./scripts/dev-faako.mjs",
    "dev:dev-erp": "pnpm --filter @faako/dev-erp run dev:with-backend",
    "dev:reebs": "pnpm --filter @faako/reebs-website run dev:with-backend",
    "dev:stroane": "pnpm --filter @faako/stroane-web run dev:with-backend",
    "dev:workbench": "pnpm --filter @faako/ui-workbench run dev",
    "dev:starter": "pnpm --filter @faako/system-starter run dev",
    "affected:apps": "node ./scripts/affected-apps.mjs",
    "monitoring:check": "node ./scripts/check-monorepo-app-registry.mjs",
    "project-registry:check": "node ./scripts/check-project-registry.mjs",
    "hosting:check": "node ./scripts/check-cloudflare-railway-readiness.mjs",
    "db:refresh:local": "node ./scripts/refresh-local-dbs.mjs",
    "db:refresh:local:dry": "node ./scripts/refresh-local-dbs.mjs --dry-run",
    "db:refresh:local:biweekly": "node ./scripts/refresh-local-dbs.mjs --due-days 14 --yes",
    "predeploy:dev-erp": "pnpm --filter @faako/dev-erp run predeploy:local",
    "predeploy:faako-api": "pnpm --filter @faako/faako-api run predeploy:local",
    "predeploy:faako": "pnpm run predeploy:faako-api",
    "predeploy:reebs-portal": "pnpm --filter @faako/reebs-portal run predeploy:local",
    "predeploy:reebs": "pnpm run predeploy:reebs-portal",
    "predeploy:stroane": "pnpm --filter @faako/stroane-web run predeploy:local",
    "predeploy:local:migrate": "pnpm run predeploy:dev-erp && pnpm run predeploy:faako-api && pnpm run predeploy:reebs-portal && pnpm run predeploy:stroane",
    "predeploy:local": "pnpm run predeploy:local:migrate",
    "predeploy:all": "pnpm run predeploy:local:migrate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:python": "node ./scripts/run-reebs-analytics-tests.mjs",
    "check": "node ./scripts/run-quality-checks.mjs",
    "create:app": "node ./scripts/create-app-from-reference.mjs",
    "security:scan": "node ./scripts/security-scan.mjs",
    "security:gate": "node ./scripts/security-gate.mjs",
    "security:deps": "node ./scripts/security-deps.mjs",
    "security:all": "pnpm run security:scan && pnpm run security:gate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^20.12.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "react-helmet": "^6.1.0"
  }
}
