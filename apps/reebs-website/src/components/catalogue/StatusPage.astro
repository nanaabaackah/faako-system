---
const {
  code,
  eyebrow,
  title,
  message,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  tertiaryHref = "",
  tertiaryLabel = "",
} = Astro.props;
---

<main class="status-page" id="main">
  <section class="status-card" aria-labelledby={`status-heading-${code}`}>
    <div class="status-code" aria-hidden="true">{code}</div>
    <div class="status-copy">
      <p class="status-eyebrow">{eyebrow}</p>
      <h1 id={`status-heading-${code}`}>{title}</h1>
      <p>{message}</p>
      <div class="status-actions">
        <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
        <a class="btn btn-secondary" href={secondaryHref}>{secondaryLabel}</a>
        {tertiaryHref && tertiaryLabel ? (
          <a class="btn btn-secondary" href={tertiaryHref}>{tertiaryLabel}</a>
        ) : null}
      </div>
    </div>
  </section>
</main>

<style>
  .status-page {
    width: min(1180px, calc(100% - 2rem));
    min-height: 72vh;
    margin: auto;
    padding: clamp(8rem, 13vw, 11rem) 0 clamp(4rem, 8vw, 7rem);
    display: grid;
    align-items: center;
  }
  .status-card {
    display: grid;
    grid-template-columns: minmax(12rem, .55fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 5vw, 4rem);
    border: 1px solid rgba(var(--back3-rgb), .15);
    border-radius: clamp(1.5rem, 4vw, 3rem);
    background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(var(--other-rgb),.08));
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .status-code {
    color: var(--back);
    font: 800 clamp(6rem, 17vw, 12rem)/.78 var(--font-heading);
    letter-spacing: -.08em;
    text-align: center;
    text-shadow: var(--heading-shadow);
  }
  .status-copy { display: grid; gap: 1rem; max-width: 42rem; }
  .status-eyebrow {
    color: var(--back3);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .status-copy h1 { font-size: clamp(2.4rem, 6vw, 5rem); }
  .status-copy > p:last-of-type { max-width: 58ch; color: var(--text-subtle); }
  .status-actions { display: flex; flex-wrap: wrap; gap: .75rem; padding-top: .5rem; }
  @media (max-width: 720px) {
    .status-page { min-height: 68vh; padding-top: 7.5rem; }
    .status-card { grid-template-columns: 1fr; text-align: center; }
    .status-copy { justify-items: center; }
    .status-actions { width: 100%; }
    .status-actions .btn { flex: 1 1 100%; min-height: 3rem; }
  }
</style>
