---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusPage from "../components/catalogue/StatusPage.astro";
import SiteFooter from "../components/catalogue/SiteFooter.astro";
import SiteHeader from "../components/catalogue/SiteHeader.astro";
---

<BaseLayout
  path="/404"
  status={404}
  title="Page Not Found | REEBS Party Themes"
  description="The REEBS page you requested could not be found."
  noIndex
>
  <SiteHeader />
  <StatusPage
    code="404"
    eyebrow="Page not found"
    title="That page is not at this address."
    message="The link may be old or the item may have moved. Browse current rentals or ask the REEBS team to help you find it."
    primaryHref="/rentals"
    primaryLabel="Browse rentals"
    secondaryHref="/"
    secondaryLabel="Go home"
  />
  <SiteFooter />
</BaseLayout>
