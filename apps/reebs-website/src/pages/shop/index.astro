---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShopIsland from "../../components/islands/ShopIsland.jsx";
import {
  getPublicCategories,
  getPublicCategoryItems,
} from "../../content/publicCatalogue.js";

const initialInventory = getPublicCategories("shop")
  .flatMap((category) =>
    getPublicCategoryItems("shop", category.slug).slice(0, 3),
  )
  .map((item) => ({
  ...item,
  productId: item.id,
  sourceCategory: item.category,
  sourceCategoryCode: "PARTY",
  specificCategory: item.category,
  imageUrl: item.image,
  quantity: item.availability === "in-stock" ? 1 : 0,
  status: item.availability !== "out-of-stock",
  }));
---

<BaseLayout path="/shop">
  <h1 class="sr-only">Party supplies shop</h1>
  <ShopIsland
    path={`/shop${Astro.url.search}`}
    initialInventory={initialInventory}
    client:load
  />
</BaseLayout>
