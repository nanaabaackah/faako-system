---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusPage from "../components/catalogue/StatusPage.astro";
import SiteFooter from "../components/catalogue/SiteFooter.astro";
import SiteHeader from "../components/catalogue/SiteHeader.astro";
---

<BaseLayout
  path="/500"
  status={500}
  title="Service Unavailable | REEBS Party Themes"
  description="REEBS could not load this page right now."
  noIndex
>
  <SiteHeader />
  <StatusPage
    code="500"
    eyebrow="Temporary problem"
    title="We could not finish loading this page."
    message="Please try a stable page below. If you need immediate booking support, the REEBS team is available on WhatsApp."
    primaryHref="/500"
    primaryLabel="Try again"
    secondaryHref="/"
    secondaryLabel="Go home"
    tertiaryHref="https://wa.me/233244238419"
    tertiaryLabel="WhatsApp REEBS"
  />
  <SiteFooter />
</BaseLayout>
