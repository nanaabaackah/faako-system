---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookIsland from "../components/islands/BookIsland.jsx";
import { publicRentals } from "../content/publicCatalogue.js";

const initialRentals = publicRentals.map((item) => ({
  ...item,
  productId: item.id,
  sourceCategoryCode: "RENTAL",
  specificCategory: item.category,
  imageUrl: item.image,
  quantity: item.availability === "out-of-stock" ? 0 : 1,
  status: item.availability !== "out-of-stock",
}));
---

<BaseLayout path="/book">
  <BookIsland
    path={`/book${Astro.url.search}`}
    initialRentals={initialRentals}
    client:load
  />
</BaseLayout>
