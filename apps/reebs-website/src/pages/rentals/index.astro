---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RentalsIsland from "../../components/islands/RentalsIsland.jsx";
import { publicRentals } from "../../content/publicCatalogue.js";

const initialRentals = publicRentals.map((item) => ({
  ...item,
  productId: item.id,
  sourceCategoryCode: "RENTAL",
  specificCategory: item.category,
  imageUrl: item.image,
  quantity: item.availability === "out-of-stock" ? 0 : 1,
  status: item.availability !== "out-of-stock",
}));
---

<BaseLayout path="/rentals">
  <h1 class="sr-only">Party rentals</h1>
  <RentalsIsland
    path={`/rentals${Astro.url.search}`}
    initialRentals={initialRentals}
    client:load
  />
</BaseLayout>
