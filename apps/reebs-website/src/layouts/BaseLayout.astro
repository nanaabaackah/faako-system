---
import "@faako/theme/system.css";
import "@faako/ui/compat.css";
import "../index.css";
import AnalyticsIsland from "../components/islands/AnalyticsIsland.jsx";
import ClientSetupIsland from "../components/islands/ClientSetupIsland.jsx";
import CookieConsentIsland from "../components/islands/CookieConsentIsland.jsx";
import {
  DEFAULT_IMAGE,
  SITE_NAME,
  SITE_URL,
  buildStructuredData,
  getSeoForPath,
} from "../utils/seo.js";

const {
  path = Astro.url.pathname,
  status = 200,
  title,
  description,
  image,
  type,
  noIndex,
  structuredData = null,
} = Astro.props;
const normalizedPath = path === "/" ? "/" : path.replace(/\/+$/, "");
const routeSeo = getSeoForPath(normalizedPath);
const seo = {
  ...routeSeo,
  ...(title ? { title } : {}),
  ...(description ? { description } : {}),
  ...(image ? { image } : {}),
  ...(type ? { type } : {}),
  ...(typeof noIndex === "boolean" ? { noIndex } : {}),
};
const canonical = new URL(normalizedPath, SITE_URL).toString();
const socialImage = new URL(seo.image || DEFAULT_IMAGE, SITE_URL).toString();
const schema = buildStructuredData(normalizedPath, seo, structuredData);
const serializedSchema = JSON.stringify(schema).replace(/</g, "\\u003c");

if (status !== 200) Astro.response.status = status;
---

<!doctype html>
<html
  lang="en-GH"
  data-theme="light"
  data-faako-theme="reebs-website"
  data-security-profile="public-interactive"
  data-auth-mode="cookie"
  data-faako-app="@faako/reebs-website"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#f6f7f9" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content={SITE_NAME} />
    <meta
      name="robots"
      content={seo.noIndex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-GH" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/site.webmanifest" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GH" />
    <meta property="og:type" content={seo.type || "website"} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="REEBS Party Themes event setup and rental showcase"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="REEBS Party Themes event setup and rental showcase"
    />
    <script is:inline type="application/ld+json" set:html={serializedSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
    <CookieConsentIsland client:load />
    <AnalyticsIsland path={normalizedPath} client:load />
    <ClientSetupIsland client:idle={{ timeout: 1200 }} />
    <noscript>
      <p class="noscript-note">
        Public information and navigation remain available without JavaScript.
        Cart, filters, booking, checkout, and account actions require JavaScript.
      </p>
    </noscript>
    <script>
      document.documentElement.classList.add("js");

      document.addEventListener(
        "click",
        (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;

          const anchor =
            event.target instanceof Element
              ? event.target.closest("a[href]")
              : null;
          if (
            !(anchor instanceof HTMLAnchorElement) ||
            anchor.target ||
            anchor.hasAttribute("download")
          ) return;

          const destination = new URL(anchor.href, window.location.href);
          if (destination.origin !== window.location.origin) return;

          event.preventDefault();
          event.stopImmediatePropagation();
          window.location.assign(destination.href);
        },
        true,
      );
    </script>
  </body>
</html>
