# Copy this file to .env.development for local work.
# Website frontend env only. Portal/backend secrets live in apps/reebs-portal/.env.example.
APP_ENV="development"

VITE_GOOGLE_MAPS_KEY=""
VITE_GA_MEASUREMENT_ID=""
# Legacy alias supported for existing deploy settings.
VITE_GA_ID=""
VITE_ENABLE_GA_IN_DEV="false"
VITE_CURRENCY_API_KEY=""
VITE_EXCHANGE_API_KEY=""
VITE_API_BASE_URL="http://localhost:8888"
# Legacy fallback only. Prefer VITE_API_BASE_URL for the REEBS API wrapper.
VITE_BACKEND_BASE_URL=""
VITE_REEBS_PORTAL_URL="http://localhost:5174"

# Development proxy overrides. Catalogue refresh also accepts
# REEBS_API_BASE_URL and BACKEND_BASE_URL as server-side process variables.
REEBS_API_PROXY_TARGET=""
VITE_API_PROXY_TARGET=""
