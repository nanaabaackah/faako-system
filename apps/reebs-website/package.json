{
  "name": "@faako/reebs-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0 --port 5173",
    "dev:frontend": "VITE_API_BASE_URL=http://localhost:8888 VITE_REEBS_PORTAL_URL=http://localhost:5174 pnpm run dev",
    "dev:with-backend": "pnpm --dir ../reebs-portal run predeploy:local && concurrently -k -n backend,portal,website -c magenta,cyan,blue \"pnpm --dir ../reebs-portal run dev:backend\" \"pnpm --dir ../reebs-portal run dev:frontend\" \"pnpm run dev:frontend\"",
    "catalogue:refresh": "node scripts/refreshPublicCatalogue.mjs",
    "sitemap": "node scripts/generateSitemap.mjs",
    "sitemap:check": "node scripts/generateSitemap.mjs --check",
    "sitemap:refresh": "pnpm run catalogue:refresh",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/finalizeStaticHeaders.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "check": "pnpm run typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e-smoke.mjs",
    "test:e2e:ui": "PORT=5173 npx playwright test --ui",
    "test:e2e:all": "concurrently \"pnpm --dir ../reebs-portal run dev:backend\" \"pnpm --dir ../reebs-portal run dev:frontend\" \"pnpm run dev:frontend\" \"pnpm run test:e2e\""
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@faako/api-client": "workspace:*",
    "@faako/core": "workspace:*",
    "@faako/finance": "workspace:*",
    "@faako/theme": "workspace:*",
    "@faako/types": "workspace:*",
    "@faako/ui": "workspace:*",
    "@faako/utils": "workspace:*",
    "@faako/validation": "workspace:*",
    "@react-google-maps/api": "^2.20.7",
    "animejs": "^4.3.6",
    "click-spark": "^2.1.0",
    "framer-motion": "^12.23.6",
    "iconsax": "^0.0.1",
    "iconsax-react": "^0.0.8",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "papaparse": "^5.5.3",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.3",
    "react-tsparticles": "^2.12.2",
    "astro": "^7.1.3",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "axe-playwright": "^2.2.2",
    "babel-jest": "^30.0.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest": "^30.0.4",
    "playwright": "^1.55.1",
    "postcss": "^8.5.5",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.2"
  }
}
