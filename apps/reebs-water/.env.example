# Browser-reachable REEBS API origin for deployment. Leave blank for local Vite proxy use.
# Use an absolute HTTPS origin (no /api suffix) in the matching Cloudflare build environment.
# This example file is not loaded by Vite; configure the deployed build separately.
VITE_API_BASE_URL=https://staging-api.reebspartythemes.com
# Vite development server proxy target; not exposed to the browser.
VITE_API_PROXY_TARGET=http://localhost:8888
