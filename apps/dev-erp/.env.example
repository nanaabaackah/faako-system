# Copy this file to .env.development for local work and replace placeholders.
# Frontend-only vars for the static frontend host.
# Keep this blank in .env.development so local Vite proxies /api to the local backend.
# A Railway API hostname is supported for the hosted split deployment.
# Prefer no trailing slash, for example https://app-production.up.railway.app.
# A same-site custom API hostname must be registered on Railway and CNAME to the
# Railway-provided DNS target. Do not point the API hostname at Cloudflare Pages.
VITE_API_BASE=""
VITE_DEFAULT_ORG_SLUG="company"
VITE_AUTH_CSRF_COOKIE_NAME="app_csrf"
# Browser-visible fallback only. The frontend also hydrates the current display
# rate from /api/currency/display-rate when the backend currency API is configured.
VITE_CAD_TO_GHS_RATE="1"
VITE_GA_MEASUREMENT_ID=""
VITE_ENABLE_GA_IN_DEV="false"
# Local dev only: Vite proxy target for /api during `pnpm dev`.
VITE_API_PROXY_TARGET="http://localhost:8080"

# Backend vars for the Railway API service.
APP_ENV="development"
DATABASE_URL_DEVELOPMENT="postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>"
# DATABASE_URL_PRODUCTION="postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>"
# Display-only fallback for backend reports, emails, and the frontend rate endpoint.
CAD_TO_GHS_RATE="1"
# Optional server-side currency API. Keep keys backend-only. CURRENCY_API_URL can
# include {base}/{from}/{source}=CAD, {target}/{to}=GHS, and {apiKey}/{key}.
# Common response shapes are supported: rates.GHS, conversion_rates.GHS,
# data.GHS.value, quotes.CADGHS, conversion_rate, or a numeric rate/result.
CURRENCY_API_URL=""
CURRENCY_API_KEY=""
CURRENCY_API_KEY_HEADER="apikey"
CURRENCY_API_KEY_QUERY_PARAM=""
CURRENCY_RATE_CACHE_TTL_MS="3600000"
CURRENCY_API_TIMEOUT_MS="8000"
DATABASE_SSL_MODE="disable"
# DATABASE_SSL_REJECT_UNAUTHORIZED="true"
# DATABASE_SSL_CA="paste_ca_certificate_here"
ENFORCE_DATABASE_ISOLATION="true"
JWT_SECRET="replace_with_secure_jwt_secret"
# Keep local development on lax cookies unless the local setup is HTTPS.
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"
# Direct browser-to-Railway API setup:
# AUTH_COOKIE_SAME_SITE="none"
# AUTH_COOKIE_SECURE="true"
# Optional HTTPS frontend + same-site custom API hostname:
# AUTH_COOKIE_SAME_SITE="lax"
# AUTH_COOKIE_SECURE="true"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://app.example.com"
RATE_LIMIT_MAX="1000"
RATE_LIMIT_WINDOW_MS="900000"
APP_BASE_URL="https://app.example.com"
# Optional hosted surface monitoring. Leave blank until an override is needed.
DEV_ERP_API_BASE_URL=""
DEV_API_BASE_URL=""
REEBS_PORTAL_BASE_URL=""
REEBS_API_BASE_URL=""
REEBS_BACKEND_BASE_URL=""
STROANE_WEB_BASE_URL=""
STROANE_PORTAL_BASE_URL=""
STROANE_API_BASE_URL=""
STROANE_BACKEND_BASE_URL=""
FAAKO_WEBSITE_BASE_URL=""
FAAKO_API_BASE_URL=""
FAAKO_API_URL=""
REEBS_WEBSITE_BASE_URL=""
BYNANA_PORTFOLIO_BASE_URL=""
FAAKO_ERP_BASE_URL=""
# Optional internal app monitoring. Leave blank until these apps have hosted URLs.
SYSTEM_STARTER_BASE_URL=""
UI_WORKBENCH_BASE_URL=""
SITE_STATUS_TIMEOUT_MS="12000"
SITE_STATUS_CONCURRENCY="8"
# Server-only Railway webhook secret. Configure Railway to POST to
# /api/webhooks/railway with Authorization: Bearer <secret>, one of the
# accepted webhook secret headers, or ?secret=<secret>.
RAILWAY_WEBHOOK_SECRET=""
OAUTH_TOKEN_ENCRYPTION_KEY="replace_with_64_char_hex_key"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace_with_temp_admin_password"
BY_NANA_ORG_NAME="Company Name"
BY_NANA_ORG_SLUG="company"
REEBS_DATABASE_URL=""
FAAKO_DATABASE_URL=""
STROANE_DATABASE_URL=""
REEBS_DATABASE_SSL_REJECT_UNAUTHORIZED="false"
FAAKO_DATABASE_SSL_REJECT_UNAUTHORIZED="false"
STROANE_DATABASE_SSL_REJECT_UNAUTHORIZED="false"
ACCOUNT_INVITE_FROM_EMAIL="accounts@example.com"
RESEND_API_KEY="your_resend_api_key_here"
ALERT_EMAIL_ENABLED="true"
ALERT_EMAIL_RECIPIENTS="alerts@example.com"
SMS_NOTIFICATIONS_AVAILABLE="false"
ALERT_SMS_ENABLED="false"
ALERT_SMS_RECIPIENTS="+15550102000"
ALERT_NOTIFY_OFFLINE="true"
ALERT_NOTIFY_DEGRADED="true"
ALERT_COOLDOWN_MS="900000"
SMS_ALLOW_NON_PRODUCTION="false"
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15550102000"
EMAIL_SENDER_NAME="Company Name"
ACCOUNT_SETUP_TOKEN_TTL_HOURS="72"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://api.example.com/api/integrations/google/callback"
GOOGLE_WEBHOOK_URL="https://api.example.com/api/webhooks/google-calendar"
RENT_QUARTERLY_EMAIL_ENABLED="true"
RENT_QUARTERLY_EMAIL_HOUR_UTC="09"
RENT_QUARTERLY_EMAIL_MINUTE_UTC="00"
RENT_QUARTERLY_FROM_EMAIL="billing@example.com"
RENT_REPLY_TO_EMAIL=""
ACCOUNTING_REMINDER_EMAIL_ENABLED="true"
ACCOUNTING_REMINDER_EMAIL_HOUR_UTC="09"
ACCOUNTING_REMINDER_EMAIL_MINUTE_UTC="00"
ACCOUNTING_REMINDER_DAYS_BEFORE_DUE="2"
ACCOUNTING_REMINDER_FROM_EMAIL="billing@example.com"
INVOICE_FROM_EMAIL="billing@example.com"

# Paystack foundation only. These are server-side env values for future
# invoice/payment workflows; no live Paystack payment-link generation is wired yet.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_CALLBACK_URL="https://api.example.com/api/payments/paystack/callback"
PAYSTACK_CURRENCY="GHS"
