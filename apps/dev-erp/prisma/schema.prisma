generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   Int            @id @default(autoincrement())
  name                 String
  slug                 String         @unique
  status               OrgStatus      @default(ACTIVE)
  parentOrganizationId Int?
  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[] @relation("OrganizationHierarchy")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  roles                    Role[]
  users                    User[]
  bookings                 Booking[]
  bookingSettings          BookingSettings?
  calendarIntegrations     CalendarIntegration[]
  accountingEntries        AccountingEntry[]
  invoices                 Invoice[]
  invoicePayments          InvoicePayment[]
  invoicePaymentLedger     InvoicePaymentLedgerEntry[]
  paymentIdempotencyClaims PaymentIdempotencyClaim[]
  proposals                Proposal[]
  commercialCatalogueItems CommercialCatalogueItem[]
  commercialPackages       CommercialPackage[]
  productivityEntries      ProductivityEntry[]
  productivityTodos        ProductivityTodo[]
  rentTenants              RentTenant[]
  rentPayments             RentPayment[]
  projects                 Project[]
  projectTasks             ProjectTask[]
  trelloConnection         TrelloConnection?
  trelloWebhookEvents      TrelloWebhookEvent[]
  monitoringIncidents      MonitoringIncident[]
  alertRules               AlertRule[]
  notificationChannels     MonitoringNotificationChannel[]
  escalationPolicies       EscalationPolicy[]
  maintenanceWindows       MaintenanceWindow[]
  monitoringNotifications  MonitoringNotification[]

  @@index([parentOrganizationId])
}

model Role {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  permissions    Json?

  users User[]

  @@unique([organizationId, name])
}

model User {
  id                      Int                         @id @default(autoincrement())
  organizationId          Int
  organization            Organization                @relation(fields: [organizationId], references: [id])
  roleId                  Int
  role                    Role                        @relation(fields: [roleId], references: [id])
  firstName               String
  lastName                String
  fullName                String
  email                   String                      @unique
  password                String
  status                  UserStatus                  @default(ACTIVE)
  tokenVersion            Int                         @default(0)
  loginAttempts           Int                         @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  createdProposals        Proposal[]                  @relation("ProposalCreatedBy")
  editedProposals         Proposal[]                  @relation("ProposalLastEditedBy")
  ownedProjects           Project[]                   @relation("ProjectOwner")
  assignedProjectTasks    ProjectTask[]               @relation("ProjectTaskAssignee")
  productivityEntries     ProductivityEntry[]
  productivityTodos       ProductivityTodo[]
  refreshTokens           RefreshToken[]
  recordedInvoicePayments InvoicePayment[]            @relation("InvoicePaymentRecordedBy")
  verifiedInvoicePayments InvoicePayment[]            @relation("InvoicePaymentVerifiedBy")
  rejectedInvoicePayments InvoicePayment[]            @relation("InvoicePaymentRejectedBy")
  paymentLedgerEntries    InvoicePaymentLedgerEntry[] @relation("PaymentLedgerActor")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  action         String
  targetType     String?
  targetId       String?
  appKey         String?
  environment    String?
  source         String?
  category       String?
  severity       String?
  status         String?
  summary        String?
  actorType      String?
  actorLabel     String?
  requestId      String?
  externalRef    String?  @unique
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, action, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([source, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
}

model Booking {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  organization     Organization      @relation(fields: [organizationId], references: [id])
  externalId       String?
  source           BookingSource     @default(MANUAL)
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  location         String?
  meetingLink      String?
  calendarEventId  String?
  calendarProvider CalendarProvider?
  status           BookingStatus     @default(CONFIRMED)
  attendeeEmail    String?
  attendeeName     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, externalId, source])
  @@index([organizationId, calendarProvider, calendarEventId])
  @@index([organizationId, startAt])
}

model BookingSettings {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  bookingLink     String?
  calendarEmail   String?
  defaultLocation String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ReportConfig {
  id                    Int      @id @default(autoincrement())
  key                   String   @unique
  isEnabled             Boolean?
  subjectPrefix         String?
  heading               String?
  introText             String?
  footerText            String?
  contentOptions        Json?
  scheduleFrequency     String?
  scheduleWeekdayUtc    Int?
  scheduleMonthDayUtc   Int?
  scheduleHourUtc       Int?
  scheduleMinuteUtc     Int?
  scheduleDaysBeforeDue Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AlertPreference {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  emailEnabled    Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  notifyOffline   Boolean  @default(true)
  notifyDegraded  Boolean  @default(true)
  emailRecipients String?
  smsRecipients   String?
  fromEmail       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CalendarIntegration {
  id                Int              @id @default(autoincrement())
  organizationId    Int
  organization      Organization     @relation(fields: [organizationId], references: [id])
  provider          CalendarProvider
  accessToken       String
  refreshToken      String?
  tokenExpiry       DateTime?
  scope             String?
  email             String?
  calendarId        String?
  lastSyncedAt      DateTime?
  channelId         String?
  channelToken      String?
  channelResourceId String?
  channelExpiration DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, provider])
}

model AccountingEntry {
  id                Int                 @id @default(autoincrement())
  organizationId    Int
  organization      Organization        @relation(fields: [organizationId], references: [id])
  type              AccountingType
  status            AccountingStatus
  source            AccountingSource    @default(MANUAL)
  sourceRef         String?
  recurringInterval AccountingInterval?
  invoiceNumber     String?
  archivedAt        DateTime?
  currency          CurrencyCode
  amount            Decimal             @db.Decimal(14, 2)
  serviceName       String
  detail            String?
  paidAt            DateTime?
  dueAt             DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, currency])
  @@index([organizationId, paidAt])
  @@index([organizationId, dueAt])
}

model ProductivityEntry {
  id              Int          @id @default(autoincrement())
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          Int
  user            User         @relation(fields: [userId], references: [id])
  entryDate       DateTime     @db.Date
  plannedTasks    Int          @default(0)
  completedTasks  Int          @default(0)
  deepWorkMinutes Int          @default(0)
  focusBlocks     Int          @default(0)
  blockers        String?
  energyLevel     Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, entryDate])
  @@index([organizationId, entryDate])
  @@index([userId, entryDate])
}

model ProductivityTodo {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  title          String
  notes          String?
  isDone         Boolean      @default(false)
  priority       String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, isDone])
  @@index([userId, dueAt])
}

model Invoice {
  id                       Int                          @id @default(autoincrement())
  organizationId           Int
  organization             Organization                 @relation(fields: [organizationId], references: [id])
  invoiceNumber            String
  status                   InvoiceStatus                @default(DRAFT)
  currency                 CurrencyCode
  issueDate                DateTime                     @db.Date
  dueDate                  DateTime?                    @db.Date
  paidAt                   DateTime?
  clientName               String
  clientEmail              String?
  clientAddress            String?
  notes                    String?
  subtotal                 Decimal                      @db.Decimal(14, 2)
  taxRate                  Decimal                      @default(0) @db.Decimal(5, 2)
  taxAmount                Decimal                      @default(0) @db.Decimal(14, 2)
  discount                 Decimal                      @default(0) @db.Decimal(14, 2)
  total                    Decimal                      @db.Decimal(14, 2)
  paidAmount               Decimal                      @default(0) @db.Decimal(14, 2)
  legacyPaidAmount         Decimal?                     @db.Decimal(14, 2)
  paymentLedgerActivatedAt DateTime?
  proposalVersionId        Int?
  proposalVersion          ProposalVersion?             @relation(fields: [proposalVersionId], references: [id], onDelete: SetNull)
  billingScheduleItemId    Int?
  billingScheduleItem      ProposalBillingScheduleItem? @relation(fields: [billingScheduleItemId], references: [id], onDelete: SetNull)
  generationKey            String?                      @unique
  viewToken                String?                      @unique
  viewTokenExpiresAt       DateTime?
  respondedAt              DateTime?
  archivedAt               DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  lineItems                InvoiceLineItem[]
  payments                 InvoicePayment[]
  paymentLedgerEntries     InvoicePaymentLedgerEntry[]
  paymentIdempotencyClaims PaymentIdempotencyClaim[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([proposalVersionId, status])
  @@index([billingScheduleItemId, issueDate])
  @@index([viewToken])
}

model InvoicePayment {
  id                   Int                         @id @default(autoincrement())
  transactionId        String                      @unique @default(uuid())
  organizationId       Int
  organization         Organization                @relation(fields: [organizationId], references: [id])
  invoiceId            Int
  invoice              Invoice                     @relation(fields: [invoiceId], references: [id])
  customerName         String
  amount               Decimal                     @db.Decimal(14, 2)
  currency             CurrencyCode
  method               InvoicePaymentMethod
  provider             String?
  externalReference    String?
  externalReferenceKey String?
  paymentDate          DateTime                    @db.Date
  verificationStatus   PaymentVerificationStatus   @default(PENDING_VERIFICATION)
  evidenceUrl          String?
  note                 String?
  recordedByUserId     Int
  recordedByUser       User                        @relation("InvoicePaymentRecordedBy", fields: [recordedByUserId], references: [id])
  verifiedByUserId     Int?
  verifiedByUser       User?                       @relation("InvoicePaymentVerifiedBy", fields: [verifiedByUserId], references: [id])
  verifiedAt           DateTime?
  rejectedByUserId     Int?
  rejectedByUser       User?                       @relation("InvoicePaymentRejectedBy", fields: [rejectedByUserId], references: [id])
  rejectedAt           DateTime?
  rejectionReason      String?
  reversedAt           DateTime?
  correctsPaymentId    Int?
  correctsPayment      InvoicePayment?             @relation("InvoicePaymentCorrection", fields: [correctsPaymentId], references: [id])
  corrections          InvoicePayment[]            @relation("InvoicePaymentCorrection")
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  ledgerEntries        InvoicePaymentLedgerEntry[]
  idempotencyClaims    PaymentIdempotencyClaim[]

  @@unique([organizationId, externalReferenceKey])
  @@index([organizationId, invoiceId, createdAt])
  @@index([organizationId, verificationStatus, createdAt])
  @@index([invoiceId, paymentDate])
  @@index([correctsPaymentId])
}

model InvoicePaymentLedgerEntry {
  id                Int                        @id @default(autoincrement())
  transactionId     String                     @unique @default(uuid())
  organizationId    Int
  organization      Organization               @relation(fields: [organizationId], references: [id])
  invoiceId         Int
  invoice           Invoice                    @relation(fields: [invoiceId], references: [id])
  paymentId         Int?
  payment           InvoicePayment?            @relation(fields: [paymentId], references: [id])
  entryType         PaymentLedgerEntryType
  status            PaymentLedgerEntryStatus   @default(POSTED)
  signedAmount      Decimal                    @db.Decimal(14, 2)
  currency          CurrencyCode
  method            InvoicePaymentMethod?
  externalReference String?
  effectiveAt       DateTime                   @db.Date
  postedAt          DateTime                   @default(now())
  actorUserId       Int
  actorUser         User                       @relation("PaymentLedgerActor", fields: [actorUserId], references: [id])
  reversesEntryId   Int?                       @unique
  reversesEntry     InvoicePaymentLedgerEntry? @relation("PaymentLedgerReversal", fields: [reversesEntryId], references: [id])
  reversalEntry     InvoicePaymentLedgerEntry? @relation("PaymentLedgerReversal")
  reason            String?
  metadata          Json?
  idempotencyClaims PaymentIdempotencyClaim[]

  @@unique([paymentId, entryType])
  @@index([organizationId, invoiceId, postedAt])
  @@index([invoiceId, effectiveAt])
  @@index([paymentId])
}

model PaymentIdempotencyClaim {
  id                 Int                        @id @default(autoincrement())
  organizationId     Int
  organization       Organization               @relation(fields: [organizationId], references: [id])
  invoiceId          Int
  invoice            Invoice                    @relation(fields: [invoiceId], references: [id])
  operation          PaymentOperationType
  idempotencyKey     String
  requestFingerprint String
  paymentId          Int?
  payment            InvoicePayment?            @relation(fields: [paymentId], references: [id])
  ledgerEntryId      Int?
  ledgerEntry        InvoicePaymentLedgerEntry? @relation(fields: [ledgerEntryId], references: [id])
  responseSnapshot   Json?
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())

  @@unique([organizationId, operation, idempotencyKey])
  @@index([invoiceId, createdAt])
  @@index([paymentId])
}

model InvoiceLineItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId, sortOrder])
}

model Project {
  id                        Int              @id @default(autoincrement())
  organizationId            Int
  organization              Organization     @relation(fields: [organizationId], references: [id])
  ownerUserId               Int?
  ownerUser                 User?            @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  title                     String
  clientName                String?
  projectType               ProjectType      @default(PERSONAL)
  stage                     ProjectStage     @default(BACKLOG)
  priority                  ProjectPriority  @default(MEDIUM)
  currency                  CurrencyCode?
  budgetAmount              Decimal?         @db.Decimal(14, 2)
  startDate                 DateTime?        @db.Date
  dueDate                   DateTime?        @db.Date
  progressPercent           Int              @default(0)
  health                    ProjectHealth    @default(ON_TRACK)
  description               String?
  externalRef               String?
  acceptedProposalVersionId Int?             @unique
  acceptedProposalVersion   ProposalVersion? @relation("AcceptedProposalProject", fields: [acceptedProposalVersionId], references: [id], onDelete: SetNull)
  archivedAt                DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  tasks                     ProjectTask[]
  proposals                 Proposal[]

  @@index([organizationId, stage])
  @@index([organizationId, projectType])
  @@index([organizationId, dueDate])
  @@index([ownerUserId])
}

model ProjectTask {
  id                   Int                  @id @default(autoincrement())
  organizationId       Int
  organization         Organization         @relation(fields: [organizationId], references: [id])
  projectId            Int
  project              Project              @relation(fields: [projectId], references: [id])
  title                String
  description          String?
  status               ProjectTaskStatus    @default(BACKLOG)
  priority             ProjectTaskPriority  @default(MEDIUM)
  assigneeUserId       Int?
  assigneeUser         User?                @relation("ProjectTaskAssignee", fields: [assigneeUserId], references: [id])
  startDate            DateTime?            @db.Date
  dueDate              DateTime?            @db.Date
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  trelloCardId         String?              @unique
  trelloCardUrl        String?
  trelloSyncStatus     TrelloSyncStatus     @default(NOT_LINKED)
  trelloLastSyncSource TrelloSyncSource?
  trelloLastSyncedAt   DateTime?
  trelloLastError      String?
  trelloWebhookEvents  TrelloWebhookEvent[]

  @@index([organizationId, projectId, archivedAt])
  @@index([projectId, status, archivedAt])
  @@index([organizationId, assigneeUserId, archivedAt])
  @@index([projectId, dueDate])
}

model TrelloConnection {
  id                 Int                    @id @default(autoincrement())
  organizationId     Int                    @unique
  organization       Organization           @relation(fields: [organizationId], references: [id])
  apiKeyEncrypted    String
  apiTokenEncrypted  String
  appSecretEncrypted String
  boardId            String
  boardName          String?
  boardUrl           String?
  statusMappings     Json
  status             TrelloConnectionStatus @default(ACTIVE)
  webhookId          String?                @unique
  webhookCallbackUrl String?
  lastSyncAt         DateTime?
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  webhookEvents      TrelloWebhookEvent[]

  @@index([status])
}

model TrelloWebhookEvent {
  id               Int                      @id @default(autoincrement())
  organizationId   Int
  organization     Organization             @relation(fields: [organizationId], references: [id])
  connectionId     Int
  connection       TrelloConnection         @relation(fields: [connectionId], references: [id])
  taskId           Int?
  task             ProjectTask?             @relation(fields: [taskId], references: [id])
  actionId         String                   @unique
  actionType       String
  cardId           String?
  clientIdentifier String?
  status           TrelloWebhookEventStatus
  error            String?
  processedAt      DateTime?
  createdAt        DateTime                 @default(now())

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
  @@index([taskId, createdAt])
}

model Proposal {
  id                  Int                       @id @default(autoincrement())
  organizationId      Int
  organization        Organization              @relation(fields: [organizationId], references: [id])
  createdByUserId     Int?
  createdByUser       User?                     @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id])
  lastEditedByUserId  Int?
  lastEditedByUser    User?                     @relation("ProposalLastEditedBy", fields: [lastEditedByUserId], references: [id])
  projectId           Int?
  project             Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title               String
  clientName          String?
  proposalType        String                    @default("website")
  status              String                    @default("draft")
  version             Int                       @default(1)
  metadata            Json?
  content             Json
  shareToken          String?                   @unique
  shareTokenCreatedAt DateTime?
  shareTokenExpiresAt DateTime?
  sharedAt            DateTime?
  archivedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  versions            ProposalVersion[]
  revisionRequests    ProposalRevisionRequest[]

  @@index([organizationId, status])
  @@index([organizationId, proposalType])
  @@index([organizationId, updatedAt])
  @@index([organizationId, projectId])
  @@index([shareToken])
}

model CommercialCatalogueItem {
  id                      Int                             @id @default(autoincrement())
  organizationId          Int
  organization            Organization                    @relation(fields: [organizationId], references: [id])
  kind                    CommercialItemKind
  name                    String
  normalizedName          String
  systemKey               String?
  category                String?
  description             String?
  deliverables            Json?
  defaultUnitPrice        Decimal?                        @db.Decimal(14, 2)
  defaultBillingType      CommercialBillingType           @default(ONE_TIME)
  defaultBillingFrequency CommercialBillingFrequency      @default(NONE)
  defaultCostOwnership    CommercialCostOwnership         @default(FAAKO_BILLED)
  sourceUrl               String?
  active                  Boolean                         @default(true)
  archivedAt              DateTime?
  createdByUserId         Int?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  packageItems            CommercialPackageItem[]
  proposalItems           ProposalVersionItem[]
  dependencies            CommercialCatalogueDependency[] @relation("CatalogueItemDependencies")
  dependents              CommercialCatalogueDependency[] @relation("CatalogueItemDependents")
  tiers                   CommercialCatalogueTier[]

  @@unique([organizationId, kind, normalizedName])
  @@unique([organizationId, systemKey])
  @@index([organizationId, kind, active])
  @@index([organizationId, category])
}

model CommercialCatalogueTier {
  id               Int                        @id @default(autoincrement())
  catalogueItemId  Int
  catalogueItem    CommercialCatalogueItem    @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  name             String
  normalizedName   String
  priceModel       CommercialTierPriceModel   @default(FIXED)
  providerAmount   Decimal?                   @db.Decimal(14, 2)
  providerCurrency String?
  displayPrice     String?
  faakoSetupFee    Decimal                    @default(0) @db.Decimal(14, 2)
  billingFrequency CommercialBillingFrequency @default(NONE)
  sourceUrl        String?
  lastVerifiedAt   DateTime?                  @db.Date
  includedFeatures Json?
  isDefault        Boolean                    @default(false)
  active           Boolean                    @default(true)
  sortOrder        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([catalogueItemId, normalizedName])
  @@index([catalogueItemId, active, sortOrder])
}

model CommercialCatalogueDependency {
  id              Int                     @id @default(autoincrement())
  itemId          Int
  item            CommercialCatalogueItem @relation("CatalogueItemDependencies", fields: [itemId], references: [id], onDelete: Cascade)
  dependsOnItemId Int
  dependsOnItem   CommercialCatalogueItem @relation("CatalogueItemDependents", fields: [dependsOnItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())

  @@unique([itemId, dependsOnItemId])
  @@index([dependsOnItemId])
}

model CommercialPackage {
  id              Int                     @id @default(autoincrement())
  organizationId  Int
  organization    Organization            @relation(fields: [organizationId], references: [id])
  name            String
  normalizedName  String
  description     String?
  active          Boolean                 @default(true)
  archivedAt      DateTime?
  createdByUserId Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  items           CommercialPackageItem[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, active])
}

model CommercialPackageItem {
  id              Int                      @id @default(autoincrement())
  packageId       Int
  package         CommercialPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  catalogueItemId Int?
  catalogueItem   CommercialCatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  configuration   Json
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([packageId, sortOrder])
  @@index([catalogueItemId])
}

model ProposalVersion {
  id                    Int                           @id @default(autoincrement())
  proposalId            Int
  proposal              Proposal                      @relation(fields: [proposalId], references: [id])
  versionNumber         Int
  status                ProposalVersionStatus         @default(DRAFT)
  schemaVersion         Int                           @default(2)
  customerReference     String?
  customerName          String?
  customerEmail         String?
  customerAddress       String?
  projectReference      String?
  projectTitle          String?
  title                 String
  summary               String?
  currency              CurrencyCode
  validUntil            DateTime?                     @db.Date
  scope                 String?
  exclusions            Json?
  terms                 Json?
  taxRate               Decimal                       @default(0) @db.Decimal(5, 2)
  discount              Decimal                       @default(0) @db.Decimal(14, 2)
  depositPercent        Decimal                       @default(0) @db.Decimal(5, 2)
  subtotal              Decimal                       @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal                       @default(0) @db.Decimal(14, 2)
  total                 Decimal                       @default(0) @db.Decimal(14, 2)
  oneTimeTotal          Decimal                       @default(0) @db.Decimal(14, 2)
  recurringMonthlyTotal Decimal                       @default(0) @db.Decimal(14, 2)
  recurringAnnualTotal  Decimal                       @default(0) @db.Decimal(14, 2)
  depositAmount         Decimal                       @default(0) @db.Decimal(14, 2)
  sourceSnapshot        Json
  publishedAt           DateTime?
  createdByUserId       Int?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  items                 ProposalVersionItem[]
  selections            ProposalClientSelection[]
  revisionRequests      ProposalRevisionRequest[]
  approvalSnapshot      ProposalApprovalSnapshot?
  billingSchedule       ProposalBillingScheduleItem[]
  accessLinks           ProposalAccessLink[]
  invoices              Invoice[]
  deliveryProject       Project?                      @relation("AcceptedProposalProject")

  @@unique([proposalId, versionNumber])
  @@index([proposalId, status])
}

model ProposalVersionItem {
  id                Int                        @id @default(autoincrement())
  proposalVersionId Int
  proposalVersion   ProposalVersion            @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  catalogueItemId   Int?
  catalogueItem     CommercialCatalogueItem?   @relation(fields: [catalogueItemId], references: [id], onDelete: SetNull)
  kind              CommercialItemKind
  name              String
  description       String?
  deliverables      Json?
  quantity          Decimal                    @db.Decimal(10, 2)
  unitPrice         Decimal                    @db.Decimal(14, 2)
  discount          Decimal                    @default(0) @db.Decimal(14, 2)
  amount            Decimal                    @db.Decimal(14, 2)
  billingType       CommercialBillingType
  billingFrequency  CommercialBillingFrequency @default(NONE)
  required          Boolean                    @default(true)
  clientSelectable  Boolean                    @default(false)
  selectedByDefault Boolean                    @default(true)
  custom            Boolean                    @default(false)
  costOwnership     CommercialCostOwnership    @default(FAAKO_BILLED)
  estimatedDelivery String?
  internalNotes     String?
  clientNotes       String?
  dependencies      Json?
  configuration     Json?
  selectedTierName  String?
  pricingSourceUrl  String?
  pricingVerifiedAt DateTime?                  @db.Date
  providerCharge    Json?
  sortOrder         Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  selections        ProposalClientSelection[]

  @@index([proposalVersionId, sortOrder])
  @@index([catalogueItemId])
}

model ProposalClientSelection {
  id                    Int                 @id @default(autoincrement())
  proposalVersionId     Int
  proposalVersion       ProposalVersion     @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  proposalVersionItemId Int
  proposalVersionItem   ProposalVersionItem @relation(fields: [proposalVersionItemId], references: [id], onDelete: Cascade)
  clientKey             String              @default("default")
  selected              Boolean
  quantity              Decimal?            @db.Decimal(10, 2)
  configuration         Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([proposalVersionItemId, clientKey])
  @@index([proposalVersionId, clientKey])
}

model ProposalRevisionRequest {
  id                Int                       @id @default(autoincrement())
  proposalId        Int
  proposal          Proposal                  @relation(fields: [proposalId], references: [id])
  proposalVersionId Int
  proposalVersion   ProposalVersion           @relation(fields: [proposalVersionId], references: [id])
  status            ProposalRevisionStatus    @default(OPEN)
  kind              ProposalClientMessageKind @default(REVISION)
  message           String
  requesterName     String?
  requesterContact  String?
  requestKey        String?                   @unique
  resolvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([proposalId, status])
  @@index([proposalVersionId, createdAt])
  @@index([proposalVersionId, kind, createdAt])
}

model ProposalApprovalSnapshot {
  id                Int                    @id @default(autoincrement())
  proposalVersionId Int                    @unique
  proposalVersion   ProposalVersion        @relation(fields: [proposalVersionId], references: [id])
  status            ProposalApprovalStatus @default(PREPARED)
  accessLinkId      Int?
  accessLink        ProposalAccessLink?    @relation(fields: [accessLinkId], references: [id], onDelete: SetNull)
  acceptanceKey     String?                @unique
  selectionSnapshot Json
  pricingSnapshot   Json
  termsSnapshot     Json?
  scopeSnapshot     Json?
  termsVersion      String?
  consentConfirmed  Boolean                @default(false)
  approverName      String?
  approverContact   String?
  acceptedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([accessLinkId, status])
}

model ProposalBillingScheduleItem {
  id                Int                           @id @default(autoincrement())
  proposalVersionId Int
  proposalVersion   ProposalVersion               @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  type              ProposalBillingScheduleType
  label             String
  percentage        Decimal?                      @db.Decimal(5, 2)
  amount            Decimal                       @db.Decimal(14, 2)
  dueRule           String?
  billingFrequency  CommercialBillingFrequency    @default(NONE)
  status            ProposalBillingScheduleStatus @default(PENDING)
  generationRule    ProposalBillingGenerationRule @default(MANUAL)
  startDate         DateTime?                     @db.Date
  nextBillingDate   DateTime?                     @db.Date
  lastBillingDate   DateTime?                     @db.Date
  generatedCount    Int                           @default(0)
  maxOccurrences    Int?
  sortOrder         Int                           @default(0)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  invoices          Invoice[]

  @@index([proposalVersionId, sortOrder])
  @@index([status, nextBillingDate])
}

model ProposalAccessLink {
  id                     Int                          @id @default(autoincrement())
  proposalVersionId      Int
  proposalVersion        ProposalVersion              @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  tokenHash              String                       @unique
  expiresAt              DateTime
  revokedAt              DateTime?
  lastAccessedAt         DateTime?
  createdByUserId        Int?
  sentTo                 String?
  deliveryStatus         ProposalEmailDeliveryStatus?
  sentAt                 DateTime?
  failedAt               DateTime?
  providerMessageId      String?
  sendIdempotencyKey     String?
  sendRequestFingerprint String?
  failureCategory        String?
  createdAt              DateTime                     @default(now())
  approvalSnapshots      ProposalApprovalSnapshot[]

  @@unique([proposalVersionId, sendIdempotencyKey])
  @@index([proposalVersionId, revokedAt])
  @@index([proposalVersionId, sentAt])
  @@index([expiresAt])
}

model RentTenant {
  id                     Int              @id @default(autoincrement())
  organizationId         Int
  organization           Organization     @relation(fields: [organizationId], references: [id])
  status                 RentTenantStatus @default(ACTIVE)
  tenantName             String
  tenantEmail            String
  landlordName           String?
  landlordEmail          String?
  currency               CurrencyCode
  monthlyRent            Decimal          @db.Decimal(14, 2)
  leaseStartDate         DateTime         @db.Date
  leaseEndDate           DateTime?        @db.Date
  openingBalance         Decimal          @default(0) @db.Decimal(14, 2)
  notes                  String?
  lastQuarterlySummaryAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  payments RentPayment[]

  @@index([organizationId, status])
  @@index([organizationId, tenantEmail])
}

model RentPayment {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  tenantId       Int
  tenant         RentTenant   @relation(fields: [tenantId], references: [id])
  currency       CurrencyCode
  amount         Decimal      @db.Decimal(14, 2)
  paidAt         DateTime     @db.Date
  method         String?
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, tenantId, paidAt])
  @@index([tenantId, paidAt])
}

model MonitoredService {
  id                 Int                  @id @default(autoincrement())
  key                String               @unique
  name               String
  category           MonitoringCategory
  environment        String
  provider           String?
  checkType          MonitoringCheckType
  enabled            Boolean              @default(true)
  intervalSeconds    Int
  timeoutMs          Int                  @default(10000)
  retryCount         Int                  @default(0)
  critical           Boolean              @default(false)
  safeTargetLabel    String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  checks             HealthCheck[]
  incidents          MonitoringIncident[]
  dependencies       ServiceDependency[]  @relation("ServiceDependencies")
  dependents         ServiceDependency[]  @relation("DependencyDependents")
  alertRules         AlertRule[]
  alertEvents        AlertEvent[]
  maintenanceWindows MaintenanceWindow[]

  @@index([category, enabled])
  @@index([environment, enabled])
}

model HealthCheck {
  id           Int              @id @default(autoincrement())
  serviceId    Int
  service      MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status       MonitoringStatus
  latencyMs    Int?
  httpStatus   Int?
  startedAt    DateTime
  completedAt  DateTime
  errorCode    String?
  errorSummary String?
  details      Json?
  createdAt    DateTime         @default(now())

  @@index([serviceId, startedAt])
  @@index([status, startedAt])
}

model MonitoringIncident {
  id                   Int                      @id @default(autoincrement())
  serviceId            Int
  service              MonitoredService         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  organizationId       Int?
  organization         Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status               IncidentStatus
  severity             IncidentSeverity
  title                String?
  startedAt            DateTime
  acknowledgedAt       DateTime?
  acknowledgedByUserId Int?
  resolvedAt           DateTime?
  recoveredAt          DateTime?
  closedAt             DateTime?
  assignedUserId       Int?
  assignedRoleId       Int?
  responseDueAt        DateTime?
  resolutionDueAt      DateTime?
  responseBreachedAt   DateTime?
  resolutionBreachedAt DateTime?
  failureCount         Int                      @default(0)
  recoveryCount        Int                      @default(0)
  autoResolve          Boolean                  @default(true)
  rootCause            String?
  impactSummary        String?
  resolutionSummary    String?
  summary              String?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  alertEvents          AlertEvent[]
  timeline             IncidentTimelineEntry[]
  notifications        MonitoringNotification[]

  @@index([serviceId, startedAt])
  @@index([status, startedAt])
  @@index([organizationId, status, startedAt])
  @@index([assignedUserId, status])
  @@index([responseDueAt, status])
  @@index([resolutionDueAt, status])
}

model ServiceDependency {
  id                 Int              @id @default(autoincrement())
  serviceId          Int
  service            MonitoredService @relation("ServiceDependencies", fields: [serviceId], references: [id], onDelete: Cascade)
  dependsOnServiceId Int
  dependsOnService   MonitoredService @relation("DependencyDependents", fields: [dependsOnServiceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dependsOnServiceId])
  @@index([serviceId])
  @@index([dependsOnServiceId])
}

model AlertRule {
  id                    Int                 @id @default(autoincrement())
  organizationId        Int?
  organization          Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId             Int?
  service               MonitoredService?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  escalationPolicyId    Int?
  escalationPolicy      EscalationPolicy?   @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  name                  String
  triggerType           AlertTriggerType
  category              MonitoringCategory?
  environment           String?
  severity              IncidentSeverity    @default(WARNING)
  thresholdValue        Float?
  consecutiveFailures   Int?
  cooldownMinutes       Int                 @default(15)
  recoveryNotifications Boolean             @default(true)
  enabled               Boolean             @default(true)
  createdByUserId       Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  events                AlertEvent[]
  channels              AlertRuleChannel[]

  @@index([organizationId, enabled, triggerType])
  @@index([serviceId, enabled])
  @@index([category, environment, enabled])
}

model AlertEvent {
  id               Int                            @id @default(autoincrement())
  ruleId           Int
  rule             AlertRule                      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  serviceId        Int
  service          MonitoredService               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incidentId       Int?
  incident         MonitoringIncident?            @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  channelId        Int?
  channel          MonitoringNotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  eventType        AlertEventType
  deliveryStatus   AlertDeliveryStatus            @default(PENDING)
  deduplicationKey String                         @unique
  occurrenceCount  Int                            @default(1)
  attemptCount     Int                            @default(0)
  nextAttemptAt    DateTime?
  deliveredAt      DateTime?
  errorSummary     String?
  safeSummary      String?
  metadata         Json?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@index([incidentId, createdAt])
  @@index([ruleId, serviceId, eventType, createdAt])
  @@index([deliveryStatus, nextAttemptAt])
}

model IncidentTimelineEntry {
  id          Int                  @id @default(autoincrement())
  incidentId  Int
  incident    MonitoringIncident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        IncidentTimelineType
  actorUserId Int?
  actorLabel  String?
  summary     String
  details     Json?
  createdAt   DateTime             @default(now())

  @@index([incidentId, createdAt])
  @@index([type, createdAt])
}

model MonitoringNotificationChannel {
  id              Int                     @id @default(autoincrement())
  organizationId  Int?
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  type            NotificationChannelType
  enabled         Boolean                 @default(true)
  safeDisplay     String?
  encryptedConfig String?
  createdByUserId Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  rules           AlertRuleChannel[]
  events          AlertEvent[]

  @@index([organizationId, type, enabled])
}

model AlertRuleChannel {
  ruleId    Int
  rule      AlertRule                     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channelId Int
  channel   MonitoringNotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@index([channelId])
}

model EscalationPolicy {
  id                Int              @id @default(autoincrement())
  organizationId    Int?
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  enabled           Boolean          @default(true)
  stopOnAcknowledge Boolean          @default(false)
  createdByUserId   Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rules             AlertRule[]
  steps             EscalationStep[]

  @@index([organizationId, enabled])
}

model EscalationStep {
  id                Int                  @id @default(autoincrement())
  policyId          Int
  policy            EscalationPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  position          Int
  delayMinutes      Int
  targetType        EscalationTargetType
  targetUserId      Int?
  targetRoleId      Int?
  targetChannelId   Int?
  stopOnAcknowledge Boolean              @default(false)
  createdAt         DateTime             @default(now())

  @@unique([policyId, position])
  @@index([policyId, delayMinutes])
}

model MaintenanceWindow {
  id                Int                 @id @default(autoincrement())
  organizationId    Int?
  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId         Int?
  service           MonitoredService?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category          MonitoringCategory?
  environment       String?
  name              String
  reason            String?
  status            MaintenanceStatus   @default(SCHEDULED)
  suppressAlerts    Boolean             @default(true)
  startsAt          DateTime
  endsAt            DateTime
  createdByUserId   Int?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId, status, startsAt, endsAt])
  @@index([serviceId, status, startsAt, endsAt])
  @@index([category, environment, status])
}

model MonitoringNotification {
  id             Int                @id @default(autoincrement())
  organizationId Int?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int?
  incidentId     Int
  incident       MonitoringIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type           AlertEventType
  title          String
  message        String
  link           String
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, readAt, createdAt])
  @@index([incidentId, createdAt])
}

