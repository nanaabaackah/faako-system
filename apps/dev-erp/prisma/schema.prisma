generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   Int            @id @default(autoincrement())
  name                 String
  slug                 String         @unique
  status               OrgStatus      @default(ACTIVE)
  parentOrganizationId Int?
  parentOrganization   Organization?  @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[] @relation("OrganizationHierarchy")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  roles                   Role[]
  users                   User[]
  bookings                Booking[]
  bookingSettings         BookingSettings?
  calendarIntegrations    CalendarIntegration[]
  accountingEntries       AccountingEntry[]
  invoices                Invoice[]
  proposals               Proposal[]
  productivityEntries     ProductivityEntry[]
  productivityTodos       ProductivityTodo[]
  rentTenants             RentTenant[]
  rentPayments            RentPayment[]
  projects                Project[]
  projectTasks            ProjectTask[]
  trelloConnection        TrelloConnection?
  trelloWebhookEvents     TrelloWebhookEvent[]
  monitoringIncidents     MonitoringIncident[]
  alertRules              AlertRule[]
  notificationChannels    MonitoringNotificationChannel[]
  escalationPolicies      EscalationPolicy[]
  maintenanceWindows      MaintenanceWindow[]
  monitoringNotifications MonitoringNotification[]

  @@index([parentOrganizationId])
}

model Role {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  permissions    Json?

  users User[]

  @@unique([organizationId, name])
}

model User {
  id                   Int                 @id @default(autoincrement())
  organizationId       Int
  organization         Organization        @relation(fields: [organizationId], references: [id])
  roleId               Int
  role                 Role                @relation(fields: [roleId], references: [id])
  firstName            String
  lastName             String
  fullName             String
  email                String              @unique
  password             String
  status               UserStatus          @default(ACTIVE)
  tokenVersion         Int                 @default(0)
  loginAttempts        Int                 @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdProposals     Proposal[]          @relation("ProposalCreatedBy")
  editedProposals      Proposal[]          @relation("ProposalLastEditedBy")
  ownedProjects        Project[]           @relation("ProjectOwner")
  assignedProjectTasks ProjectTask[]       @relation("ProjectTaskAssignee")
  productivityEntries  ProductivityEntry[]
  productivityTodos    ProductivityTodo[]
  refreshTokens        RefreshToken[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  action         String
  targetType     String?
  targetId       String?
  appKey         String?
  environment    String?
  source         String?
  category       String?
  severity       String?
  status         String?
  summary        String?
  actorType      String?
  actorLabel     String?
  requestId      String?
  externalRef    String?  @unique
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, action, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([source, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
}

model Booking {
  id               Int               @id @default(autoincrement())
  organizationId   Int
  organization     Organization      @relation(fields: [organizationId], references: [id])
  externalId       String?
  source           BookingSource     @default(MANUAL)
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  location         String?
  meetingLink      String?
  calendarEventId  String?
  calendarProvider CalendarProvider?
  status           BookingStatus     @default(CONFIRMED)
  attendeeEmail    String?
  attendeeName     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, externalId, source])
  @@index([organizationId, calendarProvider, calendarEventId])
  @@index([organizationId, startAt])
}

model BookingSettings {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  bookingLink     String?
  calendarEmail   String?
  defaultLocation String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ReportConfig {
  id                    Int      @id @default(autoincrement())
  key                   String   @unique
  isEnabled             Boolean?
  subjectPrefix         String?
  heading               String?
  introText             String?
  footerText            String?
  contentOptions        Json?
  scheduleFrequency     String?
  scheduleWeekdayUtc    Int?
  scheduleMonthDayUtc   Int?
  scheduleHourUtc       Int?
  scheduleMinuteUtc     Int?
  scheduleDaysBeforeDue Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AlertPreference {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  emailEnabled    Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  notifyOffline   Boolean  @default(true)
  notifyDegraded  Boolean  @default(true)
  emailRecipients String?
  smsRecipients   String?
  fromEmail       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CalendarIntegration {
  id                Int              @id @default(autoincrement())
  organizationId    Int
  organization      Organization     @relation(fields: [organizationId], references: [id])
  provider          CalendarProvider
  accessToken       String
  refreshToken      String?
  tokenExpiry       DateTime?
  scope             String?
  email             String?
  calendarId        String?
  lastSyncedAt      DateTime?
  channelId         String?
  channelToken      String?
  channelResourceId String?
  channelExpiration DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, provider])
}

model AccountingEntry {
  id                Int                 @id @default(autoincrement())
  organizationId    Int
  organization      Organization        @relation(fields: [organizationId], references: [id])
  type              AccountingType
  status            AccountingStatus
  source            AccountingSource    @default(MANUAL)
  sourceRef         String?
  recurringInterval AccountingInterval?
  invoiceNumber     String?
  archivedAt        DateTime?
  currency          CurrencyCode
  amount            Decimal             @db.Decimal(14, 2)
  serviceName       String
  detail            String?
  paidAt            DateTime?
  dueAt             DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, currency])
  @@index([organizationId, paidAt])
  @@index([organizationId, dueAt])
}

model ProductivityEntry {
  id              Int          @id @default(autoincrement())
  organizationId  Int
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          Int
  user            User         @relation(fields: [userId], references: [id])
  entryDate       DateTime     @db.Date
  plannedTasks    Int          @default(0)
  completedTasks  Int          @default(0)
  deepWorkMinutes Int          @default(0)
  focusBlocks     Int          @default(0)
  blockers        String?
  energyLevel     Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, entryDate])
  @@index([organizationId, entryDate])
  @@index([userId, entryDate])
}

model ProductivityTodo {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  title          String
  notes          String?
  isDone         Boolean      @default(false)
  priority       String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, isDone])
  @@index([userId, dueAt])
}

model Invoice {
  id                 Int           @id @default(autoincrement())
  organizationId     Int
  organization       Organization  @relation(fields: [organizationId], references: [id])
  invoiceNumber      String
  status             InvoiceStatus @default(DRAFT)
  currency           CurrencyCode
  issueDate          DateTime      @db.Date
  dueDate            DateTime?     @db.Date
  paidAt             DateTime?
  clientName         String
  clientEmail        String?
  clientAddress      String?
  notes              String?
  subtotal           Decimal       @db.Decimal(14, 2)
  taxRate            Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(14, 2)
  discount           Decimal       @default(0) @db.Decimal(14, 2)
  total              Decimal       @db.Decimal(14, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(14, 2)
  viewToken          String?       @unique
  viewTokenExpiresAt DateTime?
  respondedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lineItems InvoiceLineItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([viewToken])
}

model InvoiceLineItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  amount      Decimal  @db.Decimal(14, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId, sortOrder])
}

model Project {
  id              Int             @id @default(autoincrement())
  organizationId  Int
  organization    Organization    @relation(fields: [organizationId], references: [id])
  ownerUserId     Int?
  ownerUser       User?           @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  title           String
  clientName      String?
  projectType     ProjectType     @default(PERSONAL)
  stage           ProjectStage    @default(BACKLOG)
  priority        ProjectPriority @default(MEDIUM)
  currency        CurrencyCode?
  budgetAmount    Decimal?        @db.Decimal(14, 2)
  startDate       DateTime?       @db.Date
  dueDate         DateTime?       @db.Date
  progressPercent Int             @default(0)
  health          ProjectHealth   @default(ON_TRACK)
  description     String?
  externalRef     String?
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tasks           ProjectTask[]

  @@index([organizationId, stage])
  @@index([organizationId, projectType])
  @@index([organizationId, dueDate])
  @@index([ownerUserId])
}

model ProjectTask {
  id                   Int                  @id @default(autoincrement())
  organizationId       Int
  organization         Organization         @relation(fields: [organizationId], references: [id])
  projectId            Int
  project              Project              @relation(fields: [projectId], references: [id])
  title                String
  description          String?
  status               ProjectTaskStatus    @default(BACKLOG)
  priority             ProjectTaskPriority  @default(MEDIUM)
  assigneeUserId       Int?
  assigneeUser         User?                @relation("ProjectTaskAssignee", fields: [assigneeUserId], references: [id])
  startDate            DateTime?            @db.Date
  dueDate              DateTime?            @db.Date
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  trelloCardId         String?              @unique
  trelloCardUrl        String?
  trelloSyncStatus     TrelloSyncStatus     @default(NOT_LINKED)
  trelloLastSyncSource TrelloSyncSource?
  trelloLastSyncedAt   DateTime?
  trelloLastError      String?
  trelloWebhookEvents  TrelloWebhookEvent[]

  @@index([organizationId, projectId, archivedAt])
  @@index([projectId, status, archivedAt])
  @@index([organizationId, assigneeUserId, archivedAt])
  @@index([projectId, dueDate])
}

model TrelloConnection {
  id                 Int                    @id @default(autoincrement())
  organizationId     Int                    @unique
  organization       Organization           @relation(fields: [organizationId], references: [id])
  apiKeyEncrypted    String
  apiTokenEncrypted  String
  appSecretEncrypted String
  boardId            String
  boardName          String?
  boardUrl           String?
  statusMappings     Json
  status             TrelloConnectionStatus @default(ACTIVE)
  webhookId          String?                @unique
  webhookCallbackUrl String?
  lastSyncAt         DateTime?
  lastError          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  webhookEvents      TrelloWebhookEvent[]

  @@index([status])
}

model TrelloWebhookEvent {
  id               Int                      @id @default(autoincrement())
  organizationId   Int
  organization     Organization             @relation(fields: [organizationId], references: [id])
  connectionId     Int
  connection       TrelloConnection         @relation(fields: [connectionId], references: [id])
  taskId           Int?
  task             ProjectTask?             @relation(fields: [taskId], references: [id])
  actionId         String                   @unique
  actionType       String
  cardId           String?
  clientIdentifier String?
  status           TrelloWebhookEventStatus
  error            String?
  processedAt      DateTime?
  createdAt        DateTime                 @default(now())

  @@index([organizationId, createdAt])
  @@index([connectionId, createdAt])
  @@index([taskId, createdAt])
}

model Proposal {
  id                  Int          @id @default(autoincrement())
  organizationId      Int
  organization        Organization @relation(fields: [organizationId], references: [id])
  createdByUserId     Int?
  createdByUser       User?        @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id])
  lastEditedByUserId  Int?
  lastEditedByUser    User?        @relation("ProposalLastEditedBy", fields: [lastEditedByUserId], references: [id])
  title               String
  clientName          String?
  proposalType        String       @default("website")
  status              String       @default("draft")
  version             Int          @default(1)
  metadata            Json?
  content             Json
  shareToken          String?      @unique
  shareTokenCreatedAt DateTime?
  shareTokenExpiresAt DateTime?
  sharedAt            DateTime?
  archivedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, proposalType])
  @@index([organizationId, updatedAt])
  @@index([shareToken])
}

model RentTenant {
  id                     Int              @id @default(autoincrement())
  organizationId         Int
  organization           Organization     @relation(fields: [organizationId], references: [id])
  status                 RentTenantStatus @default(ACTIVE)
  tenantName             String
  tenantEmail            String
  landlordName           String?
  landlordEmail          String?
  currency               CurrencyCode
  monthlyRent            Decimal          @db.Decimal(14, 2)
  leaseStartDate         DateTime         @db.Date
  leaseEndDate           DateTime?        @db.Date
  openingBalance         Decimal          @default(0) @db.Decimal(14, 2)
  notes                  String?
  lastQuarterlySummaryAt DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  payments RentPayment[]

  @@index([organizationId, status])
  @@index([organizationId, tenantEmail])
}

model RentPayment {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  tenantId       Int
  tenant         RentTenant   @relation(fields: [tenantId], references: [id])
  currency       CurrencyCode
  amount         Decimal      @db.Decimal(14, 2)
  paidAt         DateTime     @db.Date
  method         String?
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, tenantId, paidAt])
  @@index([tenantId, paidAt])
}

model MonitoredService {
  id                 Int                  @id @default(autoincrement())
  key                String               @unique
  name               String
  category           MonitoringCategory
  environment        String
  provider           String?
  checkType          MonitoringCheckType
  enabled            Boolean              @default(true)
  intervalSeconds    Int
  timeoutMs          Int                  @default(10000)
  retryCount         Int                  @default(0)
  critical           Boolean              @default(false)
  safeTargetLabel    String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  checks             HealthCheck[]
  incidents          MonitoringIncident[]
  dependencies       ServiceDependency[]  @relation("ServiceDependencies")
  dependents         ServiceDependency[]  @relation("DependencyDependents")
  alertRules         AlertRule[]
  alertEvents        AlertEvent[]
  maintenanceWindows MaintenanceWindow[]

  @@index([category, enabled])
  @@index([environment, enabled])
}

model HealthCheck {
  id           Int              @id @default(autoincrement())
  serviceId    Int
  service      MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status       MonitoringStatus
  latencyMs    Int?
  httpStatus   Int?
  startedAt    DateTime
  completedAt  DateTime
  errorCode    String?
  errorSummary String?
  details      Json?
  createdAt    DateTime         @default(now())

  @@index([serviceId, startedAt])
  @@index([status, startedAt])
}

model MonitoringIncident {
  id                   Int                      @id @default(autoincrement())
  serviceId            Int
  service              MonitoredService         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  organizationId       Int?
  organization         Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status               IncidentStatus
  severity             IncidentSeverity
  title                String?
  startedAt            DateTime
  acknowledgedAt       DateTime?
  acknowledgedByUserId Int?
  resolvedAt           DateTime?
  recoveredAt          DateTime?
  closedAt             DateTime?
  assignedUserId       Int?
  assignedRoleId       Int?
  responseDueAt        DateTime?
  resolutionDueAt      DateTime?
  responseBreachedAt   DateTime?
  resolutionBreachedAt DateTime?
  failureCount         Int                      @default(0)
  recoveryCount        Int                      @default(0)
  autoResolve          Boolean                  @default(true)
  rootCause            String?
  impactSummary        String?
  resolutionSummary    String?
  summary              String?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  alertEvents          AlertEvent[]
  timeline             IncidentTimelineEntry[]
  notifications        MonitoringNotification[]

  @@index([serviceId, startedAt])
  @@index([status, startedAt])
  @@index([organizationId, status, startedAt])
  @@index([assignedUserId, status])
  @@index([responseDueAt, status])
  @@index([resolutionDueAt, status])
}

model ServiceDependency {
  id                 Int              @id @default(autoincrement())
  serviceId          Int
  service            MonitoredService @relation("ServiceDependencies", fields: [serviceId], references: [id], onDelete: Cascade)
  dependsOnServiceId Int
  dependsOnService   MonitoredService @relation("DependencyDependents", fields: [dependsOnServiceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dependsOnServiceId])
  @@index([serviceId])
  @@index([dependsOnServiceId])
}

model AlertRule {
  id                    Int                 @id @default(autoincrement())
  organizationId        Int?
  organization          Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId             Int?
  service               MonitoredService?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  escalationPolicyId    Int?
  escalationPolicy      EscalationPolicy?   @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  name                  String
  triggerType           AlertTriggerType
  category              MonitoringCategory?
  environment           String?
  severity              IncidentSeverity    @default(WARNING)
  thresholdValue        Float?
  consecutiveFailures   Int?
  cooldownMinutes       Int                 @default(15)
  recoveryNotifications Boolean             @default(true)
  enabled               Boolean             @default(true)
  createdByUserId       Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  events                AlertEvent[]
  channels              AlertRuleChannel[]

  @@index([organizationId, enabled, triggerType])
  @@index([serviceId, enabled])
  @@index([category, environment, enabled])
}

model AlertEvent {
  id               Int                            @id @default(autoincrement())
  ruleId           Int
  rule             AlertRule                      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  serviceId        Int
  service          MonitoredService               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  incidentId       Int?
  incident         MonitoringIncident?            @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  channelId        Int?
  channel          MonitoringNotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  eventType        AlertEventType
  deliveryStatus   AlertDeliveryStatus            @default(PENDING)
  deduplicationKey String                         @unique
  occurrenceCount  Int                            @default(1)
  attemptCount     Int                            @default(0)
  nextAttemptAt    DateTime?
  deliveredAt      DateTime?
  errorSummary     String?
  safeSummary      String?
  metadata         Json?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@index([incidentId, createdAt])
  @@index([ruleId, serviceId, eventType, createdAt])
  @@index([deliveryStatus, nextAttemptAt])
}

model IncidentTimelineEntry {
  id          Int                  @id @default(autoincrement())
  incidentId  Int
  incident    MonitoringIncident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type        IncidentTimelineType
  actorUserId Int?
  actorLabel  String?
  summary     String
  details     Json?
  createdAt   DateTime             @default(now())

  @@index([incidentId, createdAt])
  @@index([type, createdAt])
}

model MonitoringNotificationChannel {
  id              Int                     @id @default(autoincrement())
  organizationId  Int?
  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  type            NotificationChannelType
  enabled         Boolean                 @default(true)
  safeDisplay     String?
  encryptedConfig String?
  createdByUserId Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  rules           AlertRuleChannel[]
  events          AlertEvent[]

  @@index([organizationId, type, enabled])
}

model AlertRuleChannel {
  ruleId    Int
  rule      AlertRule                     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channelId Int
  channel   MonitoringNotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@index([channelId])
}

model EscalationPolicy {
  id                Int              @id @default(autoincrement())
  organizationId    Int?
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  enabled           Boolean          @default(true)
  stopOnAcknowledge Boolean          @default(false)
  createdByUserId   Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rules             AlertRule[]
  steps             EscalationStep[]

  @@index([organizationId, enabled])
}

model EscalationStep {
  id                Int                  @id @default(autoincrement())
  policyId          Int
  policy            EscalationPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  position          Int
  delayMinutes      Int
  targetType        EscalationTargetType
  targetUserId      Int?
  targetRoleId      Int?
  targetChannelId   Int?
  stopOnAcknowledge Boolean              @default(false)
  createdAt         DateTime             @default(now())

  @@unique([policyId, position])
  @@index([policyId, delayMinutes])
}

model MaintenanceWindow {
  id                Int                 @id @default(autoincrement())
  organizationId    Int?
  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId         Int?
  service           MonitoredService?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category          MonitoringCategory?
  environment       String?
  name              String
  reason            String?
  status            MaintenanceStatus   @default(SCHEDULED)
  suppressAlerts    Boolean             @default(true)
  startsAt          DateTime
  endsAt            DateTime
  createdByUserId   Int?
  cancelledByUserId Int?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId, status, startsAt, endsAt])
  @@index([serviceId, status, startsAt, endsAt])
  @@index([category, environment, status])
}

model MonitoringNotification {
  id             Int                @id @default(autoincrement())
  organizationId Int?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int?
  incidentId     Int
  incident       MonitoringIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type           AlertEventType
  title          String
  message        String
  link           String
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, readAt, createdAt])
  @@index([incidentId, createdAt])
}

enum OrgStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

