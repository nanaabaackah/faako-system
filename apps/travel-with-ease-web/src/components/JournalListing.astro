---
import PlacedImage from "./PlacedImage.astro";
import { IconsaxIcon } from "@faako/ui";
import ContentLink from "./ContentLink.astro";
import { publishedPage } from "../lib/published.js";
import { siteCopy } from "../lib/editorial-copy.js";
import CollectionFilters from "./CollectionFilters.jsx";
import type { JournalArticle } from "../lib/collections";
import "../styles/components/collections.css";
import "../styles/components/journal-listing.css";
interface Props {
  items: JournalArticle[];
  prefix?: string;
  headerPlacement?: import("../lib/collections").ImagePlacement;
}
const { items, prefix = "/journal" } = Astro.props;
const orderedItems = [...items].sort((a, b) => b.date.localeCompare(a.date) || a.title.localeCompare(b.title));
const feature = orderedItems.find(item => item.featuredOnJournal) ||
  orderedItems.find(item => item.category === "Trip story") || orderedItems[0];
const quickReads = orderedItems.filter(item => item.slug !== feature?.slug).slice(0, 3);
const categories = [...new Set(orderedItems.map(item => item.category || "Travel stories"))];
const seriesOptions = [...new Set(orderedItems.map(item => item.series).filter(Boolean))];
const copy = siteCopy("journal");
const formatDate = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString("en-GH", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<section class="editorial-wrap collection-page journal-landing" id="journal-collection">
  <header class="journal-landing__intro">
    <h1>{publishedPage("journal")?.heading || "Stories for the journey."}</h1>
    <p>{publishedPage("journal")?.body || ""}</p>
  </header>

  {orderedItems.length ? (
    <>
      <section class="journal-landing__spotlight" aria-labelledby="journal-featured-title">
        <div class="journal-landing__section-heading">
          <h2 id="journal-featured-title">{copy.featuredHeading}</h2>
          <a class="journal-landing__text-link" href="#journal-archive">{copy.browseCta} <IconsaxIcon name="ArrowRight4" /></a>
        </div>
        <div class="journal-landing__spotlight-grid">
          {feature && (
            <article class="journal-landing__hero">
              {feature.image && <PlacedImage image={feature.image} placement={feature.imagePlacement} alt={feature.image.alt}
                sizes="(max-width: 760px) 94vw, (max-width: 1100px) 60vw, 750px" fetchpriority="high" />}
              <div class="journal-landing__hero-content">
                <span class="journal-landing__tag">{feature.category || "Travel stories"}</span>
                <h3><a href={`${prefix}/${feature.slug}`}>{feature.title}</a></h3>
                <p>{feature.excerpt}</p>
                <span class="journal-landing__hero-arrow" aria-hidden="true"><IconsaxIcon name="ArrowRight4" /></span>
              </div>
            </article>
          )}
          <div class="journal-landing__rail" aria-label="More featured stories">
            {quickReads.map(item => (
              <article class="journal-landing__rail-item">
                <a href={`${prefix}/${item.slug}`} class="journal-landing__rail-link">
                  {item.image && <PlacedImage image={item.image} placement={item.imagePlacement} alt={item.image.alt}
                    sizes="(max-width: 640px) 100px, 140px" loading="lazy" />}
                  <span class="journal-landing__rail-copy">
                    <span class="journal-landing__tag">{item.category || "Travel stories"}</span>
                    <strong>{item.title}</strong>
                    <time datetime={item.date}>{formatDate(item.date)}</time>
                  </span>
                  <IconsaxIcon name="ArrowRight4" />
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="journal-landing__archive" id="journal-archive" aria-labelledby="journal-archive-heading">
        <div class="journal-landing__section-heading">
          <div>
            <h2 id="journal-archive-heading">{copy.archiveHeading}</h2>
            <p>{copy.archiveBody}</p>
          </div>
        </div>
        <CollectionFilters client:load scope="journal-archive"
          options={categories} label="Category" seriesOptions={seriesOptions}/>
        <div class="journal-landing__archive-grid">
          {orderedItems.map(item => (
            <article class="journal-landing__story" data-collection-item
              data-category={item.category || "Travel stories"}
              data-series={item.series || ""}
              data-search={`${item.title} ${item.excerpt} ${item.category || ""} ${item.series || ""}`.toLocaleLowerCase()}>
              <a class="journal-landing__story-link" href={`${prefix}/${item.slug}`}>
                {item.image && <PlacedImage image={item.image} placement={item.imagePlacement} alt={item.image.alt}
                  sizes="(max-width: 640px) 45vw, (max-width: 1000px) 44vw, 28vw" loading="lazy" />}
                <span class="journal-landing__story-content">
                  <span class="journal-landing__tag">{item.category || "Travel stories"}</span>
                  <h3>{item.title}</h3>
                  <p>{item.excerpt}</p>
                  <span class="journal-landing__story-bottom"><time datetime={item.date}>{formatDate(item.date)}</time>
                    <IconsaxIcon name="ArrowRight4" /></span>
                </span>
              </a>
            </article>
          ))}
        </div>
        <noscript><p>All published stories are shown. Search and filters require JavaScript.</p></noscript>
      </section>
    </>
  ) : (
    <div class="review-empty"><h2>The Journal is taking shape.</h2>
      <p>Original stories and approved photography will appear here when published.</p></div>
  )}
</section>
