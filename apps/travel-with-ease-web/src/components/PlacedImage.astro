---
import type { PublicImage } from '../lib/collections';
import type { HTMLAttributes } from 'astro/types';
import '../styles/components/image-placement.css';
interface Props extends HTMLAttributes<'img'> {
 image?: PublicImage|null;
 placement?: {image?:PublicImage|null;mobileImage?:PublicImage|null;focalX?:number;focalY?:number;mobileFocalX?:number;mobileFocalY?:number;alt?:string};
 class?:string;sizes?:string;eager?:boolean;decorative?:boolean;
}
const {image:fallback,placement={},class:className,sizes='100vw',eager=false,decorative=false,...attributes}=Astro.props;
const highPriority=eager||attributes.fetchpriority==='high'||attributes.loading==='eager';
const image=placement.image||fallback||placement.mobileImage;
const sources=(photo:PublicImage)=>photo.sources?.map(source=>`${source.src} ${source.width}w`).join(', ')||photo.src;
const position=(value:number|undefined)=>Number.isFinite(value)?Math.min(100,Math.max(0,value!)):50;
const customFocus=['focalX','focalY','mobileFocalX','mobileFocalY'].some(key=>Object.hasOwn(placement,key));
---
{image&&<picture class:list={['placed-image',{'placed-image--custom-focus':customFocus}]} style={`--image-x:${position(placement.focalX)}%;--image-y:${position(placement.focalY)}%;--image-mobile-x:${position(placement.mobileFocalX??placement.focalX)}%;--image-mobile-y:${position(placement.mobileFocalY??placement.focalY)}%;`}>
 {placement.mobileImage&&<source media="(max-width:760px)" srcset={sources(placement.mobileImage)} sizes={sizes} width={placement.mobileImage.width} height={placement.mobileImage.height}/>}
 <img {...attributes} class={className} src={image.src} srcset={sources(image)} sizes={sizes} width={image.width} height={image.height} alt={decorative?'':placement.alt||image.alt} loading={highPriority?'eager':'lazy'} fetchpriority={highPriority?'high':undefined} decoding="async"/>
</picture>}
