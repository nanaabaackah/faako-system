---
import ContentLink from "./ContentLink.astro";
import TravelFootprint from "./TravelFootprint.astro";
import ClosingCta from "./ClosingCta.astro";
import TravelTips from "./TravelTips.astro";
import CinematicHero from "./CinematicHero.astro";
import ServicePanels from "./ServicePanels.astro";
import JourneyProcess from "./JourneyProcess.astro";
import { publishedPage } from "../lib/published.js";
import "../styles/components/home-sections.css";
import "../styles/components/journey-editorial.css";
const { content } = Astro.props;
const about = publishedPage("about");
const services = publishedPage("services");
const process = publishedPage("how-it-works");
const contact = publishedPage("contact");
const tips = publishedPage("travel-tips");
const footprint = publishedPage("travel-footprint");
---

<CinematicHero heading={content.heading} body={content.body} image={content.image} placement={content.imagePlacements?.hero} />
<div class="home-journey-chapters">
  {about && (
    <section id="about" class="journey-introduction">
      <div class="editorial-wrap journey-introduction__inner">
        <h2>{about.heading}</h2>
        <div class="journey-introduction__copy">
          <p>Journeys from Ghana, planned around you. Flights, stays and the details in between, handled with care.</p>
          <ContentLink href="/about">Meet Travel With Ease</ContentLink>
        </div>
      </div>
    </section>
  )}
  {services && <section id="services" aria-label="Travel planning services"><ServicePanels entries={services.entries} /></section>}
  {process && <JourneyProcess content={process} />}
</div>
<section id="our-world" class="cream-footprint">
  <div class="editorial-wrap">
    <TravelFootprint heading={footprint?.heading} description={footprint?.body}>
      {footprint && (
        <ul class="footprint-totals">
          {footprint.entries.map((entry: { heading: string; text: string }) => (
            <li><strong>{entry.heading}</strong><span>{entry.text}</span></li>
          ))}
        </ul>
      )}
    </TravelFootprint>
  </div>
</section>
{tips?.tips?.length > 0 && <TravelTips tips={tips.tips} />}
<!-- Packages and Journal retain their dedicated listing and detail pages. -->
<!-- The supplied mockup CTA and continuous enquiry/footer are unchanged. -->
<ClosingCta enquiryAvailable={Boolean(contact)} />
