---
import RichText from "./RichText.astro";
import ContentLink from "./ContentLink.astro";
import { siteCopy } from "../lib/editorial-copy.js";
import EditorialPhoto from "./EditorialPhoto.astro";
import TravelFootprint from "./TravelFootprint.astro";
import ClosingCta from "./ClosingCta.astro";
import TravellerReviews from "./TravellerReviews.astro";
import TravelTips from "./TravelTips.astro";
import CinematicHero from "./CinematicHero.astro";
import HomeServices from "./HomeServices.astro";
import FeaturedJourneys from "./FeaturedJourneys.astro";
import JourneyProcess from "./JourneyProcess.astro";
import AnimatedContent from "./react-bits/AnimatedContent.jsx";
import { publishedPage } from "../lib/published.js";
import type { JournalArticle } from "../lib/collections";
import "../styles/components/home-sections.css";
import "../styles/components/journey-editorial.css";
import "../styles/components/home-option-a.css";
const { content } = Astro.props;
const about = publishedPage("about");
const services = publishedPage("services");
const packages = publishedPage("packages");
const process = publishedPage("how-it-works");
const contact = publishedPage("contact");
const journal = publishedPage("journal");
const footprint = publishedPage("travel-footprint");
---

<CinematicHero heading={content.heading} body={content.body} image={content.image} placement={content.imagePlacements?.hero} />
{about && (
  <AnimatedContent client:visible className="home-scroll-motion" distance={28} duration={0.78} ease="power3.out" blur={3} threshold={0.12}>
    <div class="home-journey-chapters">
    <section id="about" class:list={["journey-introduction", "journey-introduction--option-a", { "journey-introduction--no-photo": !about.image }]}>
      <div class="editorial-wrap journey-introduction__inner">
        <div class="journey-introduction__story">
          <h2>{about.heading}</h2>
          <div class="journey-introduction__copy">
            <RichText value={about.body}/>
            <ContentLink href="/about">{siteCopy("home").aboutCta}</ContentLink>
          </div>
        </div>
        {about.image && (
          <div class="journey-introduction__artwork">
            <EditorialPhoto
              image={about.image}
              placement={about.imagePlacements?.feature}
              class="journey-introduction__photo"
              sizes="(max-width: 760px) 90vw, 42vw"
            />
          </div>
        )}
      </div>
    </section>
    </div>
  </AnimatedContent>
)}
{services?.entries?.length > 0 && (
  <AnimatedContent client:visible className="home-scroll-motion" distance={28} duration={0.78} ease="power3.out" blur={3} threshold={0.12}>
    <div class="home-journey-chapters">
      <HomeServices heading={services.heading} body={services.body} entries={services.entries} />
    </div>
  </AnimatedContent>
)}
{packages?.packages?.length > 0 && (
  <AnimatedContent client:visible className="home-scroll-motion" distance={28} duration={0.78} ease="power3.out" blur={3} threshold={0.12}>
    <FeaturedJourneys items={packages.packages} />
  </AnimatedContent>
)}
{process && (
  <AnimatedContent client:visible className="home-scroll-motion" distance={28} duration={0.78} ease="power3.out" blur={3} threshold={0.12}>
    <div class="home-journey-chapters">
      <JourneyProcess content={process} />
    </div>
  </AnimatedContent>
)}
<AnimatedContent client:visible className="home-scroll-motion" distance={28} duration={0.78} ease="power3.out" blur={3} threshold={0.12}>
  <section id="our-world" class="cream-footprint">
    <div class="editorial-wrap">
      <TravelFootprint heading={footprint?.heading} description={footprint?.body}>
        {footprint && (
          <ul class="footprint-totals">
            {footprint.entries.map((entry: { heading: string; text: string }) => (
              <li><strong>{entry.heading}</strong><span>{entry.text}</span></li>
            ))}
          </ul>
        )}
      </TravelFootprint>
    </div>
  </section>
</AnimatedContent>
{journal?.articles?.some((article: JournalArticle) => article.category === "Travel tip" && article.homeTipOrder) && (
  <AnimatedContent client:visible className="home-scroll-motion" distance={28} duration={0.78} ease="power3.out" blur={3} threshold={0.12}>
    <TravelTips tips={journal.articles} />
  </AnimatedContent>
)}
<!-- Packages and Journal retain their dedicated listing and detail pages. -->
<!-- The CTA and continuous enquiry/footer keep their existing appearance. -->
<ClosingCta enquiryAvailable={Boolean(contact)} />
<AnimatedContent client:visible className="home-scroll-motion" distance={24} duration={0.72} ease="power3.out" threshold={0.12}>
  <TravellerReviews />
</AnimatedContent>
