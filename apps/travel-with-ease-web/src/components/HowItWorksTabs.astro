---
import RichText from "./RichText.astro";
import ContentLink from "./ContentLink.astro";
import { siteCopy } from "../lib/editorial-copy.js";
import "../styles/components/how-it-works-tabs.css";
interface Step { heading: string; text: string }
interface Flow { steps: Step[]; example: string; exampleSteps?: Step[] }
interface Props {
  flows?: { package: Flow; planning: Flow };
  mode?: "steps" | "examples";
}
const { flows, mode = "steps" } = Astro.props;
const copy = siteCopy("how-it-works");
const exampleSteps = (flow: "package" | "planning"): Step[] => {
  const configured = flows?.[flow]?.exampleSteps;
  if (Array.isArray(configured) && configured.length >= 1 && configured.length <= 12) return configured;
  // Older CMS revisions have only a one-paragraph example; preserve a
  // structured example until the client saves the four editable stages.
  return (flow === "package" ? [
    { heading: "Choose the Nairobi package", text: "Two friends share their preferred travel month and confirm two travellers and a hotel tier." },
    { heading: "Review the live quote", text: "They compare hotel choices and inclusions against the quote for their preferred dates." },
    { heading: "Confirm their booking", text: "They check the payment schedule and each pay the required package deposit." },
    { heading: "Prepare for departure", text: "They receive their itinerary and travel pack for the confirmed journey." },
  ] : [
    { heading: "Share their Italy plans", text: "A couple submit their anniversary dates, budget and destination ideas." },
    { heading: "Review the itinerary", text: "After paying the planning-fee deposit, they review the proposed day-by-day plan and request a revision." },
    { heading: "Fund confirmed bookings", text: "They receive a separate Travel Fund Request for flights and hotels before any booking." },
    { heading: "Get ready to travel", text: "They settle the planning-fee balance and receive their final travel pack." },
  ]);
};
const valid = flows &&
  flows.package?.steps?.length >= 1 && flows.package.steps.length <= 12 &&
  flows.planning?.steps?.length >= 1 && flows.planning.steps.length <= 12;
---

{valid ? (
  mode === "steps" ? (
    <div class="planning-flow planning-flow--steps" data-process-flows>
      <div class="planning-flow__tablist" role="tablist" aria-label="How you would like to travel" hidden>
        <button type="button" id="package-flow-tab" role="tab" aria-controls="package-booking" aria-selected="true" tabindex="0" data-flow-tab="package">{copy.packageTitle}</button>
        <button type="button" id="planning-flow-tab" role="tab" aria-controls="trip-planning" aria-selected="false" tabindex="-1" data-flow-tab="planning">{copy.planningTitle}</button>
      </div>
      {(["package", "planning"] as const).map(flow => (
        <section class="planning-flow__panel" id={flow === "package" ? "package-booking" : "trip-planning"}
          role="tabpanel" aria-labelledby={flow === "package" ? "package-flow-tab" : "planning-flow-tab"}
          data-flow-panel={flow}>
          <h2>{flow === "package" ? copy.packageTitle : copy.planningTitle}</h2>
          <ol class="planning-flow__steps">
            {flows[flow].steps.map((step, index) => (
              <li>
                <span class="journey-process__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <div><h3>{step.heading}</h3><RichText value={step.text}/></div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  ) : (
    <div class="planning-flow planning-flow--examples" data-process-examples>
      {(["package", "planning"] as const).map(flow => (
        <section class="planning-flow__example-panel" data-example-panel={flow}
          aria-label={flow === "package" ? copy.packageExample : copy.planningExample}>
          <div class="planning-example">
            <div class="planning-example__intro">
              <h2>{flow === "package" ? copy.packageExample : copy.planningExample}</h2>
              <RichText value={flows[flow].example}/>
              {flow === "package" && <ContentLink href="/packages/nairobi">{copy.packageExampleCta}</ContentLink>}
            </div>
            <ol class="planning-example__steps">
              {exampleSteps(flow).map(step => <li><h3>{step.heading}</h3><RichText value={step.text}/></li>)}
            </ol>
            <div class="planning-example__next">
              <p>{flow === "package"
                ? "This illustrates the package process, not a real booking or confirmed quote. Your live quote sets out the agreed arrangements."
                : "This is an illustrative planning journey, not a client testimonial or confirmed arrangement. Booking costs remain separate from the planning fee."}</p>
              <ContentLink button href="#plan">{flow === "package" ? "Ask about a package" : "Tell us about your trip"}</ContentLink>
            </div>
          </div>
          <div class="planning-flow__footer">
            <ContentLink href={flow === "package" ? "/terms#package-terms" : "/terms#planning-terms"}>
              {flow === "package" ? copy.packageTermsCta : copy.planningTermsCta}
            </ContentLink>
          </div>
        </section>
      ))}
      <aside class="planning-flow__readiness">
        <p>{copy.readinessBody}</p>
        <ContentLink href="/services/travel-readiness-session">{copy.readinessCta}</ContentLink>
      </aside>
    </div>
  )
) : (
  <p role="status">The updated booking and planning process is not yet published. Please contact Travel With Ease for current steps and payment terms.</p>
)}
<script>
  document.querySelectorAll<HTMLElement>("[data-process-flows]").forEach(root => {
    const tabList = root.querySelector<HTMLElement>(".planning-flow__tablist");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-flow-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-flow-panel]"));
    if (!tabList || tabs.length !== 2 || panels.length !== 2) return;

    function activate(name: string, focus = false) {
      for (const tab of tabs) {
        const active = tab.dataset.flowTab === name;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      }
      for (const panel of panels) panel.hidden = panel.dataset.flowPanel !== name;
      document.querySelectorAll<HTMLElement>("[data-example-panel]").forEach(panel => {
        panel.hidden = panel.dataset.examplePanel !== name;
      });
    }
    const hash = window.location.hash;
    activate(hash === "#trip-planning" ? "planning" : "package");
    tabList.hidden = false;
    tabList.addEventListener("click", event => {
      const target = (event.target as Element).closest<HTMLButtonElement>("[data-flow-tab]");
      if (target && tabList.contains(target)) activate(target.dataset.flowTab || "package");
    });
    tabList.addEventListener("keydown", event => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
      event.preventDefault();
      const activeIndex = tabs.findIndex(tab => tab.getAttribute("aria-selected") === "true");
      const nextIndex = event.key === "Home" ? 0
        : event.key === "End" ? tabs.length - 1
        : (activeIndex + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
      activate(tabs[nextIndex].dataset.flowTab || "package", true);
    });
    window.addEventListener("hashchange", () => {
      if (window.location.hash === "#trip-planning") activate("planning");
      if (window.location.hash === "#package-booking") activate("package");
    });
  });
</script>
