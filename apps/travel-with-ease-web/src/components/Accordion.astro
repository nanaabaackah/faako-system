---
import { IconsaxIcon } from "@faako/ui";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="twe-accordion">
  <summary>
    <span class="accordion-question">{title}</span>
    <span class="accordion-toggle" aria-hidden="true">
      <IconsaxIcon
        name="Add"
        className="accordion-indicator"
        aria-hidden="true"
        focusable="false"
      />
    </span>
  </summary>
  <div class="accordion-answer"><slot /></div>
</details>
<style>
  @import "../styles/components/accordion.css";
</style>
