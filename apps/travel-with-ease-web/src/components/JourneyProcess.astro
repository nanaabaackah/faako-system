---
import RichText from "./RichText.astro";
import EditorialPhoto from "./EditorialPhoto.astro";
import photography from "../lib/journey-photography.json";
import { imagePlacement } from "../lib/image-placements.js";
import "../styles/components/journey-editorial.css";
import "../styles/components/planning-process.css";
import ContentLink from "./ContentLink.astro";
import { siteCopy } from "../lib/editorial-copy.js";
import HomeJourneyStepper from "./HomeJourneyStepper.jsx";
import HowItWorksTabs from "./HowItWorksTabs.astro";
import { withUpdatedPackageFlow } from "../../../travel-with-ease-api/src/content/process-flow.js";
interface Step { heading:string; text:string }
interface Flow { steps: Step[]; example: string; exampleSteps?: Step[] }
interface Props {
  content: {
    heading:string;
    body:string;
    entries: Step[];
    processFlows?: { package:Flow; planning:Flow };
    imagePlacements?:Record<string,import("../lib/collections").ImagePlacement>;
  };
  page?:boolean;
}
const { content, page = false } = Astro.props;
const photo = imagePlacement(content,"feature",photography.park);
// Homepage and dedicated page both use the same client-approved, CMS-authored
// processes. Keep the original photograph and homepage React Bits stepper.
const homepageFlows: Props["content"]["processFlows"] = withUpdatedPackageFlow(content.processFlows);
const readyFlows = (homepageFlows?.package?.steps?.length ?? 0) > 0
  && (homepageFlows?.planning?.steps?.length ?? 0) > 0 ? homepageFlows : null;
const copy = siteCopy("how-it-works");
---

<section class:list={["journey-process editorial-wrap", { "planning-process": page, "journey-process--option-a": !page }]} id="how-it-works" data-image-layout={photo.layout}>
  <EditorialPhoto image={photography.park} placement={photo} class="journey-process__photo" />
  <div class="journey-process__steps">
    {page ? <h1>{content.heading}</h1> : <h2>{content.heading}</h2>}
    <RichText class="journey-process__introduction" value={content.body}/>
    {page && <HowItWorksTabs flows={homepageFlows} mode="steps" />}
    {!page && (
      <>
        {readyFlows && (
          <HomeJourneyStepper flows={readyFlows} client:visible copy={copy} />
        )}
        <noscript>
          {(["package", "planning"] as const).map((flow) => readyFlows && (
            <section class="journey-process__noscript-flow">
              <h3>{flow === "package" ? copy.packageTab : copy.planningTab}</h3>
              <ol class="journey-process__fallback">
                {readyFlows[flow].steps.map((step, index) => (
                  <li>
                    <span class="journey-process__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <div><h3>{step.heading}</h3><RichText value={step.text}/></div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </noscript>
        <p class="journey-process__other-flow"><ContentLink href="/how-it-works">{copy.detailsLink}</ContentLink></p>
      </>
    )}
  </div>
</section>
{page && (
  <section class="planning-process__details editorial-wrap" aria-label="Booking and planning worked examples">
    <HowItWorksTabs flows={homepageFlows} mode="examples" />
  </section>
)}
