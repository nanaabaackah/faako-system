---
import EditorialPhoto from "./EditorialPhoto.astro";
import photography from "../lib/journey-photography.json";
import { imagePlacement } from '../lib/image-placements.js';
import "../styles/components/journey-editorial.css";
interface Props {
  content: { heading: string; body: string; entries: { heading: string; text: string }[];imagePlacements?:Record<string,import('../lib/collections').ImagePlacement> };
  page?: boolean;
}
const { content, page = false } = Astro.props;
const photo=imagePlacement(content,'feature',photography.park);
// Short homepage summaries; the dedicated page retains complete approved terms.
const summaries = [
  "Tell us where you would like to go, when, and who is travelling.",
  "We discuss your requirements and recommend suitable planning support or a live quote.",
  "Review your proposal and agree the next steps before any payment or booking.",
  "Receive your itinerary and travel information as arrangements are confirmed.",
];
---

<section class="journey-process editorial-wrap" id="how-it-works" data-image-layout={photo.layout}>
  <EditorialPhoto image={photography.park} placement={photo} class="journey-process__photo" />
  <div>
    {page ? <h1>{content.heading}</h1> : <h2>{content.heading}</h2>}
    {page && <p class="journey-process__introduction">{content.body}</p>}
    <ol>
      {content.entries.map((step, index) => (
        <li>
          <span class="journey-process__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div><h3>{step.heading}</h3><p>{page ? step.text : summaries[index] || step.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
