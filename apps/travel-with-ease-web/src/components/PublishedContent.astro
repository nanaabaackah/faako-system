---
import Accordion from "./Accordion.astro";
import ContentLink from "./ContentLink.astro";
import ServicePanels from "./ServicePanels.astro";
import EditorialPhoto from "./EditorialPhoto.astro";
import photography from "../lib/journey-photography.json";
import "../styles/components/published-content.css";
interface Props {
  accordion?: boolean;
  content: {
    heading: string;
    body: string;
    ctaLabel: string;
    ctaPath: string;
    contactEmail: string;
    contactPhone: string;
    entries: { heading: string; text: string; attribution: string }[];
    image: {
      src: string;
      alt: string;
      width: number;
      height: number;
      sources?: { src: string; width: number }[];
    } | null;
  } | null;
}
const { content, accordion = false } = Astro.props;
const page = Astro.url.pathname.replace(/\/$/, "");
const services = page === "/services";
const story = page === "/about";
---

<section class:list={["published-content", {
  "published-content--editorial": Boolean(content?.image),
  "published-content--faq": accordion,
  "published-content--services": services,
  "published-content--story": story,
}]}>
  {
    content ? (
      <>
        <header class="published-content__header">
          <div>
            <h1>{content.heading}</h1>
            <p class="body-copy">{content.body}</p>
          </div>
        {content.image && !services && !story && (
          <img
            src={content.image.src}
            srcset={content.image.sources
              ?.map(
                (source: { src: string; width: number }) =>
                  `${source.src} ${source.width}w`,
              )
              .join(", ")}
            sizes="(max-width: 760px) 90vw, 1200px"
            alt={content.image.alt}
            width={content.image.width}
            height={content.image.height}
          />
        )}
        </header>
        {story && <EditorialPhoto image={photography.coast} class="published-content__story-photo" sizes="90vw" />}
        {services ? <ServicePanels entries={content.entries} all /> : (
        <div class="published-content__sections">
        {content.entries.map((entry) =>
          accordion ? (
            <Accordion title={entry.heading}>
              <p>{entry.text}</p>
              {entry.attribution && <p>{entry.attribution}</p>}
            </Accordion>
          ) : (
            <section>
              <h2>{entry.heading}</h2>
              <p>{entry.text}</p>
              {entry.attribution && <p>{entry.attribution}</p>}
            </section>
          ),
        )}
        </div>
        )}
        {content.contactEmail && <p>{content.contactEmail}</p>}
        {content.contactPhone && <p>{content.contactPhone}</p>}
        {content.ctaLabel && (
          <ContentLink button href={content.ctaPath}>
            {content.ctaLabel}
          </ContentLink>
        )}
      </>
    ) : (
      <>
        <>
          <h1>Content unavailable</h1>
          <p>This page is not currently published.</p>
        </>
      </>
    )
  }
</section>
