---
import ContentLink from "./ContentLink.astro";
import CurrencyAttribution from "./CurrencyAttribution.astro";
import PackageTicketCard from "./PackageTicketCard.jsx";
import { packageStartingPrice } from "../lib/package-pricing.js";
import type { TravelPackage } from "../lib/collections";
import "../styles/components/home-features.css";
import "../styles/components/package-experience.css";

interface Props {
  items: TravelPackage[];
}
const { items } = Astro.props;
const approvedOrder = ["zanzibar", "nairobi"];
const featured = items
  .filter((item) => approvedOrder.includes(item.slug))
  .sort((a, b) => approvedOrder.indexOf(a.slug) - approvedOrder.indexOf(b.slug))
  .slice(0, 2);
---

{featured.length > 0 && (
  <section id="featured-journeys" class="featured-journeys" aria-labelledby="featured-journeys-heading">
    <div class="editorial-wrap">
      <div class="home-section-heading">
        <div>
          <h2 id="featured-journeys-heading">Discover Journeys worth exploring.</h2>
          <p>Start with a destination that speaks to you. We'll help shape the details around your dates.</p>
        </div>
        <ContentLink href="/packages">Explore all packages</ContentLink>
      </div>
      <div class="featured-journeys__grid">
        {featured.map((item) => (
          <article class="featured-journeys__card package-ticket-frame">
            <PackageTicketCard
              title={item.title}
              duration={item.duration}
              summary={item.tagline || item.destination}
              description={item.overview || item.tagline || item.destination}
              price={packageStartingPrice(item)}
              href={`/packages/${item.slug}`}
              imageSrc={item.imagePlacement?.image?.src || item.image?.src || item.imagePlacement?.mobileImage?.src || ""}
              imageAlt={item.imagePlacement?.alt || item.imagePlacement?.image?.alt || item.image?.alt || ""}
              groupFriendly={item.groupFriendly}
              headingLevel="h3"
              client:visible
            />
          </article>
        ))}
      </div>
      <CurrencyAttribution />
    </div>
  </section>
)}
