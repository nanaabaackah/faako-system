---
import ContentLink from "./ContentLink.astro";
import photos from "../lib/approved-preview-media.json";
import "../styles/components/cinematic-hero.css";
interface Props {
  heading: string;
  body: string;
  image?: {
    src: string;
    alt: string;
    width: number;
    height: number;
    sources?: { src: string; width: number }[];
  } | null;
  demo?: boolean;
}
const { heading, body, image, demo = false } = Astro.props;
const approved = photos.find((photo) => photo.country === "Kenya")!;
const photo = image || { ...approved, src: approved.sources.at(-1)!.src };
const variants = photos.find((item) =>
  item.sources.some((source) => source.src === photo.src),
);
---

<section
  class:list={["cinematic-hero", { "cinematic-hero--text": !image && !demo }]}
  aria-labelledby="hero-heading"
>
  {
    (image || demo) && (
      <img
        class="cinematic-hero__image"
        src={photo.src}
        srcset={(photo.sources || variants?.sources || [])
          .map((source) => `${source.src} ${source.width}w`)
          .join(", ")}
        sizes="100vw"
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    )
  }
  <div class="cinematic-hero__copy">
    <h1 id="hero-heading">{heading}</h1>
    <p>{body}</p>
    <div class="cinematic-hero__actions">
      <ContentLink
        button
        href={demo ? "#demo-plan" : "#plan"}
        data-demo-personalised={demo ? "" : undefined}
        >{demo ? "Try planning a trip" : "Plan your trip"}</ContentLink
      >
      <ContentLink href={demo ? "#demo-packages" : "#our-world"}
        >{
          demo ? "Explore sample journeys" : "Our travel footprint"
        }</ContentLink
      >
    </div>
    {demo && <small>Design demonstration · not bookable offers.</small>}
  </div>
  <a
    class="cinematic-hero__scroll"
    href={demo ? "#demo-packages" : "#our-world"}>Discover more</a
  >
</section>
