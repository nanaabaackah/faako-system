---
import ContentLink from "./ContentLink.astro";
import photos from "../lib/approved-preview-media.json";
import PlacedImage from './PlacedImage.astro';
import "../styles/components/cinematic-hero.css";
interface Props {
  heading: string;
  body: string;
  image?: {
    src: string;
    alt: string;
    width: number;
    height: number;
    sources?: { src: string; width: number }[];
  } | null;
  placement?: import('../lib/collections').ImagePlacement;
}
const { heading, body, image, placement={} } = Astro.props;
const signature = /a little more you\.?/i;
const parts = heading.split(signature);
const approved = photos.find((photo) => photo.placement === "hero")!;
const photo = placement.image || image || { ...approved, src: approved.sources.at(-1)!.src };
const variants = photos.find((item) =>
  item.sources.some((source) => source.src === photo.src),
);
---

<section
  class:list={["cinematic-hero", { "cinematic-hero--text": !image && !placement.image }]}
  aria-labelledby="hero-heading"
>
  {
    (image || placement.image) && (
      <PlacedImage image={{...photo,sources:photo.sources||variants?.sources}} placement={placement}
        class="cinematic-hero__image"
        sizes="100vw"
        eager
      />
    )
  }
  <div class="cinematic-hero__copy">
    <h1 id="hero-heading">
      {
        signature.test(heading) ? (
          <>
            {parts[0]}
            <span class="hero-signature">A Little More You</span>
            {parts[1]}
          </>
        ) : (
          heading
        )
      }
    </h1>
    <p>{body}</p>
    <div class="cinematic-hero__actions">
      <ContentLink
        button
        href="#plan"
        >Plan your trip</ContentLink
      >
      <ContentLink href="/packages"
        >Explore Packages</ContentLink
      >
    </div>
  </div>
  <a
    class="cinematic-hero__scroll"
    href="#about">Discover more</a
  >
</section>
