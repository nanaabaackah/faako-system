---
import SharedFaakoFooter from "./SharedFaakoFooter.jsx";
import CurrencySwitcher from "./CurrencySwitcher.jsx";
import { displayCurrencyPolicyHeading } from "../lib/currency-display.js";
import { publishedPage } from "../lib/published.js";
import { siteBranding } from "../lib/branding.js";
import { siteCopy } from "../lib/editorial-copy.js";
import photography from "../lib/assigned-photography.json";
const { cinematic = false } = Astro.props;
const visible = (slug: string) =>
  Boolean(publishedPage(slug));
const contact = publishedPage("contact");
const footer = publishedPage("footer");
type FooterLink = { id: string; group: "explore" | "social" | "contact" | "legal"; label: string; href: string; visible: boolean; order: number };
const footerLinks = (footer?.footerLinks || []) as FooterLink[];
const copy = footer ? siteCopy("footer") : siteCopy("site-appearance");
const branding = siteBranding(footer || publishedPage("site-appearance"));
const currencyNoticePublished = publishedPage("terms")?.entries?.some(
  (entry: { heading: string }) => entry.heading === displayCurrencyPolicyHeading,
);
const closingPhoto = photography.footer;
const footerPhoto = footer?.imagePlacements?.["footer-background"]?.image || closingPhoto;
const email =
  (footer?.contactEmail || contact?.contactEmail) &&
  /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(footer?.contactEmail || contact.contactEmail)
    ? (footer?.contactEmail || contact.contactEmail)
    : "info@travelwitheasegh.com";
const phone =
  (footer?.contactPhone || contact?.contactPhone) && /^\+?[\d ()-]{7,30}$/.test(footer?.contactPhone || contact.contactPhone)
    ? (footer?.contactPhone || contact.contactPhone)
    : "+233200209170";
---

<footer
  class:list={[
    "twe-public-footer",
    "twe-public-footer--cinematic",
    { "twe-public-footer--standalone": !cinematic },
  ]}
>
  {
    !cinematic && (
      <img
        class="footer-scene-image"
        src={footerPhoto.src}
        srcset={(footerPhoto.sources || [])
          .map(
            (source: { src: string; width: number }) =>
              `${source.src} ${source.width}w`,
          )
          .join(", ")}
        sizes="100vw"
        alt={footerPhoto.alt || ""}
        width={footerPhoto.width}
        height={footerPhoto.height}
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="footer-top">
    <div class="footer-brand-block">
      <a
        class="brand"
        href="/"
        aria-label="Travel With Ease home"
        ><img
          src={branding.footerLogo}
          width="640"
          height="248"
          alt={copy.logoAlt || "Travel With Ease"}
          loading="lazy"
        /></a
      >
      {footer?.body && <p>{footer.body}</p>}
    </div>
    <div class="footer-links">
      {footerLinks.length ? ["explore", "social", "contact"].map(group => <nav aria-label={group === "social" ? "Social media" : group}><h2>{group === "explore" ? copy.footerExplore : group === "social" ? copy.footerSocial : copy.footerContact}</h2>{footerLinks.filter(link => link.visible && link.group === group).sort((a,b)=>a.order-b.order).map(link => <a href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>{link.label}</a>)}</nav>) : <>
      <nav aria-label="Explore">
        <h2>{copy.footerExplore}</h2>{
          (visible("packages") || visible("destinations")) && (
            <a href="/packages">{copy.footerPackages}</a>
          )
        }{
          visible("services") && (
            <a href="/services">{copy.footerServices}</a>
          )
        }{visible("about") && <a href="/about">{copy.footerAbout}</a>}{
          visible("journal") && (
            <a href="/journal">{copy.footerJournal}</a>
          )
        }
      </nav>
      <nav aria-label="Social media">
        <h2>{copy.footerSocial}</h2>
        <a href={copy.instagramUrl} rel="noreferrer"
          >Instagram</a
        >
        <a href={copy.tiktokUrl} rel="noreferrer"
          >TikTok</a
        >
        <a href={copy.whatsappUrl} rel="noreferrer">WhatsApp</a>
      </nav>
      </>}
      <nav aria-label="Help and contact">
        <h2>{copy.footerContact}</h2>{
          visible("faqs") && <a href="/faqs">{copy.footerFaqs}</a>
        }{
          visible("contact") && (
            <a href="/contact">{copy.footerContactLink}</a>
          )
        }{email && <a href={"mailto:" + email}>{email}</a>}{
          phone && <a href={"tel:" + phone.replace(/[^+\d]/g, "")}>{phone}</a>
        }
      </nav>
    </div>
  </div>
  <div class="footer-legal">
    <p class="footer-company-details">
      {copy.companyDetails}
    </p><nav aria-label="Legal and preferences">
      {
        (
          <>
            {footerLinks.some(link => link.visible && link.group === "legal")
              ? footerLinks.filter(link => link.visible && link.group === "legal").sort((a,b)=>a.order-b.order).map(link => <a href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>{link.label}</a>)
              : <>{visible("privacy") && <a href="/privacy">{copy.footerPrivacy}</a>}{visible("terms") && <a href="/terms">{copy.footerTerms}</a>}{visible("cookies") && <a href="/cookies">{copy.footerCookies}</a>}</>}
          </>
        )
      }<button type="button" data-cookie-settings
        >{copy.cookieSettingsLabel || "Cookie settings"}</button
      >{currencyNoticePublished && <CurrencySwitcher client:load />}<a href="#top">{copy.footerTop}</a>
    </nav>
  </div>
  {footer && <p class="footer-copyright">{copy.copyrightText}</p>}
  <SharedFaakoFooter />
  <p class="footer-signature" aria-label="Travel With Ease">TRAVEL WITH EASE</p>
</footer>
<style>
  @import "../styles/components/public-footer.css";
</style>
