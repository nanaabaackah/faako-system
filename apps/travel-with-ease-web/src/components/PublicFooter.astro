---
import SharedFaakoFooter from "./SharedFaakoFooter.jsx";
import TravelFootprint from "./TravelFootprint.astro";
import ContentLink from "./ContentLink.astro";
import { publishedPage, publicationSnapshotPath } from "../lib/published.js";
const { demo = false } = Astro.props;
const visible = (slug: string) => demo || !publicationSnapshotPath() || Boolean(publishedPage(slug));
const contact = demo ? null : publishedPage("contact");
const email = contact?.contactEmail && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contact.contactEmail) ? contact.contactEmail : null;
const phone = contact?.contactPhone && /^\+?[\d ()-]{7,30}$/.test(contact.contactPhone) ? contact.contactPhone : null;
---
<footer class="twe-public-footer">
  <div class="footer-top"><div class="footer-brand-block"><a class="brand" href={demo ? "/demo" : "/"} aria-label="Travel With Ease home"><img src="/brand/Primary gold.png" width="640" height="248" alt="Travel With Ease" loading="lazy" /></a><p>Travel planning from Ghana.<br />A little further. A little more you.</p>{visible("contact") && <ContentLink button href={demo ? "#demo-plan" : "/contact"}>{demo ? "Try the enquiry demo" : "Plan a trip"}</ContentLink>}</div>
    <div class="footer-links"><nav aria-label="Explore"><h2>Explore</h2>{visible("destinations") && <a href={demo ? "#demo-packages" : "/destinations"}>Destinations</a>}{visible("services") && <a href={demo ? "#demo-process" : "/services"}>Services</a>}{visible("about") && <a href="/about">About TWE</a>}{visible("journal") && <a href={demo ? "#demo-journal" : "/journal"}>Travel journal</a>}</nav>
    <nav aria-label="Help and contact"><h2>Let’s talk</h2>{visible("faqs") && <a href={demo ? "#demo-faqs" : "/faqs"}>FAQs</a>}{visible("contact") && <a href={demo ? "#demo-plan" : "/contact"}>Contact</a>}{email && <a href={"mailto:" + email}>{email}</a>}{phone && <a href={"tel:" + phone.replace(/[^+\d]/g,"")}>{phone}</a>}{!email && !phone && <small>Contact details awaiting approval.</small>}</nav></div>
    <TravelFootprint compact demo={demo} />
  </div>
  <div class="footer-legal"><span>{demo ? "Local demonstration · no live offers" : "Travel With Ease"}</span><nav aria-label="Legal and preferences">{!demo && <>{visible("privacy") && <a href="/privacy">Privacy</a>}{visible("terms") && <a href="/terms">Terms</a>}<button type="button" data-cookie-settings>Cookie settings</button></>}<a href="#top">Back to top</a></nav></div>
  <SharedFaakoFooter />
</footer>
<style>
  .twe-public-footer { display: block; background: #000a1f; color: #f4ede3; padding: 52px max(5%, calc((100% - 1280px)/2)) 0; }
  .twe-public-footer :global(div) { align-items: initial; }
  .twe-public-footer :global(.ui-app-bottom-bar) { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 20px; padding: 22px 0; border-top: 1px solid #344057; background: transparent; color: #b6b1a9; font-size: 12px; }
  .twe-public-footer :global(.ui-app-bottom-bar__powered) { display: inline-flex; gap: 7px; align-items: center; }
  .twe-public-footer :global(.ui-app-bottom-bar__mark svg) { width: 20px; height: 20px; }
  .footer-brand-block { display: block; }
  .footer-top { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 40px; }
  .brand img { width: 190px; height: auto; padding: 0; }
  p { font-size: 14px; line-height: 1.8; margin: 20px 0; color: #c3c9d4; }
  .footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  nav { display: flex; flex-direction: column; align-items: start; gap: 12px; }
  h2 { font-size: 14px; margin: 0 0 8px; color: #d8b56a; }
  a, button { color: inherit; font-size: 13px; text-decoration: none; }
  nav a, nav button { min-height: 28px; } a:hover, button:hover { text-decoration: underline; }
  small { font-size: 12px; line-height: 1.6; color: #b6b1a9; }
  .footer-legal { border-top: 1px solid #344057; margin-top: 36px; padding: 24px 0; display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; font-size: 12px; }
  .footer-legal nav { flex-direction: row; flex-wrap: wrap; gap: 20px; }
  button { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; }
  .footer-brand-block :global(.button) { background: #d8b56a; color: #010c33; border-color: #d8b56a; }
  @media(max-width:1000px) { .footer-top { grid-template-columns: 1fr 1fr; } .footer-top :global(.travel-footprint) { grid-column: 1 / -1; } }
  @media(max-width:600px) { .footer-top { grid-template-columns: 1fr; } .footer-links { gap: 28px; } nav a, nav button { min-height: 44px; display: inline-flex; align-items: center; } }
</style>
