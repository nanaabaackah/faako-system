---
import "../styles/components/traveller-reviews.css";

import { publishedPage } from "../lib/published.js";
import { siteCopy } from "../lib/editorial-copy.js";
import { approvedTravellerReviews } from "../../../travel-with-ease-api/src/content/editorial-fields.js";
const home = publishedPage("home");
const copy = siteCopy("home");
const reviews: {preview:string; more:string}[] = home ? (home.reviews ?? approvedTravellerReviews) : [];
const paragraphs = (text: string) => text.split(/\n\s*\n/).filter(Boolean);
---

{reviews.length > 0 && <section id="traveller-reviews" class="traveller-reviews" aria-labelledby="traveller-reviews-heading">
  <div class="editorial-wrap traveller-reviews__inner">
    <header class="traveller-reviews__header">
      <h2 id="traveller-reviews-heading">{copy.reviewsHeading}</h2>
    </header>

    <div class="traveller-reviews__track" data-traveller-reviews-track>
      {reviews.map((review, index) => (
        <article class="traveller-reviews__card" id={`traveller-review-${index + 1}`} aria-label={`Traveller review ${index + 1} of ${reviews.length}`}>
          <span class="traveller-reviews__quote-mark" aria-hidden="true">“</span>
          <blockquote class="traveller-reviews__quote">
            {paragraphs(review.preview).map(text => <p>{text}</p>)}
          </blockquote>
          {review.more && <details class="traveller-reviews__details">
            <summary>{copy.reviewsExpand}</summary>
            <div class="traveller-reviews__continuation">
              {paragraphs(review.more).map(text => <p>{text}</p>)}
            </div>
          </details>}
        </article>
      ))}
    </div>
    <nav class="traveller-reviews__pagination" aria-label="Traveller review navigation">
      {reviews.map((_, index) => (
        <button type="button" class="traveller-reviews__dot" data-review-jump={index} aria-label={`Show review ${index + 1}`} aria-current={index === 0 ? "true" : undefined}>
          <span aria-hidden="true"></span>
        </button>
      ))}
    </nav>
  </div>
</section>}

<script>
  const track = document.querySelector<HTMLElement>("[data-traveller-reviews-track]");
  if (track) {
    const cards = [...track.querySelectorAll<HTMLElement>(".traveller-reviews__card")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".traveller-reviews__dot")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const update = () => {
      const scrollRange = Math.max(0, track.scrollWidth - track.clientWidth);
      const active = scrollRange > 0
        ? Math.round((track.scrollLeft / scrollRange) * (cards.length - 1))
        : 0;
      dots.forEach((dot, index) => {
        if (index === active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };
    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        track.scrollTo({
          left: cards[index].offsetLeft - track.offsetLeft,
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
        dots.forEach((item, itemIndex) => {
          if (itemIndex === index) item.setAttribute("aria-current", "true");
          else item.removeAttribute("aria-current");
        });
      });
    });
    let pending = false;
    track.addEventListener("scroll", () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        update();
        pending = false;
      });
    }, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>
