---
import { richTextBlocks } from "../../../travel-with-ease-api/src/content/rich-text.js";
import RichInline from "./RichInline.astro";
import "../styles/components/rich-text.css";
interface Props { value?: string; class?: string; money?: boolean }
const { value = "", class: className = "", money = false } = Astro.props;
const blocks = richTextBlocks(value);
---
{blocks.length === 1 && blocks[0].type === "paragraph" ? <p class:list={["twe-rich-text", className]}><RichInline value={blocks[0].text} money={money}/></p> : <div class:list={["twe-rich-text", className]}>
  {blocks.map(block => block.type === "paragraph" ? <p><RichInline value={block.text} money={money}/></p> :
    block.type === "ordered" ? <ol start={block.start}>{block.items.map(item => <li><RichInline value={item} money={money}/></li>)}</ol> :
    <ul>{block.items.map(item => <li><RichInline value={item} money={money}/></li>)}</ul>)}
</div>}
