---
import Accordion from "./Accordion.astro";
import ContentLink from "./ContentLink.astro";
import TravelFootprint from "./TravelFootprint.astro";
import ClosingCta from "./ClosingCta.astro";
import DemoEnquiry from "./DemoEnquiry.jsx";
import photos from "../lib/approved-preview-media.json";
const kenya = photos.find((photo) => photo.country === "Kenya")!;
const zanzibar = photos.find((photo) => photo.country === "Zanzibar")!;
const { live = false, apiOrigin = "" } = Astro.props;
---

<div class="travel-demo">
  <section class="demo-wrap demo-hero">
    <div>
      <p>From Ghana, with curiosity.</p><h1>
        A little further.<br />A little more you.
      </h1><p>
        Room for discovery. Time to slow down. Explore what your next journey
        could look like.
      </p>
      <div class="demo-links">
        <ContentLink button href="#demo-packages"
          >Explore sample journeys</ContentLink
        ><ContentLink href="#demo-plan">Try planning a trip</ContentLink>
      </div>
      <small>Design demonstration · not bookable offers.</small>
    </div>
    <figure>
      <img
        src={kenya.sources.at(-1)!.src}
        width={kenya.width}
        height={kenya.height}
        alt={kenya.alt}
        loading="eager"
        fetchpriority="high"
      /><figcaption>Kenya · TWE-supplied photography</figcaption>
    </figure>
  </section>
  <section id="demo-packages" class="demo-wrap demo-packages">
    <div class="demo-heading">
      <h2>Find your kind<br />of getaway.</h2><p>
        Two sample itineraries to explore the design.<br />Dates, availability
        and prices await approval.
      </p>
    </div>
    <div class="demo-package-grid">
      {
        [
          {
            photo: zanzibar,
            name: "Zanzibar",
            title: "A slower rhythm in Zanzibar",
            copy: "A demonstration of a coast-focused journey. Inclusions and dates are not confirmed.",
          },
          {
            photo: kenya,
            name: "Kenya",
            title: "A different view of Kenya",
            copy: "A demonstration of a discovery-focused journey. This is not an advertised or priced offer.",
          },
        ].map((item) => (
          <article>
            <img
              src={item.photo.sources.at(-1)!.src}
              width={item.photo.width}
              height={item.photo.height}
              alt={item.photo.alt}
              loading="lazy"
            />
            <div>
              <>
                <small>Sample journey · {item.name}</small>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
                <ContentLink
                  href="#demo-plan"
                  data-demo-destination={item.name}
                >
                  Explore this sample
                </ContentLink>
              </>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section id="demo-footprint" class="demo-wrap">
    <TravelFootprint demo />
  </section>
  <section id="demo-process" class="demo-process">
    <div class="demo-wrap">
      <div>
        <h2>Less uncertainty.<br />More possibility.</h2><p>
          Preview the enquiry journey, from an initial idea to a conversation
          about the details.
        </p>
      </div>
      <ol>
        <li>
          <span>01</span><div>
            <h3>Start with an idea</h3><p>
              Choose a sample journey or the kind of trip you have in mind.
            </p>
          </div>
        </li><li>
          <span>02</span><div>
            <h3>Shape the details</h3><p>
              Explore the dates, pace and preferences that matter to you.
            </p>
          </div>
        </li><li>
          <span>03</span><div>
            <h3>Make an informed choice</h3><p>
              In the live service, confirm the actual offer and terms with the
              agency.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section id="demo-journal" class="demo-wrap demo-journal" data-twe-reveal>
    <figure>
      <img
        src={zanzibar.sources.at(-1)!.src}
        width={zanzibar.width}
        height={zanzibar.height}
        alt={zanzibar.alt}
        loading="lazy"
      /><figcaption>Zanzibar · TWE-supplied photography</figcaption>
    </figure>
    <div>
      <small>Travel Journal · sample editorial</small><h2>
        The moments<br />between the plans.
      </h2><p>
        A quieter morning. A new view. A little time to notice where you are.
      </p><p>
        This sample introduces the journal layout. Approved stories will replace
        it before publication.
      </p><Accordion title="Read the sample story"
        ><p>
          A journey is more than a list of stops. This demonstration shows where
          an original, approved travel story will appear, with destination
          context, licensed images and useful information.
        </p></Accordion>
    </div>
  </section>
  <section id="demo-faqs" class="demo-wrap">
    <h2>A few things to know.</h2><Accordion
      title="Can I book these sample journeys?"
      ><p>
        No. These demonstrate the website layout, not available offers.
      </p></Accordion
    ><Accordion title="Will this form contact the team?"
      ><p>{live ? "Yes. This staging demo saves test enquiries for authorised staff to review, without booking or sending a confirmation." : "No. The local preview does not send or save your choices."}</p></Accordion
    ><p>Client testimonials will appear only after approval and permission.</p>
  </section>
  <ClosingCta demo />
  <section id="demo-plan" class="demo-wrap demo-plan">
    <div>
      <h2>Where would<br />you like to go?</h2><p>
        {live ? "Try a real staging test enquiry. Questions and contact details are saved to the staging Traveller inbox, but no booking, payment, or automatic notification is created." : "Try the local preview. Nothing is stored or submitted."}
      </p>{live ? <p><ContentLink href="https://portal-staging.travelwitheasegh.com/demo">Explore the staging staff portal demo</ContentLink><small>Cloudflare Access required. The portal demo uses simulated records; real staging test enquiries are available only in the authenticated staff CMS.</small></p> : <p>Staff dashboard preview is available separately in local development.</p>}
    </div>
    <DemoEnquiry live={live} apiOrigin={apiOrigin} client:load />
  </section>
</div>
<style>
  @import "../styles/components/demo-website.css";
</style>
