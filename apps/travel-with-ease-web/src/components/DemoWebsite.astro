---
import Accordion from "./Accordion.astro";
import ContentLink from "./ContentLink.astro";
import TravelFootprint from "./TravelFootprint.astro";
import ClosingCta from "./ClosingCta.astro";
import CinematicHero from "./CinematicHero.astro";
import photos from "../lib/approved-preview-media.json";
const kenya = photos.find((photo) => photo.placement === "wildlife")!;
const zanzibar = photos.find((photo) => photo.placement === "closing")!;
const journalPhoto = photos.find((photo) => photo.placement === "journal")!;
const { live = false } = Astro.props;
---

<div class="travel-demo">
  <CinematicHero
    demo
    heading="A little further. A little more you."
    body="Room for discovery. Time to slow down. Explore what your next journey could look like."
  />
  <section id="demo-packages" class="demo-wrap demo-packages">
    <div class="demo-heading">
      <h2>Find your kind<br />of getaway.</h2><p>
        Two sample itineraries to explore the design.<br />Dates, availability
        and prices await approval.
      </p>
    </div>
    <div class="demo-package-grid">
      {
        [
          {
            photo: zanzibar,
            name: "Zanzibar",
            title: "A slower rhythm in Zanzibar",
            copy: "A demonstration of a coast-focused journey. Inclusions and dates are not confirmed.",
          },
          {
            photo: kenya,
            name: "Kenya",
            title: "A different view of Kenya",
            copy: "A demonstration of a discovery-focused journey. This is not an advertised or priced offer.",
          },
        ].map((item) => (
          <article class="journey-card">
            <img
              src={item.photo.sources.at(-1)!.src}
              width={item.photo.width}
              height={item.photo.height}
              alt={item.photo.alt}
              loading="lazy"
            />
            <div>
              <>
                <small>Sample journey · {item.name}</small>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
                <ContentLink
                  class="journey-card__link"
                  href="#demo-enquiry-form"
                  data-demo-destination={item.name}
                >
                  Explore this sample
                </ContentLink>
              </>
            </div>
          </article>
        ))
      }
    </div>
  </section>
  <section id="demo-footprint" class="cream-footprint">
    <div class="demo-wrap"><TravelFootprint demo /></div>
  </section>
  <section id="demo-process" class="demo-process">
    <div class="demo-wrap">
      <div>
        <h2>Less uncertainty.<br />More possibility.</h2><p>
          Preview the enquiry journey, from an initial idea to a conversation
          about the details.
        </p>
      </div>
      <ol>
        {
          [
            {
              number: "01",
              photo: kenya,
              title: "Start with an idea",
              text: "Choose a sample journey or the kind of trip you have in mind.",
            },
            {
              number: "02",
              photo: zanzibar,
              title: "Shape the details",
              text: "Explore the dates, pace and preferences that matter to you.",
            },
            {
              number: "03",
              photo: kenya,
              title: "Make an informed choice",
              text: "In the live service, confirm the actual offer and terms with the agency.",
            },
          ].map((step) => (
            <li>
              <span>{step.number}</span>
              <div>
                <img
                  src={step.photo.sources.at(-1)!.src}
                  srcset={step.photo.sources
                    .map((source) => `${source.src} ${source.width}w`)
                    .join(", ")}
                  sizes="(max-width: 760px) 85vw, 28vw"
                  alt=""
                  width={step.photo.width}
                  height={step.photo.height}
                  loading="lazy"
                />
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section id="demo-about" class="demo-wrap demo-company">
    <h2>Travel planning from Ghana.</h2><p>
      Travel With Ease offers travel
      planning, travel packages and group trips.
    </p>
    <div>
      <h3>Personalised travel planning</h3><p>
        Start with your dates, destination ideas, budget and traveller count.
      </p><h3>Destination packages</h3><p>
        Enquire about a published package and tier. Sample demo packages are not
        available to book.
      </p><h3>Clear next steps</h3><p>
        Service scope, quotations and payment instructions are agreed directly
        with the team. There is no online checkout.
      </p>
    </div>
  </section>
  <section id="demo-journal" class="demo-wrap demo-journal" data-twe-reveal>
    <figure>
      <img
        src={journalPhoto.sources.at(-1)!.src}
        width={journalPhoto.width}
        height={journalPhoto.height}
        alt={journalPhoto.alt}
        loading="lazy"
      /><figcaption>Zanzibar · TWE-supplied photography</figcaption>
    </figure>
    <div>
      <small>Travel Journal · sample editorial</small><h2>
        The moments<br />between the plans.
      </h2><p>
        A quieter morning. A new view. A little time to notice where you are.
      </p><p>
        This sample introduces the journal layout. Approved stories will replace
        it before publication.
      </p><Accordion title="Read the sample story"
        ><p>
          A journey is more than a list of stops. This demonstration shows where
          an original, approved travel story will appear, with destination
          context, licensed images and useful information.
        </p></Accordion
      >
    </div>
  </section>
  <section id="demo-faqs" class="demo-wrap">
    <div class="demo-faq-introduction">
      <h2>A few things<br />to know.</h2>
      <p>Client testimonials will appear only after approval and permission.</p>
    </div>
    <div class="demo-faq-questions">
      <Accordion title="Can I book these sample journeys?"
        ><p>
          No. These demonstrate the website layout, not available offers.
        </p></Accordion
      ><Accordion title="Will this form contact the team?"
        ><p>
          {
            live
              ? "Yes. This staging demo saves test enquiries for authorised staff to review, without booking or sending a confirmation."
              : "No. The local preview does not send or save your choices."
          }
        </p></Accordion
      >
    </div>
  </section>
  <section id="demo-privacy" class="demo-wrap demo-policy-preview">
    <h2>Your privacy choices</h2><p>
      Try the cookie preference controls. Choices here apply to this demo only;
      analytics remains disabled. About, Services and policy drafts can be
      reviewed in the staff portal demo.
    </p><button type="button" data-cookie-settings
      >Manage demo preferences</button
    >
  </section>
  <ClosingCta demo />
</div>
<script>
  // Preserve a card choice made before the below-fold React form hydrates.
  document.addEventListener(
    "click",
    (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLElement>(
        "[data-demo-destination], [data-demo-personalised]",
      );
      if (!link) return;
      document.documentElement.dataset.demoEnquiryKind = link.hasAttribute(
        "data-demo-destination",
      )
        ? "package"
        : "personalised";
      if (link.dataset.demoDestination)
        document.documentElement.dataset.demoEnquiryDestination =
          link.dataset.demoDestination;
    },
    { capture: true },
  );
</script>
<style>
  @import "../styles/components/demo-website.css";
</style>
