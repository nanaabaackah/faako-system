<script>
  // Native adaptation of Fade Content / staggered Animated Content.
  // Astro content is visible before hydration and when scripting is unavailable.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const animations = new Set<Animation>();
  // The photograph stays full-bleed until its footer reaches the page end.
  // This only reads scroll geometry; it never intercepts scrolling or focus.
  const footer = document.querySelector<HTMLElement>(
    ".twe-public-footer--cinematic",
  );
  if (footer) {
    let frame = 0;
    const updateGutter = () => {
      frame = 0;
      const distance = Math.max(
        0,
        document.documentElement.scrollHeight - innerHeight - scrollY,
      );
      const progress = reduce.matches
        ? 0
        : Math.max(0, Math.min(1, 1 - distance / 180));
      footer.style.setProperty("--footer-progress", String(progress));
    };
    const scheduleGutter = () => {
      if (!frame) frame = requestAnimationFrame(updateGutter);
    };
    updateGutter();
    addEventListener("scroll", scheduleGutter, { passive: true });
    addEventListener("resize", scheduleGutter);
    reduce.addEventListener("change", scheduleGutter);
    const resize = new ResizeObserver(scheduleGutter);
    resize.observe(document.body);
    addEventListener(
      "pagehide",
      () => {
        removeEventListener("scroll", scheduleGutter);
        removeEventListener("resize", scheduleGutter);
        reduce.removeEventListener("change", scheduleGutter);
        resize.disconnect();
        cancelAnimationFrame(frame);
      },
      { once: true },
    );
  }
  if ("IntersectionObserver" in window && !reduce.matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);
            if (reduce.matches) continue;
            const target = entry.target as HTMLElement;
            const animation = target.animate(
              [
                { opacity: 0.35, transform: "translateY(12px)" },
                { opacity: 1, transform: "none" },
              ],
              {
                duration: 420,
                delay: Math.min(160, Number(target.dataset.stagger || 0) * 80),
                easing: "ease-out",
              },
            );
            animations.add(animation);
            animation.finished
              .catch(() => {})
              .finally(() => animations.delete(animation));
          }
      },
      { threshold: 0.15 },
    );
    document
      .querySelectorAll("[data-twe-reveal]")
      .forEach((target) => observer.observe(target));
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        observer.disconnect();
        animations.forEach((animation) => animation.cancel());
      }
    });
    window.addEventListener(
      "pagehide",
      () => {
        observer.disconnect();
        animations.forEach((animation) => animation.cancel());
      },
      { once: true },
    );
  }
</script>
