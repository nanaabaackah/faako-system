<script>
  // Native adaptation of Fade Content / staggered Animated Content.
  // Astro content is visible before hydration and when scripting is unavailable.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  const animations = new Set<Animation>();
  // The photograph stays full-bleed until its footer reaches the page end.
  // This only reads scroll geometry; it never intercepts scrolling or focus.
  const footer = document.querySelector<HTMLElement>(
    ".twe-public-footer--cinematic",
  );
  if (footer) {
    let frame = 0;
    const updateGutter = () => {
      frame = 0;
      const distance = Math.max(
        0,
        document.documentElement.scrollHeight - innerHeight - scrollY,
      );
      const progress = reduce.matches
        ? 0
        : Math.max(0, Math.min(1, 1 - distance / 180));
      footer.style.setProperty("--footer-progress", String(progress));
    };
    const scheduleGutter = () => {
      if (!frame) frame = requestAnimationFrame(updateGutter);
    };
    updateGutter();
    addEventListener("scroll", scheduleGutter, { passive: true });
    addEventListener("resize", scheduleGutter);
    reduce.addEventListener("change", scheduleGutter);
    const resize = new ResizeObserver(scheduleGutter);
    resize.observe(document.body);
    addEventListener(
      "pagehide",
      () => {
        removeEventListener("scroll", scheduleGutter);
        removeEventListener("resize", scheduleGutter);
        reduce.removeEventListener("change", scheduleGutter);
        resize.disconnect();
        cancelAnimationFrame(frame);
      },
      { once: true },
    );
  }
  if ("IntersectionObserver" in window && !reduce.matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);
            if (reduce.matches) continue;
            const target = entry.target as HTMLElement;
            const animation = target.animate(
              [
                { opacity: 0.35, transform: "translateY(12px)" },
                { opacity: 1, transform: "none" },
              ],
              {
                duration: 420,
                delay: Math.min(160, Number(target.dataset.stagger || 0) * 80),
                easing: "ease-out",
              },
            );
            animations.add(animation);
            animation.finished
              .catch(() => {})
              .finally(() => animations.delete(animation));
          }
      },
      { threshold: 0.15 },
    );
    document
      .querySelectorAll("[data-twe-reveal]")
      .forEach((target) => observer.observe(target));
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        observer.disconnect();
        animations.forEach((animation) => animation.cancel());
      }
    });
    window.addEventListener(
      "pagehide",
      () => {
        observer.disconnect();
        animations.forEach((animation) => animation.cancel());
      },
      { once: true },
    );
  }

  // Reuse only the package-ticket pointer tilt on the site's other card
  // surfaces. Their existing colours, borders, shadows and layout stay intact.
  const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
  const tiltCards = [
    ...document.querySelectorAll<HTMLElement>(
      ".twe-action-card, .service-panel, .journey-card, .estimate-card, .traveller-reviews__card, .gallery-panel, .cinematic-enquiry__card, .enquiry-wizard-page__card, .package-enquiry-panel",
    ),
  ].filter((card) => !card.closest(".tilted-card"));
  const tiltCleanups = tiltCards.map((card) => {
    let frame = 0;
    const reset = () => {
      cancelAnimationFrame(frame);
      card.style.removeProperty("--twe-card-tilt-x");
      card.style.removeProperty("--twe-card-tilt-y");
      card.removeAttribute("data-twe-card-tilting");
    };
    const move = (event: PointerEvent) => {
      if (reduce.matches || !finePointer.matches) return reset();
      const bounds = card.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
      const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        card.style.setProperty("--twe-card-tilt-x", `${(-y * 4).toFixed(2)}deg`);
        card.style.setProperty("--twe-card-tilt-y", `${(x * 4).toFixed(2)}deg`);
        card.setAttribute("data-twe-card-tilting", "");
      });
    };
    card.classList.add("twe-card-tilt");
    card.addEventListener("pointermove", move);
    card.addEventListener("pointerleave", reset);
    card.addEventListener("pointercancel", reset);
    return () => {
      reset();
      card.removeEventListener("pointermove", move);
      card.removeEventListener("pointerleave", reset);
      card.removeEventListener("pointercancel", reset);
    };
  });
  addEventListener("pagehide", () => tiltCleanups.forEach((cleanup) => cleanup()), { once: true });
</script>
