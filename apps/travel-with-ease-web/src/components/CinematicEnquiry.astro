---
import PublicFooter from "./PublicFooter.astro";
import EnquiryForm from "./EnquiryForm.jsx";
import photography from "../lib/assigned-photography.json";
import "../styles/components/cinematic-enquiry.css";
const { demo = false } = Astro.props;
// One continuous image covers the enquiry and transparent footer together.
// Contact-page CMS imagery remains independent from footer art direction.
const photo = photography.footer;
---

<div class="closing-scene">
  <picture>
    <!-- Height-driven cover needs a tall, high-resolution source, not a 100vw thumbnail. -->
    <source
      media="(max-width: 760px)"
      srcset="/media/zanzibar-beach-club-b60ec1e6297a-1920.webp"
      width="1920"
      height="3413"
    />
  <img
    class="closing-scene__image"
    src={photo.src}
    srcset={photo.sources
      .map((source) => `${source.src} ${source.width}w`)
      .join(", ")}
    sizes="100vw"
    alt=""
    width={photo.width}
    height={photo.height}
    loading="lazy"
    decoding="async"
  />
  </picture>
  <section
    id={demo ? "demo-plan" : "plan"}
    class="cinematic-enquiry"
    aria-labelledby="enquiry-heading"
  >
    <div class="cinematic-enquiry__scene">
      <div
        class:list={[
          "cinematic-enquiry__card",
          { "cinematic-enquiry__card--with-form": !demo || Astro.slots.has("default") },
        ]}
        id={demo ? "demo-enquiry-form" : undefined}
      >
        <div class="cinematic-enquiry__copy">
          <h2 id="enquiry-heading">Where would you<br />like to go?</h2>
          <p>
            {
              demo
                ? "Explore the enquiry experience. Sample journeys are not available to book."
                : "Start a conversation about your next journey."
            }
          </p>
          <slot name="intro" />
        </div>
        {
          !demo && (
            <div class="cinematic-enquiry__form">
              <EnquiryForm client:load />
            </div>
          )
        }
        {
          Astro.slots.has("default") && (
            <div class="cinematic-enquiry__form">
              <slot />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <PublicFooter demo={demo} cinematic />
</div>
