---
import RichText from "./RichText.astro";
import PublicFooter from "./PublicFooter.astro";
import EnquiryForm from "./EnquiryForm.jsx";
import photography from "../lib/assigned-photography.json";
import { publishedPage } from '../lib/published.js';
import { siteCopy } from "../lib/editorial-copy.js";
import PlacedImage from './PlacedImage.astro';
import "../styles/components/cinematic-enquiry.css";
// One continuous image covers the enquiry and transparent footer together.
// Contact-page CMS imagery remains independent from footer art direction.
const photo = photography.footer;
const selected=publishedPage('footer')?.imagePlacements?.['footer-background'] || publishedPage('site-appearance')?.imagePlacements?.['footer-background'];
const placement={focalY:60,mobileFocalY:50,mobileImage:!selected?.image&&!selected?.mobileImage?{src:'/media/zanzibar-beach-club-b60ec1e6297a-1920.webp',width:1920,height:3413,alt:''}:null,...selected};
const contactCopy = siteCopy("contact");
const sharedCopy = siteCopy("site-appearance");
const catalogue = Astro.props.catalogue || { services: [], packages: [] };
const enquiryAvailable = Astro.props.enquiryAvailable !== false;
---

<div class="closing-scene">
  <PlacedImage image={photo} placement={placement} decorative
    class="closing-scene__image"
    sizes="100vw"
  />
  <section
    id="plan"
    class="cinematic-enquiry"
    aria-labelledby="enquiry-heading"
  >
    <div class="cinematic-enquiry__scene">
      <div
        class:list={[
          "cinematic-enquiry__card",
          "cinematic-enquiry__card--with-form",
        ]}
      >
        <div class="cinematic-enquiry__copy">
          <h2 id="enquiry-heading">{contactCopy.enquiryHeading === "Where would you like to go?" ? <>Where would you<br />like to go?</> : contactCopy.enquiryHeading}</h2>
          <RichText value={contactCopy.enquiryBody}/>
          <slot name="intro" />
        </div>
        {
          enquiryAvailable ? (
            <div class="cinematic-enquiry__form">
              <EnquiryForm client:visible={{ rootMargin: "600px" }} catalogue={catalogue} copy={{submitLabel:contactCopy.enquiryCta,whatsappLabel:contactCopy.whatsappCta,whatsappUrl:sharedCopy.whatsappUrl}} />
            </div>
          ) : (
            <div class="cinematic-enquiry__form"><a href={sharedCopy.whatsappUrl} rel="noreferrer">{contactCopy.whatsappCta}</a></div>
          )
        }
        {
          Astro.slots.has("default") && (
            <div class="cinematic-enquiry__form">
              <slot />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <PublicFooter cinematic />
</div>
