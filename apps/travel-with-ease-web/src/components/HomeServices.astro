---
import ContentLink from "./ContentLink.astro";
import MoneyText from "./MoneyText.astro";
import CurrencyAttribution from "./CurrencyAttribution.astro";
import EditorialPhoto from "./EditorialPhoto.astro";
import photography from "../lib/journey-photography.json";
import { serviceSlug } from "../lib/services.js";
import type { ImagePlacement } from "../lib/collections";
import "../styles/components/home-features.css";
import "../styles/components/home-services.css";

interface ServiceEntry {
  heading: string;
  text: string;
  imagePlacement?: ImagePlacement;
}
interface Props {
  heading: string;
  body: string;
  entries: ServiceEntry[];
}
const { heading, body, entries } = Astro.props;
---

<section id="services" class="home-services editorial-wrap" aria-labelledby="home-services-heading">
  <div class="home-section-heading">
    <div>
      <h2 id="home-services-heading">{heading}</h2>
      <p>{body}</p>
    </div>
    <ContentLink href="/services">Explore all services</ContentLink>
  </div>
  <div class="home-services__layout">
    <EditorialPhoto
      image={photography.garden}
      placement={entries[0]?.imagePlacement}
      class="home-services__photo"
      sizes="(max-width: 760px) 90vw, 40vw"
    />
    <ol class="home-services__list">
      {entries.map(entry => {
        const [title, ...priceParts] = entry.heading.split(" · ");
        const price = priceParts.join(" · ");
        const summary = entry.text.split(/(?<=[.!?])\s+/)[0];
        return (
          <li class="home-services__item home-services__row">
            <div class="home-services__row-heading">
              <h3><ContentLink href={`/services/${serviceSlug(entry.heading)}`}>{title}</ContentLink></h3>
              {price && <p class="home-services__fee"><MoneyText text={price} /></p>}
            </div>
            <p class="home-services__summary"><MoneyText text={summary} /></p>
          </li>
        );
      })}
    </ol>
  </div>
  <CurrencyAttribution />
</section>
