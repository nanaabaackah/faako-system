---
import RichText from "./RichText.astro";
import ContentLink from "./ContentLink.astro";
import { siteCopy } from "../lib/editorial-copy.js";
import TopographyBackground from "./TopographyBackground.jsx";
import AnimatedContent from "./react-bits/AnimatedContent.jsx";
const copy = siteCopy("home");
const { variant = "midnight" } = Astro.props;
const topographyColor = variant === "midnight" ? "#D8B56A" : "#15234B";
---

<scroll-expand-cta class:list={["closing-expand", `closing-expand--${variant}`]} data-closing-expand>
  <div class="closing-expand__track">
    <section class:list={["closing-cta", `closing-cta--${variant}`]} aria-labelledby="closing-cta-heading">
      <div class="closing-topography-fallback" aria-hidden="true"></div>
      <div class="closing-topography-canvas" aria-hidden="true">
        <TopographyBackground client:visible color={topographyColor} />
      </div>
      <div class="closing-topography-fade" aria-hidden="true"></div>
      <AnimatedContent client:visible className="closing-copy-motion" distance={24} duration={0.9} ease="power3.out" blur={4} stagger={0.08} threshold={0.16}>
        <div class="closing-copy">
          <h2 class="closing-copy__heading" id="closing-cta-heading">{copy.closingHeading}</h2>
          <RichText class="closing-copy__body" value={copy.closingBody}/>
          <ContentLink
            button
            href="#plan"
            >{copy.closingCta}</ContentLink
          >
        </div>
      </AnimatedContent>
    </section>
  </div>
</scroll-expand-cta>
<style>
  @import "../styles/components/closing-cta.css";
</style>

<script>
  const clampClosingProgress = (value: number) => Math.min(1, Math.max(0, value));
  const smoothClosingProgress = (value: number) => value * value * (3 - 2 * value);

  class ScrollExpandCta extends HTMLElement {
    cleanup?: () => void;

    connectedCallback() {
      if (this.dataset.ready) return;
      const track = this.querySelector<HTMLElement>(".closing-expand__track");
      const stage = this.querySelector<HTMLElement>(".closing-cta");
      if (!track || !stage) return;

      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let reduceMotion = motion.matches;
      let height = 0;
      let frame = 0;
      let active = true;

      const apply = (rawProgress: number) => {
        const progress = smoothClosingProgress(rawProgress);
        const compact = window.innerWidth < 700;
        const startWidth = compact ? 88 : 62;
        const startHeight = compact ? 72 : 68;
        const width = startWidth + (100 - startWidth) * progress;
        const frameHeight = startHeight + (100 - startHeight) * progress;
        stage.style.clipPath = `inset(${(100 - frameHeight) / 2}% ${(100 - width) / 2}% round ${24 * (1 - progress)}px)`;
      };

      const update = () => {
        if (!active || reduceMotion || frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const progress = this.contains(document.activeElement)
            ? 1
            : clampClosingProgress(-track.getBoundingClientRect().top / Math.max(height * 0.9, 1));
          apply(progress);
        });
      };

      const measure = () => {
        reduceMotion = motion.matches;
        height = Math.max(420, Math.min(620, window.innerHeight * 0.72));
        stage.style.height = `${height}px`;
        track.style.height = reduceMotion ? `${height}px` : `${height * 1.9}px`;
        if (reduceMotion) apply(1);
        else update();
      };

      let observer: IntersectionObserver | null = null;
      if ("IntersectionObserver" in window) {
        observer = new IntersectionObserver(([entry]) => {
          active = entry.isIntersecting;
          this.toggleAttribute("data-motion-active", active && !reduceMotion);
          if (active) update();
        }, { rootMargin: "100px" });
        observer.observe(this);
      }

      const motionChanged = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        measure();
      };
      const revealForFocus = () => apply(1);
      this.dataset.ready = "true";
      measure();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", measure, { passive: true });
      motion.addEventListener("change", motionChanged);
      this.addEventListener("focusin", revealForFocus);
      this.addEventListener("focusout", update);

      this.cleanup = () => {
        observer?.disconnect();
        cancelAnimationFrame(frame);
        window.removeEventListener("scroll", update);
        window.removeEventListener("resize", measure);
        motion.removeEventListener("change", motionChanged);
        this.removeEventListener("focusin", revealForFocus);
        this.removeEventListener("focusout", update);
        delete this.dataset.ready;
      };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get("scroll-expand-cta")) {
    customElements.define("scroll-expand-cta", ScrollExpandCta);
  }
</script>
