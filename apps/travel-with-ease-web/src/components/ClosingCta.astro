---
import ContentLink from "./ContentLink.astro";
import photos from "../lib/approved-preview-media.json";
import "../styles/components/closing-cta.css";
const { demo = false, enquiryAvailable = false } = Astro.props;
// Original approved TWE photographs, not Flighty's devices or screenshots.
const scenes = [photos[0], photos[1], photos[0]];
---

<section class="closing-cta" aria-labelledby="closing-cta-heading">
  <div class="closing-copy">
    <h2 id="closing-cta-heading">Make room for<br />your next journey.</h2>
    <p>
      {
        demo
          ? "Explore a sample trip, then try the enquiry experience. Sample offers cannot be booked."
          : "A little further. A little more you. Start with an idea for your next trip."
      }
    </p>
    <ContentLink
      button
      href={demo ? "#demo-plan" : enquiryAvailable ? "/contact" : "#plan"}
      data-demo-personalised={demo ? "" : undefined}
      >{demo ? "Try a personalised enquiry" : "Plan your trip"}</ContentLink
    >
  </div>
  <div class="closing-photos" aria-hidden="true">
    {
      scenes.map((photo, index) => (
        <div
          class={`closing-photo closing-photo--${index + 1}`}
          data-twe-reveal
          data-stagger={index}
        >
          <img
            src={photo.sources.at(-1)!.src}
            srcset={photo.sources
              .map((source) => `${source.src} ${source.width}w`)
              .join(", ")}
            sizes="(max-width: 600px) 62vw, 38vw"
            alt=""
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))
    }
  </div>
</section>
