---
import { moneySegments } from "../lib/currency-display.js";
interface Props { text: string | null; }
const { text } = Astro.props;
---
{moneySegments(text).map(segment => segment.minor ? <span class="twe-money" data-twe-money={segment.minor} data-ghs-label={segment.displayText}><span data-money-value>{segment.displayText}</span><small data-money-original hidden> ({segment.displayText})</small></span> : segment.text)}
