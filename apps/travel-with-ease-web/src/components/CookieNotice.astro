<aside class="cookie-notice" data-cookie-notice hidden aria-label="Cookie notice" aria-live="polite">
  <div>
    <strong>Your privacy, your choice.</strong>
    <p>
      Essential browser storage remembers your preference. Optional Google Analytics
      helps us understand visits only when you allow it; advertising cookies are not used.
    </p>
  </div>
  <div class="cookie-notice__actions">
    <button class="secondary" type="button" data-cookie-essential>Essential only</button>
    <button type="button" data-cookie-analytics>Allow analytics</button>
  </div>
</aside>

<script is:inline>
  (() => {
    const key = "twe-cookie-consent-v1";
    const notice = document.querySelector("[data-cookie-notice]");
    if (!notice) return;

    const show = () => notice.removeAttribute("hidden");
    const hide = () => notice.setAttribute("hidden", "");
    const hasValidChoice = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(key) || "null");
        return saved?.essential === true && typeof saved.analytics === "boolean";
      } catch {
        return false;
      }
    };

    if (!hasValidChoice()) show();

    const save = (analytics) => {
      const choice = { essential: true, analytics, updatedAt: new Date().toISOString() };
      try { localStorage.setItem(key, JSON.stringify(choice)); } catch {}
      document.dispatchEvent(new CustomEvent("twe:consent-changed", { detail: choice }));
      hide();
    };

    notice.querySelector("[data-cookie-essential]")?.addEventListener("click", () => save(false));
    notice.querySelector("[data-cookie-analytics]")?.addEventListener("click", () => save(true));
    document.querySelectorAll("[data-cookie-settings]").forEach((button) => {
      button.addEventListener("click", () => {
        show();
        notice.querySelector("[data-cookie-essential]")?.focus();
      });
    });
  })();
</script>

<style>
  .cookie-notice { position: fixed; z-index: 100; right: 1rem; bottom: 1rem; left: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; max-width: 72rem; margin: auto; padding: 1.2rem; border: 1px solid rgba(216, 181, 106, .5); border-radius: 1rem; color: white; background: #010c33; box-shadow: 0 20px 60px rgba(0, 10, 31, .35); }
  .cookie-notice[hidden] { display: none; }
  .cookie-notice strong { color: #d8b56a; }
  .cookie-notice p { max-width: 48rem; margin: .25rem 0 0; color: #d6d9e5; font-size: .9rem; }
  .cookie-notice__actions { display: flex; flex-shrink: 0; gap: .65rem; }
  .cookie-notice__actions .secondary { border: 1px solid #d8b56a; color: #d8b56a; background: transparent; }
  @media (max-width: 760px) { .cookie-notice { align-items: stretch; flex-direction: column; } .cookie-notice__actions { flex-wrap: wrap; } }
</style>
