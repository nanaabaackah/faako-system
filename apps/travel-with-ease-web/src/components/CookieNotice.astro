---
import { publishedPage, publicationSnapshotPath } from "../lib/published.js";
const { demo = false } = Astro.props;
const privacyAvailable =
  demo || !publicationSnapshotPath() || Boolean(publishedPage("privacy"));
---

<dialog
  class="cookie-notice cookie-preferences-dialog"
  data-cookie-notice
  data-cookie-storage={demo
    ? "twe-demo-cookie-consent-v1"
    : "twe-cookie-consent-v1"}
  aria-labelledby="cookie-preferences-title"
  aria-describedby="cookie-purpose"
>
  <h2 id="cookie-preferences-title">Cookie preferences</h2>
  <p class="cookie-notice__introduction">Your privacy, your choice.</p>
  {
    demo && (
      <p>
        Demo preferences only. No analytics or advertising tracking runs in this
        demo.
      </p>
    )
  }
  <p id="cookie-purpose">
    Essential browser storage remembers your preference. Advertising cookies are
    not used.
    {
      privacyAvailable && !demo && (
        <>
          {" "}
          Optional Google Analytics helps us understand visits only when you
          allow it. <a href="/privacy">Privacy information</a>
        </>
      )
    }
  </p>
  <div class="cookie-notice__actions">
    <button class="secondary" type="button" data-cookie-essential autofocus
      >Essential only</button
    >
    {
      privacyAvailable && (
        <button type="button" data-cookie-analytics>
          Allow analytics
        </button>
      )
    }
    <button
      class="secondary"
      type="button"
      data-cookie-manage
      aria-expanded="false"
      aria-controls="cookie-preferences">Manage preferences</button
    >
  </div>
  <section
    id="cookie-preferences"
    data-cookie-preferences
    hidden
    aria-label="Optional cookie preferences"
  >
    <p>
      Essential storage supports security and remembers your choice. It is
      always enabled.
    </p>
    <label><input type="checkbox" checked disabled /> Essential</label>
    <label
      ><input
        type="checkbox"
        data-cookie-analytics-choice
        disabled={!privacyAvailable}
      /> Optional analytics</label
    >
    <p>
      You can change or withdraw this choice at any time using Cookie settings
      in the footer.
    </p>
    <button type="button" data-cookie-save>Save preferences</button>
  </section>
  <button class="cookie-notice__close secondary" type="button" data-cookie-close
    >Close without saving</button
  >
</dialog>

<script is:inline>
  (() => {
    const notice = document.querySelector("[data-cookie-notice]");
    if (!(notice instanceof HTMLDialogElement)) return;
    const key = notice.getAttribute("data-cookie-storage");
    const preferences = notice.querySelector("[data-cookie-preferences]");
    const manage = notice.querySelector("[data-cookie-manage]");
    const choiceInput = notice.querySelector("[data-cookie-analytics-choice]");
    let returnFocus = null;
    const savedChoice = () => {
      try {
        const choice = JSON.parse(localStorage.getItem(key) || "null");
        return choice?.essential === true &&
          typeof choice.analytics === "boolean"
          ? choice
          : null;
      } catch {
        return null;
      }
    };
    const show = () => {
      if (!notice.open) notice.showModal();
    };
    const showPreferences = () => {
      choiceInput.checked =
        savedChoice()?.analytics === true && !choiceInput.disabled;
      preferences.hidden = false;
      manage.setAttribute("aria-expanded", "true");
    };
    const save = (analytics) => {
      const choice = {
        essential: true,
        analytics,
        updatedAt: new Date().toISOString(),
      };
      try {
        localStorage.setItem(key, JSON.stringify(choice));
      } catch {}
      document.dispatchEvent(
        new CustomEvent("twe:consent-changed", { detail: choice }),
      );
      notice.close();
    };
    manage.addEventListener("click", showPreferences);
    notice
      .querySelector("[data-cookie-essential]")
      .addEventListener("click", () => save(false));
    notice
      .querySelector("[data-cookie-analytics]")
      ?.addEventListener("click", () => save(true));
    notice
      .querySelector("[data-cookie-save]")
      .addEventListener("click", () =>
        save(choiceInput.checked && !choiceInput.disabled),
      );
    notice
      .querySelector("[data-cookie-close]")
      .addEventListener("click", () => notice.close());
    notice.addEventListener("close", () => {
      preferences.hidden = true;
      manage.setAttribute("aria-expanded", "false");
      if (returnFocus instanceof HTMLElement && returnFocus.isConnected)
        returnFocus.focus();
      returnFocus = null;
    });
    document.querySelectorAll("[data-cookie-settings]").forEach((button) => {
      button.addEventListener("click", () => {
        returnFocus = button;
        showPreferences();
        show();
      });
    });
    // First visit is the same native popup, not an in-page or bottom banner.
    // Escape/Close never implies consent; absent consent keeps analytics disabled.
    if (!savedChoice()) show();
  })();
</script>
<style>
  @import "../styles/components/cookie-notice.css";
</style>
