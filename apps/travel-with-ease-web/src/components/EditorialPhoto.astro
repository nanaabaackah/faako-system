---
import type { PublicImage } from "../lib/collections";
interface Props {
  image: PublicImage;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { image, class: className, sizes = "(max-width: 760px) 100vw, 50vw", eager = false } = Astro.props;
---

<img
  class={className}
  src={image.src}
  srcset={image.sources?.map(source => `${source.src} ${source.width}w`).join(", ")}
  sizes={sizes}
  width={image.width}
  height={image.height}
  alt={image.alt}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
/>
