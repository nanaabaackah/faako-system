---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublishedContent from "../components/PublishedContent.astro";
import { publishedPage } from "../lib/published.js";
const published = publishedPage("services");
---
{published !== undefined ? <BaseLayout title={published?.seoTitle || "Content unavailable | Travel With Ease"} description={published?.seoDescription || "This page is not currently published."} noIndex={!published}><PublishedContent content={published} /></BaseLayout> : <>
<BaseLayout title="Travel planning services | Travel With Ease" description="Personal itineraries, group trips and end-to-end international travel support from Ghana."><section class="page-hero"><span class="eyebrow">Our services</span><h1>Every detail, moving in the same direction.</h1></section><section class="destination-grid"><article><span>01</span><h2>Personal journeys</h2><p>Flights, stays, transport and experiences shaped around your pace and priorities.</p></article><article><span>02</span><h2>Couples & families</h2><p>Practical plans that account for the whole group without losing the magic.</p></article><article><span>03</span><h2>Group travel</h2><p>A shared journey with one clear source of truth for dates, payments and updates.</p></article></section></BaseLayout></>}
