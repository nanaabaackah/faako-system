---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentLink from "../components/ContentLink.astro";
---

<!-- Cloudflare returns a permanent redirect; keep a no-JavaScript local fallback. -->
<BaseLayout title="Packages | Travel With Ease" description="Explore our travel packages." path="/packages" noIndex>
  <section class="editorial-wrap">
    <h1>Our packages have a new home</h1>
    <ContentLink button href="/packages">Explore packages</ContentLink>
  </section>
</BaseLayout>
