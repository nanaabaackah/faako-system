---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PackageListing from "../../../components/PackageListing.astro";
import {
  demoPackages,
  demoCollectionRequest,
} from "../../../lib/demo-collections.js";
if (!demoCollectionRequest(Astro.url)) return Astro.redirect("/");
