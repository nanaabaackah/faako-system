---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import JournalArticle from "../../../components/JournalArticle.astro";
import type { JournalArticle as Item } from "../../../lib/collections";
import {
  demoPackages,
  demoArticles,
  demoCollectionsEnabled,
  demoCollectionRequest,
} from "../../../lib/demo-collections.js";
interface Props {
  item: Item;
}
export function getStaticPaths() {
  return (demoCollectionsEnabled() ? demoArticles : []).map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
if (!demoCollectionRequest(Astro.url)) return Astro.redirect("/");
const { item } = Astro.props;
---

<BaseLayout demo title={`${item.title} | Travel With Ease demo`} noIndex>
  <JournalArticle
    item={item}
    demo
    prefix="/demo/journal"
    related={demoArticles
      .filter((other) => other.slug !== item.slug)
      .slice(0, 3)}
    packages={demoPackages.filter((other) =>
      item.relatedPackageSlugs?.includes(other.slug),
    )}
    packagePrefix="/demo/packages"
  />
</BaseLayout>
