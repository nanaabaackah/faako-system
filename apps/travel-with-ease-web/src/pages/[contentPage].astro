---
import TravelFootprint from "../components/TravelFootprint.astro";
import ContentLink from "../components/ContentLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublishedContent from "../components/PublishedContent.astro";
import { publishedPage } from "../lib/published.js";
import "../styles/components/published-content.css";
export function getStaticPaths() {
  return [
    "faqs",
    "testimonials",
    "contact",
    "journal",
    "travel-footprint",
    "privacy",
    "terms",
    "cookies",
    "how-it-works",
  ].map((contentPage) => ({ params: { contentPage } }));
}
const content = publishedPage(Astro.params.contentPage);
const labels = {
  faqs: "Frequently asked questions",
  testimonials: "Traveller stories",
  contact: "Plan a trip",
  journal: "Travel Journal",
  "travel-footprint": "Travel footprint",
  privacy: "Privacy policy",
  terms: "Terms and booking information",
  cookies: "Cookie policy",
  "how-it-works": "How it works",
};
const label = labels[Astro.params.contentPage as keyof typeof labels];
---

<BaseLayout
  title={content?.seoTitle || "Content unavailable | Travel With Ease"}
  description={content?.seoDescription ||
    "This page is not currently published."}
  noIndex={!content}
>
  {
    content === undefined ? (
      <section class="editorial-wrap">
        <>
          <h1>{label}</h1>
          <div class="review-empty">
            <>
              <p>
                Placeholder for review — approved content is not available yet.
              </p>
              <p>
                {Astro.params.contentPage === "contact"
                  ? "Personalised and package enquiry forms will appear here when connected. This preview does not submit enquiries or collect your details."
                  : Astro.params.contentPage === "travel-footprint"
                    ? "No approved activity data is available. No trip totals or geographic claims are displayed."
                    : "This page is not a published policy, offer or business claim."}
              </p>
            </>
          </div>
          <ContentLink href="/">Back to home</ContentLink>
        </>
      </section>
    ) : (
      <PublishedContent
        content={content}
        accordion={Astro.params.contentPage === "faqs"}
      />
    )
  }
  {
    Astro.params.contentPage === "travel-footprint" && (
      <section class="editorial-wrap footprint-full-width">
        <TravelFootprint />
      </section>
    )
  }
  {
    Astro.params.contentPage === "journal" && content && (
      <section
        class="journal-list editorial-wrap"
        aria-label="Published journal articles"
      >
        {(content.articles || []).length ? (
          content.articles.map(
            (article: {
              slug: string;
              title: string;
              excerpt: string;
              date: string;
            }) => (
              <article class="twe-action-card">
                <time datetime={article.date}>{article.date}</time>
                <h2>
                  <ContentLink href={`/journal/${article.slug}`}>
                    {article.title}
                  </ContentLink>
                </h2>
                <p>{article.excerpt}</p>
              </article>
            ),
          )
        ) : (
          <p>
            Our travel journal will appear here when articles are published.
          </p>
        )}
      </section>
    )
  }
</BaseLayout>
