---
import PlacedImage from '../../components/PlacedImage.astro';
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentLink from "../../components/ContentLink.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { publishedPage } from "../../lib/published.js";
import "../../styles/components/published-content.css";
import "../../styles/components/travel-tips.css";
interface Props {
  tip: {
    slug: string;
    title: string;
    excerpt: string;
    body: string;
    category: string;
    relatedArticle?: string;
    imagePlacement?: import('../../lib/collections').ImagePlacement;
  image?: {
      src: string;
      alt: string;
      width: number;
      height: number;
      sources?: { src: string; width: number }[];
    } | null;
  };
}
export function getStaticPaths() {
  return (publishedPage("travel-tips")?.tips || []).map(
    (tip: { slug: string }) => ({ params: { slug: tip.slug }, props: { tip } }),
  );
}
const { tip } = Astro.props;
const related = tip.relatedArticle
  ? publishedPage(`journal/${tip.relatedArticle}`)
  : null;
---

<BaseLayout
  title={`${tip.title} | Travel With Ease`}
  description={tip.excerpt}
  type="article"
>
  <article class="published-content">
    <Breadcrumbs collection="Travel Tips" href="/travel-tips" title={tip.title} />
    <p>{tip.category}</p><h1>{tip.title}</h1>
    {
      tip.image && (
        <PlacedImage image={tip.image} placement={tip.imagePlacement}
          src={tip.image.src}
          srcset={tip.image.sources
            ?.map(
              (source: { src: string; width: number }) =>
                `${source.src} ${source.width}w`,
            )
            .join(", ")}
          sizes="(max-width: 760px) 90vw, 1200px"
          width={tip.image.width}
          height={tip.image.height}
          alt={tip.image.alt}
        />
      )
    }
    <p class="journal-excerpt">{tip.excerpt}</p>
    <div class="travel-tip-body">
      {tip.body.split(/\n\s*\n/).map((paragraph: string) => <p>{paragraph}</p>)}
    </div>
    {
      related && (
        <aside>
          <>
            <h2>Keep reading</h2>
            <ContentLink href={`/journal/${related.slug}`}>
              {related.title}
            </ContentLink>
          </>
        </aside>
      )
    }
  </article>
</BaseLayout>
