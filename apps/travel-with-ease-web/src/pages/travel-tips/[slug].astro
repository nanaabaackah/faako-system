---
import { publishedPage } from "../../lib/published.js";
import type { JournalArticle } from "../../lib/collections";
// Keep older saved /travel-tips/<slug> links for approved Journal Travel tips.
export function getStaticPaths() {
  const tips = (publishedPage("journal")?.articles || [])
    .filter((article: JournalArticle) => article.category === "Travel tip");
  return tips.map((tip: JournalArticle) => ({
    params: { slug: tip.slug },
  }));
}
return Astro.redirect(`/journal/${Astro.params.slug}`, 301);
---
