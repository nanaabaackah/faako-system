---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JournalArticle from "../../components/JournalArticle.astro";
import type {
  JournalArticle as Article,
  TravelPackage,
} from "../../lib/collections";
import { publishedPage } from "../../lib/published.js";
interface Props {
  item: Article;
}
export function getStaticPaths() {
  const items =
    publishedPage("journal")?.articles || [];
  return items.map((item: Article) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
const { item } = Astro.props;
const articles =
  publishedPage("journal")?.articles || [];
const packages =
  publishedPage("packages")?.packages || [];
---

<BaseLayout
  title={`${item.title} | Travel With Ease`}
  description={item.excerpt}
  type="article"
>
  <JournalArticle
    item={item}
    related={articles
      .filter(
        (other: Article) =>
          other.slug !== item.slug && other.category === item.category,
      )
      .slice(0, 3)}
    packages={packages.filter((pkg: TravelPackage) =>
      item.relatedPackageSlugs?.includes(pkg.slug),
    )}
  />
</BaseLayout>
