---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryWizard from "../components/EnquiryWizard.jsx";
import PublicFooter from "../components/PublicFooter.astro";
import "../styles/components/enquiry-wizard-page.css";
---

<BaseLayout
  title="Complete your trip details | Travel With Ease"
  description="Add the details Travel With Ease needs to plan your journey."
  path="/plan-your-trip"
  noIndex
  planningHref="/#plan"
>
  <section class="enquiry-wizard-page" aria-labelledby="questionnaire-heading">
    <div class="enquiry-wizard-page__intro">
      <h1 id="questionnaire-heading">Tell us more about your trip</h1>
      <p>These details help us prepare a more useful response.</p>
    </div>
    <div class="enquiry-wizard-page__card">
      <EnquiryWizard client:load />
    </div>
  </section>
  <Fragment slot="closing"><PublicFooter /></Fragment>
</BaseLayout>
