---
import "../styles/global.css";
import "../styles/editorial.css";
import "../styles/typography.css";
import "../styles/components/public-controls.css";
import "../styles/components/scroll-navigation.css";
import "../styles/components/content-surfaces.css";
import CinematicEnquiry from "../components/CinematicEnquiry.astro";
import ContentLink from "../components/ContentLink.astro";
import EditorialMotion from "../components/EditorialMotion.astro";
import { canonicalUrl, serializeJsonLd } from "@faako/discovery";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import CookieNotice from "../components/CookieNotice.astro";
import FloatingActions from "../components/FloatingActions.astro";
import { sharingMetadata } from "../lib/sharing.js";
import { publishedPage } from "../lib/published.js";

const {
  title,
  description,
  path = Astro.url.pathname,
  type = "website",
  noIndex = false,
} = Astro.props;
const cinematic = Astro.props.cinematic === true;
const site = Astro.site || new URL("https://travelwithease.example");
const canonical = canonicalUrl(path, site);
const pageContent = publishedPage(path.replace(/^\/|\/$/g, "") || "home");
const sharing = sharingMetadata({
  site: site.href,
  image:
    Astro.props.image || pageContent?.socialImage?.src || "/og/default.jpg",
  imageAlt:
    Astro.props.imageAlt ||
    pageContent?.socialImage?.alt ||
    "Travel With Ease — your guide to stress-free travel",
  type,
});
const approvedForIndexing =
  import.meta.env.PUBLIC_APP_ENV === "production" &&
  import.meta.env.PUBLIC_SITE_INDEXABLE === "true" &&
  site.hostname !== "travelwithease.example";
const shouldIndex = approvedForIndexing && !noIndex && Boolean(pageContent);
const schema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  name: "Travel With Ease",
  url: site.toString(),
  areaServed: "Ghana",
  description,
};
const jsonLd = serializeJsonLd(schema);
const breadcrumbs = Astro.props.breadcrumbs || [];
if (!Array.isArray(breadcrumbs) || breadcrumbs.length > 10)
  throw new Error("Invalid breadcrumb list.");
const breadcrumbJson = breadcrumbs.length
  ? serializeJsonLd({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map(
        (item: { name: string; path: string }, index: number) => {
          if (
            typeof item.name !== "string" ||
            !item.name.trim() ||
            item.name.length > 120 ||
            typeof item.path !== "string" ||
            !/^\/(?!\/)[a-z0-9/_-]*$/i.test(item.path)
          )
            throw new Error("Invalid public breadcrumb.");
          return {
            "@type": "ListItem",
            position: index + 1,
            name: item.name,
            item: canonicalUrl(item.path, site),
          };
        },
      ),
    })
  : null;
const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "";
// Public source identifier only; never emit arbitrary environment values.
const releaseSha = [
  process.env.CF_PAGES_COMMIT_SHA,
  process.env.GITHUB_SHA,
  process.env.TWE_RELEASE_SHA,
].find((value) => typeof value === "string" && /^[a-f0-9]{40}$/i.test(value));
const visible = (href: string) =>
  href === "/journal" ||
  (cinematic && href.startsWith("#")) ||
  Boolean(publishedPage(href === "/" ? "home" : href.slice(1)));
const navigation = [
  ["/packages", "Packages"],
  ["/services", "Services"],
  ["/how-it-works", "How It Works"],
  ["/journal", "Journal"],
  ["/about", "About"],
];
---

<!doctype html>
<html lang="en-GH">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Inter:wght@700;800&family=Poiret+One&family=Quicksand:wght@400;500;600;700&family=Sassy+Frass&display=swap" />
    <meta name="theme-color" content="#010c33" />
    {releaseSha && <meta name="twe-release" content={releaseSha} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
    <meta
      name="robots"
      content={shouldIndex ? "index, follow" : "noindex, nofollow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-GH" href={canonical} />
    <meta property="og:site_name" content="Travel With Ease" />
    <meta property="og:locale" content="en_GH" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={sharing.image} />
    <meta property="og:image:width" content={String(sharing.width)} />
    <meta property="og:image:height" content={String(sharing.height)} />
    <meta property="og:image:alt" content={sharing.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={sharing.image} />
    <meta name="twitter:image:alt" content={sharing.imageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    {
      breadcrumbJson && (
        <script
          is:inline
          type="application/ld+json"
          set:html={breadcrumbJson}
        />
      )
    }
  </head>
  <body id="top" class:list={{ "cinematic-page": cinematic }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-header-shell">
    <header class="site-header">
      <a
        class="brand"
        href="/"
        aria-label="Travel With Ease home"
        ><img
          class="brand__wordmark brand__wordmark--gold"
          src="/brand/Primary gold.png"
          width="600"
          height="200"
          alt="Travel With Ease"
        /><img
          class="brand__symbol brand__symbol--scrolled"
          src="/brand/dark mode symbol.png"
          width="200"
          height="200"
          alt=""
          aria-hidden="true"
        /></a
      >
      <button
        type="button"
        class="menu-toggle"
        hidden
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label="Menu">
        <svg class="menu-toggle__open" aria-hidden="true" focusable="false"
          xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="menu-toggle__close" aria-hidden="true" focusable="false"
          xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button
      >
      <nav id="primary-navigation" aria-label="Primary navigation">
        <div class="header-links">
          {
            navigation
              .filter(([href]) => visible(href))
              .map(([href, label]) => (
                <a
                  href={href}
                  aria-current={
                    (Astro.url.pathname.replace(/\/$/, "") || "/") === href
                      ? "page"
                      : undefined
                  }
                >
                  {label}
                </a>
              ))
          }
        </div>
        {
          (
            <ContentLink
              button
              class="nav-cta"
              href="#plan"
            >
              Plan My Trip
            </ContentLink>
          )
        }
      </nav>
    </header>
    </div>
    <main id="main-content"><slot /></main>
    <slot name="closing" />
    {!Astro.slots.has("closing") && (
      <CinematicEnquiry enquiryAvailable={Boolean(publishedPage("contact"))} />
    )}
    <FloatingActions />
    <EditorialMotion />
    <CookieNotice />
    <AnalyticsConsent />
  </body>
</html>
<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    let scheduled = false;
    const updateHeader = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 40);
      scheduled = false;
    };
    updateHeader();
    window.addEventListener("scroll", () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(updateHeader);
      }
    }, { passive: true });
    window.addEventListener("pageshow", updateHeader);
  }
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#primary-navigation");
  if (toggle && nav) {
    const mobile = matchMedia("(max-width: 900px)");
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      nav.dataset.collapsed = String(!open && mobile.matches);
      document.body.classList.toggle("twe-mobile-menu-open", open && mobile.matches);
    };
    toggle.hidden = false;
    setOpen(false);
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    nav.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobile.matches) {
        setOpen(false);
        toggle.focus();
      }
    });
    nav.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a") && mobile.matches)
        setOpen(false);
    });
    toggle.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
    mobile.addEventListener("change", () => setOpen(false));
  }
</script>
