PUBLIC_SITE_URL=https://travelwitheasegh.com
PUBLIC_APP_ENV=development
PUBLIC_SITE_INDEXABLE=false
PUBLIC_API_BASE_URL=https://api.travelwitheasegh.com
# Production defaults to the approved TWE stream G-GVJ2HGT6YN.
# Leave blank locally/staging; an optional separate test stream can be configured.
# The production stream is blocked outside production, including copied env files.
# Analytics requires a published privacy page and visitor consent; DNT is respected.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=
TWE_API_PROXY_TARGET=http://localhost:3090

# Only set true on the staging Cloudflare Pages public website build.
# This is a build-time flag. Production must leave it false.
PUBLIC_STAGING_DEMO_ENABLED=false
# Staging /demo requires PUBLIC_API_BASE_URL to be the staging Railway API HTTPS origin.
# On the staging API, set TWE_DEMO_ORIGIN to the exact staging website origin.
