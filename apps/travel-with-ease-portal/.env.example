# Same-origin API requests; Vite proxies locally and the hosted server proxies remotely.
VITE_API_BASE_URL=
# Server-only hosted configuration (never prefix these with VITE_).
APP_ENV=staging
TWE_AUTH_MODE=cloudflare_access
TWE_ACCESS_TEAM_DOMAIN=
TWE_ACCESS_AUDIENCE=
TWE_PORTAL_ORIGIN=
TWE_PORTAL_API_ORIGIN=
