---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  path="/500"
  status={500}
  title="Service Error | Faako"
  description="The Faako website could not complete this request."
  noIndex
>
  <section class="page not-found-page not-found-page--v2">
    <div class="not-found-shell is-visible">
      <p class="not-found-code">500</p>
      <h1>Something went wrong.</h1>
      <p class="lead">
        Try the request again. If the problem continues, contact the Faako team.
      </p>
      <div class="not-found-actions">
        <a class="button button-primary" href="/">Go to home</a>
        <a class="button button-ghost" href="/contact">Contact support</a>
      </div>
    </div>
  </section>
</BaseLayout>
