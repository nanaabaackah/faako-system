---
import "@faako/ui/compat.css";
import "../styles/global.css";
import "../styles/header.css";
import "../styles/footer.css";
import "../styles/components/button.css";
import SiteHeaderIsland from "../components/islands/SiteHeaderIsland.jsx";
import SiteFooterIsland from "../components/islands/SiteFooterIsland.jsx";
import CookieConsentIsland from "../components/islands/CookieConsentIsland.jsx";
import AnalyticsIsland from "../components/islands/AnalyticsIsland.jsx";
import SiteEnhancementsIsland from "../components/islands/SiteEnhancementsIsland.jsx";
import {
  DEFAULT_SOCIAL_IMAGE,
  SITE_NAME,
  SITE_URL,
  buildStructuredData,
  getSeoForPath,
} from "../content/seo.js";

const {
  path = Astro.url.pathname,
  status = 200,
  title,
  description,
  noIndex,
} = Astro.props;
const routeSeo = getSeoForPath(path);
const seo = {
  ...routeSeo,
  ...(title ? { title } : {}),
  ...(description ? { description } : {}),
  ...(typeof noIndex === "boolean" ? { noIndex } : {}),
};
const normalizedPath = path === "/" ? "/" : path.replace(/\/+$/, "");
const canonical = new URL(normalizedPath, SITE_URL).toString();
const image = new URL(seo.image || DEFAULT_SOCIAL_IMAGE, SITE_URL).toString();
const structuredData = buildStructuredData(normalizedPath, seo);
const serializedStructuredData = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);

if (status !== 200) Astro.response.status = status;
---

<!doctype html>
<html
  lang="en-GH"
  data-theme="light"
  data-faako-theme="faako-website"
  data-security-profile="public-interactive"
  data-auth-mode="none"
  data-faako-app="@faako/faako-website"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#fbfbfb" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content="Faako" />
    <meta
      name="robots"
      content={seo.noIndex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/site.webmanifest" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GH" />
    <meta property="og:type" content={seo.type || "website"} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Faako business systems" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Faako business systems" />
    <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeaderIsland path={normalizedPath} client:load />
    <main class="site-main" id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooterIsland path={normalizedPath} client:visible />
    <CookieConsentIsland path={normalizedPath} client:load />
    <AnalyticsIsland path={normalizedPath} client:load />
    <SiteEnhancementsIsland client:idle={{ timeout: 1500 }} />
    <noscript>
      <p class="noscript-note">
        Faako page content and navigation remain available without JavaScript.
        Interactive configurators and forms require JavaScript.
      </p>
    </noscript>
    <script>
      document.documentElement.classList.add("js");

      const savedTheme = window.localStorage.getItem("faako-theme");
      if (savedTheme === "dark" || savedTheme === "light") {
        document.documentElement.dataset.theme = savedTheme;
      }

      const revealTargets = Array.from(
        document.querySelectorAll("[data-scroll], .reveal"),
      );
      if (
        window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
        !("IntersectionObserver" in window)
      ) {
        revealTargets.forEach((target) => target.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        revealTargets.forEach((target) => observer.observe(target));
      }

      // Compatibility islands still render React Router links. Full-document
      // navigation keeps Astro in charge of route metadata and status codes.
      document.addEventListener(
        "click",
        (event) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          const anchor =
            event.target instanceof Element
              ? event.target.closest("a[href]")
              : null;
          if (
            !(anchor instanceof HTMLAnchorElement) ||
            anchor.target ||
            anchor.hasAttribute("download")
          )
            return;

          const destination = new URL(anchor.href, window.location.href);
          if (destination.origin !== window.location.origin) return;

          event.preventDefault();
          event.stopImmediatePropagation();
          window.location.assign(destination.href);
        },
        true,
      );
    </script>
  </body>
</html>
