# Client-side variables are bundled into the Astro browser islands.
# Only put public, non-secret values in VITE_* entries.
# Local dev proxies /api through Astro to the Faako API.
# Production builds default an unset or /api value to the deployed Faako API origin.
# Override this in hosted environments to use a different faako-api origin.
VITE_API_BASE_URL="/api"
VITE_GA_MEASUREMENT_ID=""
VITE_ENABLE_GA_IN_DEV="false"
VITE_ENABLE_APP_UPDATE_NOTICE="false"
# URL of the deployed Faako ERP demo — used by the "See How It Works" button on the homepage.
VITE_ERP_DEMO_URL="https://faako-erp.nanaabaackah.com"
FAAKO_API_PROXY_TARGET="http://127.0.0.1:8889"
