# Client-side Vite variables are bundled into the browser.
# Only put public, non-secret values in VITE_* entries.
# Local dev should point at the local faako-api functions server.
# Override this in hosted environments if the website should use a deployed faako-api origin.
VITE_API_BASE_URL="http://localhost:8889"

# Server-side variables below are only needed if this Netlify site owns the signup function.
# If VITE_API_BASE_URL points at a separate deployed faako-api service, configure the values
# below on apps/faako-api instead and leave them unset on this website site.
APP_ENV="development"
DATABASE_URL_DEVELOPMENT="postgresql://username:password@localhost:5432/app_local"
# DATABASE_URL_LOCAL="postgresql://username:password@localhost:5432/app_local"
# DATABASE_URL_PRODUCTION="postgresql://username:password@db.example.com:5432/app_db"
ALLOW_PRODUCTION_DATABASE_IN_DEV="false"
RESEND_API_KEY="re_replace_with_real_key"
RESEND_FROM_NAME="Company Name"
RESEND_FROM_EMAIL="noreply@example.com"
INTAKE_ADMIN_EMAIL="team@example.com"
ADMIN_EMAIL="team@example.com"
EMAIL_FORCE_TO="qa@example.com"
EXPOSE_DEBUG_ERRORS="false"
RATE_LIMIT_SECRET="replace-with-long-random-secret"
ALLOWED_ORIGIN="http://localhost:5175"
