{
  "name": "@faako/reebs-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm run server:with-migrate",
    "dev": "pnpm run predeploy:local && pnpm run dev:frontend",
    "dev:frontend": "VITE_API_BASE_URL=http://localhost:8888 vite --host 0.0.0.0 --port 5174",
    "dev:backend": "APP_ENV=development NODE_ENV=development node backend/server.js",
    "build": "vite build",
    "db:generate": "prisma generate",
    "db:generate:dev": "node scripts/runPrismaCommand.mjs development generate",
    "db:generate:staging": "node scripts/runPrismaCommand.mjs staging generate",
    "db:generate:prod": "node scripts/runPrismaCommand.mjs production generate",
    "db:validate": "prisma validate",
    "db:validate:dev": "node scripts/runPrismaCommand.mjs development validate",
    "db:validate:staging": "node scripts/runPrismaCommand.mjs staging validate",
    "db:validate:prod": "node scripts/runPrismaCommand.mjs production validate",
    "db:studio:dev": "APP_ENV=development prisma studio",
    "db:migrate:dev": "node scripts/runPrismaCommand.mjs development migrate dev",
    "db:reset:dev": "node scripts/runPrismaCommand.mjs development migrate reset",
    "db:status:dev": "node scripts/runPrismaCommand.mjs development migrate status",
    "db:status:staging": "node scripts/runPrismaCommand.mjs staging migrate status",
    "db:status:prod": "node scripts/runPrismaCommand.mjs production migrate status",
    "db:deploy": "node scripts/runPrismaCommand.mjs current migrate deploy",
    "db:deploy:dev": "node scripts/runPrismaCommand.mjs development migrate deploy",
    "db:deploy:staging": "node scripts/runPrismaCommand.mjs staging migrate deploy",
    "db:deploy:prod": "node scripts/runPrismaCommand.mjs production migrate deploy",
    "env:contract": "node ../../scripts/check-env-contract.mjs .env.example",
    "env:drift:dev": "node ../../scripts/check-env-contract.mjs .env.example --target .env.development",
    "release:data-check:dev": "node scripts/checkDataConsistency.mjs development",
    "release:data-check:staging": "node scripts/checkDataConsistency.mjs staging",
    "release:data-check:prod": "node scripts/checkDataConsistency.mjs production",
    "orders:audit:dev": "node scripts/maintenance/auditOrderConsistency.mjs development",
    "orders:audit:staging": "node scripts/maintenance/auditOrderConsistency.mjs staging",
    "orders:audit:prod": "node scripts/maintenance/auditOrderConsistency.mjs production",
    "customers:audit:dev": "node scripts/maintenance/auditCustomerData.mjs development",
    "customers:audit:staging": "node scripts/maintenance/auditCustomerData.mjs staging",
    "customers:audit:prod": "node scripts/maintenance/auditCustomerData.mjs production",
    "inventory:reconcile:dev": "node scripts/maintenance/reconcileInventory.mjs development",
    "inventory:reconcile:staging": "node scripts/maintenance/reconcileInventory.mjs staging",
    "inventory:reconcile:prod": "node scripts/maintenance/reconcileInventory.mjs production",
    "payments:reconcile:dev": "node scripts/maintenance/reconcilePayments.mjs development",
    "payments:reconcile:staging": "node scripts/maintenance/reconcilePayments.mjs staging",
    "payments:reconcile:prod": "node scripts/maintenance/reconcilePayments.mjs production",
    "invoices:reconcile:dev": "node scripts/maintenance/reconcileInvoices.mjs development",
    "invoices:reconcile:staging": "node scripts/maintenance/reconcileInvoices.mjs staging",
    "invoices:reconcile:prod": "node scripts/maintenance/reconcileInvoices.mjs production",
    "predeploy:local": "pnpm run db:generate:dev && pnpm run db:deploy:dev && pnpm run db:status:dev",
    "predeploy": "pnpm run db:generate",
    "server": "node backend/server.js",
    "server:dev": "APP_ENV=development NODE_ENV=development node backend/server.js",
    "server:staging": "APP_ENV=staging NODE_ENV=production node backend/server.js",
    "server:prod": "APP_ENV=production NODE_ENV=production node backend/server.js",
    "dev:with-backend": "pnpm run predeploy:local && concurrently -k -n backend,portal -c magenta,cyan \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "lint": "eslint .",
    "test": "node --test",
    "server:dev:with-migrate": "pnpm run predeploy:local && pnpm run server:dev",
    "server:staging:with-migrate": "pnpm run db:generate:staging && pnpm run db:deploy:staging && pnpm run server:staging",
    "server:prod:with-migrate": "pnpm run db:generate:prod && pnpm run db:deploy:prod && pnpm run server:prod",
    "server:with-migrate": "pnpm run db:generate && pnpm run db:deploy && pnpm run server",
    "railway:build": "pnpm run db:generate",
    "railway:start": "pnpm run server:with-migrate",
    "source-categories:seed": "node scripts/seeds/seedSourceCategories.js",
    "source-categories:relink:dry": "node scripts/backfills/relinkToysSourceCategories.js",
    "source-categories:relink:apply": "node scripts/backfills/relinkToysSourceCategories.js --apply",
    "business-units:classify:dry": "node scripts/backfills/reportBusinessUnitClassification.js",
    "rehash:passwords": "node scripts/maintenance/rehashPasswords.js",
    "test:e2e": "PORT=5174 npx playwright test",
    "test:security-foundation": "node --test backend/functions/login.test.js src/components/AuthContext/authResponse.test.js",
    "test:e2e:ui": "PORT=5174 npx playwright test --ui",
    "test:e2e:all": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\" \"pnpm run test:e2e\""
  },
  "dependencies": {
    "@faako/api-client": "workspace:*",
    "@faako/api-contracts": "workspace:*",
    "@faako/config": "workspace:*",
    "@faako/core": "workspace:*",
    "@faako/finance": "workspace:*",
    "@faako/notifications": "workspace:*",
    "@faako/offline-sync": "workspace:*",
    "@faako/security": "workspace:*",
    "@faako/logger": "workspace:*",
    "@faako/ui": "workspace:*",
    "@faako/utils": "workspace:*",
    "@faako/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.2.0",
    "@react-google-maps/api": "^2.20.7",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "iconsax-react": "^0.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "openai": "^6.2.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axe-playwright": "^2.2.2",
    "babel-jest": "^30.0.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest": "^30.0.4",
    "playwright": "^1.55.1",
    "postcss": "^8.5.18",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.2",
    "vite": "^6.4.3"
  }
}
