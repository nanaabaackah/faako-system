{
  "name": "@faako/reebs-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm run server:with-migrate",
    "dev": "pnpm run predeploy:local && pnpm run dev:frontend",
    "dev:frontend": "VITE_API_BASE_URL=http://localhost:8888 vite --host 0.0.0.0 --port 5174",
    "dev:backend": "APP_ENV=development node backend/server.js",
    "build": "vite build",
    "db:generate": "APP_ENV=development prisma generate",
    "db:studio:dev": "APP_ENV=development prisma studio",
    "db:migrate:dev": "APP_ENV=development prisma migrate dev",
    "db:status:dev": "APP_ENV=development prisma migrate status",
    "db:status:prod": "APP_ENV=production prisma migrate status",
    "db:deploy:dev": "APP_ENV=development prisma migrate deploy",
    "db:deploy:prod": "APP_ENV=production prisma migrate deploy",
    "predeploy:local": "pnpm run db:generate && pnpm run db:deploy:dev && pnpm run db:status:dev",
    "predeploy": "pnpm run predeploy:local",
    "server:dev": "APP_ENV=development node backend/server.js",
    "server:prod": "APP_ENV=production node backend/server.js",
    "dev:with-backend": "pnpm run predeploy:local && concurrently -k -n backend,portal -c magenta,cyan \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "lint": "eslint .",
    "test": "node --test",
    "server:dev:with-migrate": "pnpm run predeploy:local && pnpm run server:dev",
    "server:prod:with-migrate": "pnpm run db:generate && pnpm run db:deploy:prod && pnpm run server:prod",
    "server:with-migrate": "pnpm run server:prod:with-migrate",
    "source-categories:seed": "node scripts/seedSourceCategories.js",
    "source-categories:relink:dry": "node scripts/relinkToysSourceCategories.js",
    "source-categories:relink:apply": "node scripts/relinkToysSourceCategories.js --apply",
    "rehash:passwords": "node scripts/rehashPasswords.js",
    "test:e2e": "PORT=5174 playwright test",
    "test:security-foundation": "node --test backend/functions/login.test.js src/components/AuthContext/authResponse.test.js",
    "test:e2e:ui": "PORT=5174 npx playwright test --ui",
    "test:e2e:all": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\" \"pnpm run test:e2e\""
  },
  "dependencies": {
    "@faako/api-contracts": "workspace:*",
    "@faako/config": "workspace:*",
    "@faako/core": "workspace:*",
    "@faako/finance": "workspace:*",
    "@faako/notifications": "workspace:*",
    "@faako/offline-sync": "workspace:*",
    "@faako/security": "workspace:*",
    "@faako/logger": "workspace:*",
    "@faako/ui": "workspace:*",
    "@faako/utils": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.2.0",
    "@react-google-maps/api": "^2.20.7",
    "animejs": "^4.3.6",
    "brew": "^0.0.8",
    "click-spark": "^2.1.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.6",
    "fs": "^0.0.1-security",
    "iconsax": "^0.0.1",
    "iconsax-react": "^0.0.8",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "nodemailer": "^8.0.2",
    "openai": "^6.2.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "prop-types": "^15.8.1",
    "psql": "^0.0.1",
    "railway": "^2.0.17",
    "react": "^19.1.1",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.3",
    "react-tsparticles": "^2.12.2",
    "yet-another-react-lightbox": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "axe-playwright": "^2.2.2",
    "babel-jest": "^30.0.4",
    "concurrently": "^8.2.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest": "^30.0.4",
    "playwright": "^1.55.1",
    "postcss": "^8.5.5",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
