# Copy this file to .env.development for local work.
APP_ENV="development"
NODE_ENV="development"
DATABASE_URL_DEVELOPMENT="postgresql://username:password@localhost:5432/app_local"
# Railway staging and production supply their own environment-scoped DATABASE_URL.
# DATABASE_URL="postgresql://username:password@db.example.com:5432/app_deployed"
# Compatibility only for intentional production maintenance outside Railway.
# DATABASE_URL_PRODUCTION="postgresql://username:password@db.example.com:5432/app_production"
DATABASE_SSL_MODE="disable"
# Hosted Postgres providers may need this unless DATABASE_SSL_CA is configured.
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"
ENFORCE_DATABASE_ISOLATION="true"

VITE_GOOGLE_MAPS_KEY=""
VITE_GA_MEASUREMENT_ID=""
# Legacy alias supported for existing deploy settings.
VITE_GA_ID=""
VITE_ENABLE_GA_IN_DEV="false"
VITE_CURRENCY_API_KEY=""
VITE_EXCHANGE_API_KEY=""
VITE_API_BASE_URL="http://localhost:8888"
# Legacy fallback only. Prefer VITE_API_BASE_URL for the REEBS API wrapper.
VITE_BACKEND_BASE_URL=""
VITE_REEBS_WEBSITE_URL="http://localhost:5173"
APP_URL="http://localhost:8888"
APP_BASE_URL="http://localhost:5174"
REEBS_PORTAL_URL="http://localhost:5174"
REEBS_WEBSITE_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
CORS_ORIGINS_STAGING=""
CORS_ORIGINS_PRODUCTION=""
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
# Required by public catalogue terms, quote, and checkout handlers. Use the
# reviewed organization ID for each environment; never accept it from browsers.
PUBLIC_ORGANIZATION_ID=""
# Legacy compatibility aliases. Prefer PUBLIC_ORGANIZATION_ID.
REEBS_PUBLIC_ORGANIZATION_ID=""
ALLOWED_CHECKOUT_ORG_IDS=""

GOOGLE_MAPS_API_KEY=""
OPENAI_API_KEY=""
MANAGER_PIN_HASH="scrypt$..."
MANAGER_APP_SECRET="change-me"
USER_APP_SECRET="change-me"
# Server-only secret for Railway deployment/alert webhooks into Audit Logs.
# Configure Railway to POST to /api/webhooks/railway with Authorization: Bearer <secret>
# or one of the accepted secret headers.
RAILWAY_WEBHOOK_SECRET=""
WATER_MOMO_WEBHOOK_SECRET=""
# Server-only. The shared Paystack adapter remains disabled when this is empty.
# Staging must use a test key; production must use a live key. Never expose this as VITE_*.
PAYSTACK_SECRET_KEY=""
# Server-controlled return URL for staff-created Paystack checkout sessions.
PAYSTACK_CALLBACK_URL="http://localhost:5174/admin/payments"
PAYSTACK_TIMEOUT_MS=12000

# Optional isolated read-only Python analytics service for the admin dashboard.
# The Node API sends organization-scoped aggregates only; the service has no database access.
REEBS_ANALYTICS_SERVICE_URL="http://127.0.0.1:8010"
REEBS_ANALYTICS_SERVICE_SECRET="change-me"
FAAKO_ANALYTICS_SERVICE_URL="http://127.0.0.1:8010"
FAAKO_ANALYTICS_SERVICE_SECRET="change-me"
REEBS_API_CONCURRENCY_LIMIT=2
REEBS_API_READ_RETRY_LIMIT=2
REEBS_API_READ_RETRY_DELAY_MS=180
REEBS_HEALTH_TIMEOUT_MS=2000
REEBS_SHUTDOWN_GRACE_MS=10000
REEBS_EMAIL_TIMEOUT_MS=10000
REEBS_BUILD_REFERENCE="development"
# Keep false locally. Enable only in the controlled production migration job.
REEBS_ALLOW_PRODUCTION_MIGRATION="false"
# Keep false by default. Enable only for the explicit read-only production readiness check.
REEBS_ALLOW_PRODUCTION_READINESS_CHECK="false"

WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_MANAGER_PHONE=""

EMAIL_NOTIFICATIONS_ENABLED="true"
BREVO_API_KEY=""
EMAIL_FROM="Company Name <info@example.com>"
EMAIL_REPLY_TO="info@example.com"
EMAIL_CATCHALL_TO="info@example.com"
EMAIL_PAYMENT_MOMO_ACCOUNT_NAME="Company Name"
EMAIL_PAYMENT_MOMO_MTN_NUMBER=""
EMAIL_PAYMENT_MOMO_TELECEL_NUMBER=""
EMAIL_PAYMENT_MOMO_AIRTELTIGO_NUMBER=""
EMAIL_PAYMENT_MOMO_GMONEY_NUMBER=""
EMAIL_PAYMENT_MOMO_DETAILS=""
EMAIL_PAYMENT_BANK_DETAILS=""
EMAIL_FORCE_TO="dev@nanaabaackah.com"
