generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              Int              @id @default(autoincrement())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
  orderItems      OrderItem[]
  products        Product[]
  sourceCategories SourceCategory[]
  specificCategories SpecificCategory[]
  inventoryVariants InventoryVariant[]
  stockMovements  StockMovement[]
  users           User[]
  employeeProfiles EmployeeProfile[]
  documents       Document[]
  vendors         Vendor[]
  maintenanceLogs MaintenanceLog[]
  timesheets      Timesheet[]
  expenses        Expense[]
  discounts       Discount[]
  customers       Customer[]
  bookings        Booking[]
  bookingItems    BookingItem[]
  bouncyCastles   BouncyCastle[]
  indoorGames     IndoorGame[]
  machines        Machine[]
  shopItems       ShopItem[]
  waterRestocks   WaterRestock[]
  waterSales      WaterSale[]
  waterExpenses   WaterExpense[]
  waterAdjustments WaterAdjustment[]
  accountingConfig AccountingConfig?
  websiteContents WebsiteContent[]
  accountingManualSales AccountingManualSales[]
  userSessions    UserSession[]

  @@map("organization")
}

model Order {
  id              Int           @id @default(autoincrement())
  organizationId  Int @default(1)
  organization    Organization  @relation(fields: [organizationId], references: [id])
  orderNumber     String
  customerId      Int
  customerName    String
  status          String
  deliveryMethod  String   @default("delivery")
  deliveryDetails Json?
  pickupDetails   Json?
  total_amount    Int           
  orderDate       DateTime
  deliveryDate    DateTime?
  assignedUserId  Int?
  assignedUser    User?         @relation(fields: [assignedUserId], references: [id])
  createdByUserId Int?
  updatedByUserId Int?
  lastModifiedAt  DateTime?     @default(now())
  
  customer        Customer      @relation(fields: [customerId], references: [id]) 
  orderItems      OrderItem[]
  expenses        Expense[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([organizationId, orderNumber])
  @@map("order")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        Int
  productId      Int
  variantId      Int?
  quantity       Int
  unit_price     Int     
  total_amount   Int     
  Order          Order   @relation(fields: [orderId], references: [id])
  Product        Product @relation(fields: [productId], references: [id])
  variant        InventoryVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("orderItem")
}

model Product {
  id                   Int      @id @default(autoincrement())
  organizationId       Int @default(1)
  organization         Organization @relation(fields: [organizationId], references: [id])
  sku                  String
  barcode              String?
  name                 String
  description          String?
  vendorId             Int?
  vendor               Vendor?  @relation(fields: [vendorId], references: [id])
  
  itemType             String   @default("STANDARD")
  sourceCategoryId     Int?
  sourceCategory       SourceCategory? @relation(fields: [sourceCategoryId], references: [id])
  sourceCategoryCode   String
  specificCategory     String?
  rate                 String?
  page                 String?
  age                  String?  

  purchasePriceGhs  Int?            // CP (GHC) in pesewas
  purchasePriceGbp  Int?            // CP (BP) in pence
  purchasePriceCad  Int?            // CP (CAD->GBP) in pence
  stockValue        Int?            // CALCULATED: stock * price
  saleValue         Int?            // HISTORICAL: Imported from Excel 'SALES VALUE'
  
  price                Int      
  currency             String   @default("GHS")
  stock                Int      @default(0)
  reorderLevel         Int      @default(2)
  reorderQuantity      Int      @default(0)
  isActive             Boolean  @default(true)
  isArchived           Boolean  @default(false)
  archivedAt           DateTime?
  archivedByUserId     Int?
  isDeleted            Boolean  @default(false)
  deletedAt            DateTime?
  deletedByUserId      Int?
  imageUrl             String?
  attendantsNeeded     Int?
  lastUpdatedByUserId  Int?
  lastUpdatedAt        DateTime? @default(now())
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  OrderItem            OrderItem[]
  variants             InventoryVariant[]
  StockMovement        StockMovement[]
  bookingItems         BookingItem[]
  maintenanceLogs      MaintenanceLog[]
  bouncyCastle         BouncyCastle?
  indoorGame           IndoorGame?
  machine              Machine?
  shopItem             ShopItem?
  
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([sourceCategoryId])
  @@index([organizationId, itemType])
  @@index([organizationId, sourceCategoryCode])
  @@index([organizationId, isDeleted, isArchived])
  @@map("product")
}

model SourceCategory {
  id             Int      @id @default(autoincrement())
  organizationId Int     @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  slug           String
  isActive       Boolean  @default(true)
  products       Product[]
  specificCategories SpecificCategory[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isActive])
  @@map("sourceCategory")
}

model SpecificCategory {
  id                 Int      @id @default(autoincrement())
  organizationId     Int      @default(1)
  organization       Organization @relation(fields: [organizationId], references: [id])
  sourceCategoryId   Int?
  sourceCategory     SourceCategory? @relation(fields: [sourceCategoryId], references: [id])
  sourceCategoryCode String?
  name               String
  slug               String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, sourceCategoryCode, isActive])
  @@index([sourceCategoryId])
  @@map("specificCategory")
}

model InventoryVariant {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  inventoryItemId Int
  inventoryItem   Product  @relation(fields: [inventoryItemId], references: [id])
  sku             String
  variantNumber   String?
  color           String?
  size            String?
  stockQty        Int      @default(0)
  reservedQty     Int      @default(0)
  reorderLevel    Int      @default(2)
  priceOverride   Int?
  status          String   @default("active")
  orderItems      OrderItem[]
  bookingItems    BookingItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, inventoryItemId])
  @@map("inventoryVariant")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId Int
  variantId Int?
  type      String
  quantity  Int
  date      DateTime
  createdAt DateTime? @default(now())
  notes     String?
  reference String?  // <--- Ensure this line exists
  soldMonth DateTime? @db.Date
  performedByUserId Int?
  performedByName   String?
  performedByEmail  String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  Product   Product  @relation(fields: [productId], references: [id])
  variant   InventoryVariant? @relation(fields: [variantId], references: [id])
  @@index([productId])
  @@index([variantId])
  @@map("stockMovement")
}

enum StockType {
  StockIn
  StockOut
}

model User {
  id        Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  email     String   @unique
  personalEmail String?
  password  String   
  firstName String
  lastName  String
  fullName  String
  role      String   @default("Staff")
  permissions Json?
  loginAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  stockMovements StockMovement[]
  bookings  Booking[]
  expenses  Expense[]
  profile   EmployeeProfile?
  timesheets Timesheet[]
  sessions  UserSession[]
  
  @@unique([organizationId, personalEmail])
  @@map("user")
}

model UserSession {
  id            Int          @id @default(autoincrement())
  organizationId Int @default(1)
  organization  Organization @relation(fields: [organizationId], references: [id])
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  sessionTokenId String      @unique
  remember      Boolean      @default(true)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([userId, organizationId])
  @@index([organizationId, expiresAt, revokedAt])
  @@map("userSession")
}

model EmployeeProfile {
  id                     Int      @id @default(autoincrement())
  organizationId         Int @default(1)
  organization           Organization @relation(fields: [organizationId], references: [id])
  userId                 Int      @unique
  user                   User     @relation(fields: [userId], references: [id])
  jobTitle               String?
  phone                  String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("employeeProfile")
}

model Document {
  id        Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  title     String
  category  String?
  fileName  String
  mimeType  String?
  size      Int?
  data      String
  source    String?  @default("upload")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document")
}

model AccountingManualSales {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  year            Int
  monthlySales    Json
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, year])
  @@map("accountingManualSales")
}

model AccountingConfig {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @unique @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  balanceInputs   Json?
  taxInputs       Json?
  ghanaTaxConfig  Json?
  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("accountingConfig")
}

model WebsiteContent {
  id             Int          @id @default(autoincrement())
  organizationId Int         @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  section        String
  key            String
  payload        Json
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, section, key])
  @@index([organizationId, section, isActive, sortOrder])
  @@map("websiteContent")
}

model Vendor {
  id           Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name         String
  contactName  String?
  email        String?
  phone        String?
  mobileMoneyNumber String?
  address      String?
  bankName     String?
  bankAccount  String?
  leadTimeDays Int?
  suppliedItems String[] @default([])
  notes        String?
  products     Product[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vendor")
}

model MaintenanceLog {
  id         Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  issue      String
  type       String
  cost       Int      @default(0)
  status     String   @default("open")
  notes      String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime @updatedAt

  @@map("maintenanceLog")
}

model Timesheet {
  id         Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  clockIn    DateTime
  clockOut   DateTime?
  clockInLat Float?
  clockInLng Float?
  clockOutLat Float?
  clockOutLng Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("timesheet")
}

model Expense {
  id          Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  category    String
  amount      Int
  description String
  date        DateTime
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id])
  bookingId   Int?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expense")
}

model Discount {
  id            Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  code          String
  type          String
  value         Float
  minOrderValue Float?
  expiryDate    DateTime?
  scope         String?
  segment       String?
  reward        String?
  usageCount    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organizationId, code])
  @@map("discount")
}

model Customer {
  id        Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name      String
  email     String?
  phone     String?
  
  orders    Order[] 
  bookings Booking[]
  waterSales WaterSale[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([organizationId, email])
  @@map("customer")
}

model WaterRestock {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  productKey      String       @default("gwater-12pk")
  productName     String       @default("12pk Gwater")
  quantity        Int
  unitCost        Int          @default(2200)
  vendorId        Int?
  vendorName      String?
  notes           String?
  date            DateTime
  createdByUserId Int?
  createdByName   String?
  createdAt       DateTime     @default(now())

  @@map("waterRestock")
}

model WaterSale {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  productKey      String       @default("gwater-12pk")
  productName     String       @default("12pk Gwater")
  quantity        Int
  saleChannel     String
  paymentMethod   String       @default("cash")
  paymentStatus   String       @default("paid")
  paymentReference String?
  providerReference String?
  discountType    String       @default("none")
  discountValue   Int          @default(0)
  discountAmount  Int          @default(0)
  unitPrice       Int
  totalAmount     Int
  customerId      Int?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  customerName    String?
  notes           String?
  date            DateTime
  paidAt          DateTime?
  createdByUserId Int?
  createdByName   String?
  createdAt       DateTime     @default(now())

  @@map("waterSale")
}

model WaterExpense {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  category        String
  amount          Int
  description     String
  notes           String?
  date            DateTime
  createdByUserId Int?
  createdByName   String?
  createdAt       DateTime     @default(now())

  @@map("waterExpense")
}

model WaterAdjustment {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])
  productKey      String       @default("gwater-12pk")
  productName     String       @default("12pk Gwater")
  quantityDelta   Int
  reason          String
  notes           String?
  date            DateTime
  createdByUserId Int?
  createdByName   String?
  createdAt       DateTime     @default(now())

  @@map("waterAdjustment")
}

model Booking {
  id           Int           @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerId   Int
  customer     Customer      @relation(fields: [customerId], references: [id])
  eventDate    DateTime
  startTime    String?       // e.g., "10:00 AM"
  endTime      String?       // e.g., "04:00 PM"
  venueAddress String
  totalAmount  Int           // In cents
  status       String        @default("pending") // pending, confirmed, completed, cancelled
  items        BookingItem[]
  expenses     Expense[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedUserId Int?
  assignedUser User?         @relation(fields: [assignedUserId], references: [id])
  createdByUserId Int?
  updatedByUserId Int?
  lastModifiedAt  DateTime?   @default(now())
  delivery        Delivery?
  deferredRevenue DeferredRevenue?

  @@map("booking")
}

model BookingItem {
  id        Int     @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  variantId Int?
  variant   InventoryVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Int     // Price at time of booking (in cents)

  @@index([variantId])
  @@map("bookingItem")
}

model BouncyCastle {
  id             Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  bouncerId      String
  name           String
  productId      Int?     @unique
  product        Product? @relation(fields: [productId], references: [id])
  capacity       String?
  recommendedAge String?
  priceRange     String?
  motorsToPump   Int?
  bestFor        String?
  features       String?
  image          String?
  images         String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, bouncerId])
  @@map("bouncy_castles")
}

model IndoorGame {
  id           Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name         String
  productId    Int?     @unique
  product      Product? @relation(fields: [productId], references: [id])
  quantity     Int?
  price        Int?
  rate         String?
  availability String?
  category     String?
  image        String?
  page         String?
  piecesTotal  Int?
  piecesMissing Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("indoor_games")
}

model Machine {
  id           Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name         String
  productId    Int?     @unique
  product      Product? @relation(fields: [productId], references: [id])
  quantity     Int?
  price        Int?
  rate         String?
  availability String?
  category     String?
  image        String?
  page         String?
  power        String?
  output       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("machines")
}

model ShopItem {
  id          Int      @id @default(autoincrement())
  organizationId Int @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name        String
  productId   Int?     @unique
  product     Product? @relation(fields: [productId], references: [id])
  description String?
  price       Int
  currency    String   @default("GHS")
  ageRange    String?
  category    String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shop_items")
}

model Delivery {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  status     String   @default("scheduled")
  driverName String?
  routeGroup String?
  routeOrder Int?
  eta        String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([status])
  @@map("delivery")
}

model ManagerDevice {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  platform   String?
  deviceId   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@map("managerDevice")
}

model SystemConfig {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  key            String
  value          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("systemConfig")
}

model ChartOfAccount {
  id              Int              @id @default(autoincrement())
  organizationId  Int              @default(1)
  accountCode     String
  accountName     String
  accountType     String           // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance   String           // DEBIT | CREDIT
  parentAccountId Int?
  parentAccount   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  subAccounts     ChartOfAccount[] @relation("AccountHierarchy")
  isSystemAccount Boolean          @default(false)
  isActive        Boolean          @default(true)
  journalLines    JournalLine[]
  openingBalances OpeningBalance[]
  taxRates        TaxRate[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, accountCode])
  @@index([organizationId, accountType, isActive])
  @@map("chartOfAccount")
}

model TaxRate {
  id             Int             @id @default(autoincrement())
  organizationId Int             @default(1)
  taxType        String          // VAT | NHIL | GETFUND | COVID_HRL | WHT_INDIVIDUAL | WHT_COMPANY | PAYE | SSNIT_EMPLOYER | SSNIT_EMPLOYEE
  label          String
  rateInBps      Int             // basis points: 1500 = 15.00%, 250 = 2.50%, 100 = 1.00%
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean         @default(true)
  accountId      Int?
  account        ChartOfAccount? @relation(fields: [accountId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, taxType, isActive])
  @@map("taxRate")
}

model HistoricalImportBatch {
  id              Int              @id @default(autoincrement())
  organizationId  Int              @default(1)
  batchName       String
  periodStart     DateTime
  periodEnd       DateTime
  source          String
  summary         Json?
  isPosted        Boolean          @default(false)
  postedAt        DateTime?
  postedByUserId  Int?
  notes           String?
  journalEntries  JournalEntry[]
  openingBalances OpeningBalance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, batchName])
  @@index([organizationId, periodStart])
  @@map("historicalImportBatch")
}

model JournalEntry {
  id              Int                    @id @default(autoincrement())
  organizationId  Int                    @default(1)
  date            DateTime
  reference       String
  description     String?
  createdByUserId Int?
  isPosted        Boolean                @default(false)
  postedAt        DateTime?
  postedByUserId  Int?
  isReversed      Boolean                @default(false)
  reversalOfId    Int?
  reversalOf      JournalEntry?          @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals       JournalEntry[]         @relation("JournalReversal")
  importBatchId   Int?
  importBatch     HistoricalImportBatch? @relation(fields: [importBatchId], references: [id])
  lines           JournalLine[]
  recognitionLines RevenueRecognitionLine[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([organizationId, reference])
  @@index([organizationId, date])
  @@index([importBatchId])
  @@map("journalEntry")
}

model JournalLine {
  id             Int            @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
  accountId      Int
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  debit          Int            @default(0) // pesewas
  credit         Int            @default(0) // pesewas
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journalLine")
}

model OpeningBalance {
  id              Int                    @id @default(autoincrement())
  organizationId  Int                    @default(1)
  accountId       Int
  account         ChartOfAccount         @relation(fields: [accountId], references: [id])
  amount          Int                    // pesewas; positive = normal balance direction
  balanceDate     DateTime
  notes           String?
  importBatchId   Int?
  importBatch     HistoricalImportBatch? @relation(fields: [importBatchId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([organizationId, accountId, balanceDate])
  @@index([organizationId, balanceDate])
  @@map("openingBalance")
}

model DeferredRevenue {
  id                   Int                      @id @default(autoincrement())
  bookingId            Int                      @unique
  booking              Booking                  @relation(fields: [bookingId], references: [id])
  totalAmount          Int                      // in pesewas
  recognisedAmount     Int                      @default(0)
  unrecognisedAmount   Int                      // totalAmount - recognisedAmount; kept in sync on each recognition
  startDate            DateTime
  endDate              DateTime
  recognitionSchedule  RevenueRecognitionLine[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([bookingId])
  @@map("deferredRevenue")
}

model RevenueRecognitionLine {
  id                String          @id @default(cuid())
  deferredRevenueId Int
  deferredRevenue   DeferredRevenue @relation(fields: [deferredRevenueId], references: [id])
  periodDate        DateTime        // e.g. 2025-03-01 = March recognition
  amountToRecognise Int             // in pesewas
  isRecognised      Boolean         @default(false)
  recognisedAt      DateTime?
  journalEntryId    Int?            // links to journalEntry.id once posted
  journalEntry      JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([deferredRevenueId])
  @@index([journalEntryId])
  @@index([periodDate, isRecognised])
  @@map("revenueRecognitionLine")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, action, createdAt])
  @@index([userId, createdAt])
  @@map("auditLog")
}
