APP_ENV=development
PORT=3090
ALLOWED_ORIGINS=http://localhost:4328,http://localhost:5188
TWE_LOCAL_DATA_FILE=./data/development.json
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_TTL_SECONDS=21600
EXCHANGE_RATE_TIMEOUT_MS=5000
DATABASE_URL=
TWE_MIGRATION_DATABASE_URL=
# Hosted predeploy approval must exactly match APP_ENV. No local .env is loaded.
TWE_MIGRATION_APPROVED_ENV=
# Enable only for reviewed first-time setup; disable after successful deployment.
TWE_DB_INITIALISE=false
TWE_ORGANISATION_NAME=
TWE_ORGANISATION_ID=
# Verified TLS is the default. Use disable only for a loopback local/test DB.
TWE_DATABASE_TLS=require
TWE_DATABASE_CA=
# Separate disposable database; used only by test:db, never by the API.
TWE_TEST_DATABASE_URL=
# Access is the only executable staff provider. Keep environment audiences separate.
# Set all fields only after Access allowlists and independent MFA are configured.
TWE_AUTH_MODE=
TWE_ACCESS_TEAM_DOMAIN=
TWE_ACCESS_AUDIENCE=
# Optional, independently verified installer subject for initial Owner invitations.
# Exact subject within the configured issuer/audience; never an email address.
# Remove after initial Owner activation. Blank disables installer issuance.
TWE_SETUP_OPERATOR_SUBJECT=
TWE_API_ORIGIN=
TWE_PORTAL_ORIGIN=
# Private draft media only. Bucket must start with twe-<APP_ENV>-.
TWE_R2_ACCOUNT_ID=
TWE_R2_ACCESS_KEY_ID=
TWE_R2_SECRET_ACCESS_KEY=
TWE_R2_PRIVATE_BUCKET=
# TTNGH-style Drive configuration, with independent TWE credentials/folder.
# Server-only JSON credential; never put its value in chat, git, PUBLIC_ or VITE_.
# Share ONLY the approved TWE media folder with its service-account email as Viewer.
TWE_GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative: dedicated media-only Google account, approved offline read-only grant.
# Set all three OAuth values OR the service-account JSON, never both.
TWE_GOOGLE_OAUTH_CLIENT_ID=
TWE_GOOGLE_OAUTH_CLIENT_SECRET=
TWE_GOOGLE_OAUTH_REFRESH_TOKEN=
TWE_GOOGLE_DRIVE_MEDIA_FOLDER_ID=
# Faako-managed Resend credentials; non-production requires exact test recipients.
TWE_RESEND_API_KEY=
TWE_EMAIL_FROM=
# Optional staff invitation email delivery. Configure only after migration 015,
# verified Resend sender, and a supervised invitation-capable worker are live.
# Set identical secrets only within the same environment's API and worker.
# Never share a secret across staging and production or expose it to the browser.
TWE_INVITATION_DELIVERY_ENABLED=false
TWE_INVITATION_DELIVERY_SECRET=
# Worker only: real protected HTTPS staff portal origin, no trailing path.
TWE_INVITATION_PORTAL_ORIGIN=
# Base64url-encoded 32-byte secret shared only by this environment's API and
# notification worker. Rotating it expires outstanding questionnaire links.
TWE_ENQUIRY_CONTINUATION_SECRET=
# Enquiry routing is fixed: development/staging sends only to
# testing@travelwitheasegh.com; production sends to the saved customer email
# with notifications@travelwitheasegh.com in CC. No recipient override.
# Railway provides RAILWAY_GIT_COMMIT_SHA automatically for Git-linked deploys.
# Do not set a manual release SHA. Publication requires API/worker source parity.
TWE_PUBLIC_SITE_ORIGIN=
TWE_PUBLIC_API_ORIGIN=
# Private saved-draft builds run in this API process. Keep one API replica until
# a shared preview job store/sticky routing has been configured and tested.
TWE_CMS_PREVIEW_ENABLED=false
# Separate scheduled workers; never put provider credentials in PUBLIC_/VITE_.
TWE_PUBLICATION_WORKER_ENABLED=false
# Continuous publisher recovery poll; omit for the reviewed 15-second default.
TWE_PUBLICATION_POLL_INTERVAL_MS=15000
TWE_NOTIFICATION_WORKER_ENABLED=false
TWE_PAGES_PROJECT=twe-concierge
# develop on staging; main on production. This project hosts both branches.
TWE_PAGES_BRANCH=develop
TWE_PAGES_ACCOUNT_ID=
TWE_PAGES_API_TOKEN=
# One-time production content import only: an existing active production
# Owner/Superadmin UUID. Never copy an identity from staging.
TWE_PROMOTION_ACTOR_ID=
TWE_PUBLIC_TURNSTILE_SITE_KEY=
TWE_PUBLIC_SITE_INDEXABLE=false
TWE_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Server-only Turnstile secret for this environment's public enquiry widget.
# Never use Cloudflare dummy/test secrets on staging or production.
TWE_TURNSTILE_SECRET_KEY=
# Do not configure TWE_OIDC_* alongside Access. Both hosted API environments
# require runtime preflight; background workers remain separately gated.
