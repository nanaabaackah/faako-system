APP_ENV=development
PORT=3090
ALLOWED_ORIGINS=http://localhost:4328,http://localhost:5188
TWE_LOCAL_DATA_FILE=./data/development.json
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_TTL_SECONDS=21600
EXCHANGE_RATE_TIMEOUT_MS=5000
DATABASE_URL=
TWE_MIGRATION_DATABASE_URL=
TWE_ORGANISATION_ID=
# Verified TLS is the default. Use disable only for a loopback local/test DB.
TWE_DATABASE_TLS=require
TWE_DATABASE_CA=
# Separate disposable database; used only by test:db, never by the API.
TWE_TEST_DATABASE_URL=
# Set every OIDC field together only after the provider and MFA policy are chosen.
TWE_OIDC_ISSUER=
TWE_OIDC_CLIENT_ID=
TWE_OIDC_CLIENT_SECRET=
TWE_OIDC_MFA_ACR=
TWE_API_ORIGIN=
TWE_PORTAL_ORIGIN=
# Private draft media only. Bucket must start with twe-<APP_ENV>-.
TWE_R2_ACCOUNT_ID=
TWE_R2_ACCESS_KEY_ID=
TWE_R2_SECRET_ACCESS_KEY=
TWE_R2_PRIVATE_BUCKET=
# Faako-managed Resend credentials; non-production requires exact test recipients.
TWE_RESEND_API_KEY=
TWE_EMAIL_FROM=
TWE_EMAIL_RECIPIENT=
TWE_EMAIL_TEST_RECIPIENTS=
# Reviewed full Git SHA; build/confirm commands never deploy automatically.
TWE_RELEASE_SHA=
TWE_PUBLIC_SITE_ORIGIN=
TWE_PUBLIC_API_ORIGIN=
# Optional approved identity-provider pages (never application passwords).
TWE_OIDC_RECOVERY_URL=
TWE_OIDC_REGISTRATION_URL=
