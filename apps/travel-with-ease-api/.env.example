APP_ENV=development
PORT=3090
ALLOWED_ORIGINS=http://localhost:4328,http://localhost:5188
TWE_LOCAL_DATA_FILE=./data/development.json
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_CACHE_TTL_SECONDS=21600
EXCHANGE_RATE_TIMEOUT_MS=5000
DATABASE_URL=
TWE_MIGRATION_DATABASE_URL=
# Hosted predeploy approval must exactly match APP_ENV. No local .env is loaded.
TWE_MIGRATION_APPROVED_ENV=
# Enable only for reviewed first-time setup; disable after successful deployment.
TWE_DB_INITIALISE=false
TWE_ORGANISATION_NAME=
TWE_ORGANISATION_ID=
# Verified TLS is the default. Use disable only for a loopback local/test DB.
TWE_DATABASE_TLS=require
TWE_DATABASE_CA=
# Separate disposable database; used only by test:db, never by the API.
TWE_TEST_DATABASE_URL=
# Access is the only executable staff provider. Keep environment audiences separate.
# Set all fields only after Access allowlists and independent MFA are configured.
TWE_AUTH_MODE=
TWE_ACCESS_TEAM_DOMAIN=
TWE_ACCESS_AUDIENCE=
# Optional, independently verified installer subject for initial Owner invitations.
# Exact subject within the configured issuer/audience; never an email address.
# Remove after initial Owner activation. Blank disables installer issuance.
TWE_SETUP_OPERATOR_SUBJECT=
TWE_API_ORIGIN=
TWE_PORTAL_ORIGIN=
# Private draft media only. Bucket must start with twe-<APP_ENV>-.
TWE_R2_ACCOUNT_ID=
TWE_R2_ACCESS_KEY_ID=
TWE_R2_SECRET_ACCESS_KEY=
TWE_R2_PRIVATE_BUCKET=
# Faako-managed Resend credentials; non-production requires exact test recipients.
TWE_RESEND_API_KEY=
TWE_EMAIL_FROM=
# Intended staff notification recipient (To), not the environment CC mailbox.
TWE_EMAIL_RECIPIENT=
# Explicitly approved To addresses for development/staging; comma-separated.
# CC is automatically testing@travelwitheasegh.com outside production,
# notifications@travelwitheasegh.com in production.
TWE_EMAIL_TEST_RECIPIENTS=
# Reviewed full Git SHA required for publishing, not API startup.
TWE_RELEASE_SHA=
TWE_PUBLIC_SITE_ORIGIN=
TWE_PUBLIC_API_ORIGIN=
# Do not configure TWE_OIDC_* alongside Access. Both hosted API environments
# require runtime preflight; background workers remain separately gated.
