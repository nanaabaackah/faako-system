{
  "name": "@faako/stroane-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run predeploy:local && vite",
    "dev:frontend": "vite --host 0.0.0.0 --port 5175",
    "dev:storefront": "STROANE_BUILD_SURFACE=storefront VITE_APP_SURFACE=storefront vite --host 0.0.0.0 --port 5175",
    "dev:admin": "STROANE_BUILD_SURFACE=portal VITE_APP_SURFACE=portal vite --host 0.0.0.0 --port 5176",
    "dev:with-backend": "pnpm run predeploy:local && concurrently -k -n backend,frontend -c magenta,cyan \"pnpm run server:dev\" \"pnpm run dev:frontend\"",
    "build": "pnpm run build:storefront && pnpm run build:admin",
    "build:storefront": "STROANE_BUILD_SURFACE=storefront VITE_APP_SURFACE=storefront vite build --outDir dist/storefront && node scripts/finalize-storefront.mjs",
    "build:admin": "STROANE_BUILD_SURFACE=portal VITE_APP_SURFACE=portal vite build --outDir dist/admin && node scripts/finalize-admin.mjs",
    "build:api": "pnpm run db:generate",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test",
    "test:backend": "node --test backend/*.test.js",
    "test:security-foundation": "node --test backend/security.test.js src/components/serializeJsonLd.test.js",
    "test:e2e": "playwright test",
    "preview": "pnpm run preview:storefront",
    "preview:storefront": "vite preview --outDir dist/storefront --port 4175",
    "preview:admin": "vite preview --outDir dist/admin --port 4176",
    "db:generate": "prisma generate",
    "db:studio": "APP_ENV=development prisma studio",
    "db:migrate:dev": "APP_ENV=development prisma migrate dev",
    "db:status:dev": "APP_ENV=development prisma migrate status",
    "db:status:prod": "APP_ENV=production prisma migrate status",
    "db:deploy:dev": "APP_ENV=development prisma migrate deploy",
    "db:deploy:prod": "APP_ENV=production prisma migrate deploy",
    "db:deploy:stage": "APP_ENV=staging prisma migrate deploy",
    "db:status:stage": "APP_ENV=staging prisma migrate status",
    "db:seed:users:stage": "APP_ENV=staging node prisma/seed-users.mjs",
    "db:seed:catalogue:stage": "APP_ENV=staging node prisma/seed-catalogue.mjs",
    "db:sync:inventory:stage": "APP_ENV=staging STROANE_INVENTORY_BOOTSTRAP_APPLY=true node prisma/sync-inventory-items.mjs",
    "db:studio:stage": "APP_ENV=staging prisma studio",
    "predeploy:local": "pnpm run db:generate && pnpm run db:deploy:dev && pnpm run db:status:dev",
    "predeploy": "pnpm run predeploy:local",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "server:dev": "APP_ENV=development node backend/server.js",
    "server:prod": "APP_ENV=production node backend/server.js",
    "start:api": "APP_ENV=production node backend/server.js",
    "assets:cutout": "node scripts/remove-white-background.mjs",
    "db:seed": "APP_ENV=development node prisma/seed-users.mjs",
    "db:seed:prod": "APP_ENV=production node prisma/seed-users.mjs",
    "db:seed:catalogue": "node prisma/seed-catalogue.mjs",
    "db:seed:catalogue:plan": "STROANE_CATALOGUE_SEED_DRY_RUN=true STROANE_CATALOGUE_ARCHIVE_STALE=true node prisma/seed-catalogue.mjs",
    "db:seed:catalogue:reconcile": "STROANE_CATALOGUE_ARCHIVE_STALE=true node prisma/seed-catalogue.mjs",
    "db:sync:inventory": "node prisma/sync-inventory-items.mjs",
    "db:sync:inventory:apply": "STROANE_INVENTORY_BOOTSTRAP_APPLY=true node prisma/sync-inventory-items.mjs",
    "server:with-migrate": "pnpm run db:generate && pnpm run migrate:deploy && node backend/server.js",
    "postinstall": "node -e \"const hasDbUrl = Boolean(process.env.DATABASE_URL || process.env.DATABASE_URL_DEVELOPMENT || process.env.DATABASE_URL_PRODUCTION); const staticPagesInstall = Boolean(process.env.CF_PAGES); if (!staticPagesInstall && hasDbUrl) { require('child_process').execSync('prisma generate', { stdio: 'inherit' }); } else { console.log('Skipping prisma generate'); }\""
  },
  "dependencies": {
    "@faako/api-contracts": "workspace:*",
    "@faako/api-client": "workspace:*",
    "@faako/audit": "workspace:*",
    "@faako/core": "workspace:*",
    "@faako/notifications": "workspace:*",
    "@faako/offline-sync": "workspace:*",
    "@faako/security": "workspace:*",
    "@faako/logger": "workspace:*",
    "@faako/theme": "workspace:*",
    "@faako/types": "workspace:*",
    "@faako/ui": "workspace:*",
    "@faako/utils": "workspace:*",
    "@faako/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.2.0",
    "animejs": "^4.3.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "iconsax": "^0.0.1",
    "iconsax-react": "^0.0.8",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/express": "^4.17.22",
    "@types/node": "^20.12.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.18",
    "prisma": "^7.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.3.6"
  }
}
