generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Float
  inventory   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

enum SiteRole {
  ADMIN
  VIEWER
}

model SiteUser {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         SiteRole   @default(VIEWER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String?
  createdBy    SiteUser?  @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers SiteUser[] @relation("CreatedBy")
}
