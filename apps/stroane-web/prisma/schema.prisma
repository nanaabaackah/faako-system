generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Float
  inventory   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model CatalogueCategory {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String?
  tags        Json?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  products    CatalogueProduct[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, sortOrder])
}

model CatalogueProduct {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  categorySlug         String?
  category             CatalogueCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  subcategory          String?
  brand                String?
  sku                  String?            @unique
  shortDescription     String?
  longDescription      String?
  price                Decimal?           @db.Decimal(12, 2)
  priceLabel           String?
  currency             String             @default("GHS")
  unit                 String?
  image                String?
  images               Json?
  tag                  String?
  stockStatus          String             @default("unavailable")
  stockQuantity        Int?
  lowStockThreshold    Int?
  allowBackorder       Boolean            @default(false)
  isPurchasable        Boolean            @default(false)
  availability         String?
  quoteOnly            Boolean            @default(true)
  features             Json?
  specifications       Json?
  tags                 Json?
  useCases             Json?
  inquiryCta           String?
  sourceRefs           Json?
  isPublished          Boolean            @default(true)
  manualReviewRequired Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([categorySlug])
  @@index([isPublished, updatedAt])
  @@index([stockStatus])
  @@index([isPurchasable])
  @@index([name])
}

enum CatalogueInquiryStatus {
  RECEIVED
  IN_REVIEW
  RESPONDED
  ARCHIVED
  SPAM
}

model CatalogueInquiry {
  id           String                 @id
  status       CatalogueInquiryStatus @default(RECEIVED)
  name         String
  email        String?
  phone        String?
  businessName String?
  message      String
  productSlug  String?
  productName  String?
  source       String?
  userAgent    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  respondedAt  DateTime?
  archivedAt   DateTime?

  @@index([status, createdAt])
  @@index([productSlug])
  @@index([email])
}

enum CommerceOrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
}

model CommerceOrder {
  id               String              @id @default(cuid())
  orderNumber      String              @unique
  status           CommerceOrderStatus @default(PAYMENT_PENDING)
  customerName     String
  customerEmail    String
  customerPhone    String
  preferredContactMethod String?
  businessName     String?
  deliveryAddress  String
  deliveryNotes    String?
  currency         String              @default("GHS")
  subtotal         Decimal             @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  paymentProvider  String?
  paymentReference String?
  paymentStatus    String?
  paymentMetadata  Json?
  paymentConfirmationSource String?
  paymentWebhookEvent String?
  paymentWebhookReference String?
  paymentWebhookProcessedAt DateTime?
  paymentWebhookMetadata Json?
  source           String?
  userAgent        String?
  items            CommerceOrderItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paymentInitializedAt DateTime?
  paymentVerifiedAt    DateTime?
  paymentFailedAt      DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  fulfillmentStatus String?
  deliveryMethod   String?
  expectedDeliveryDate DateTime?
  adminDeliveryNotes String?
  internalNotes    String?
  statusUpdatedAt  DateTime?
  statusUpdatedById String?
  customerNotificationStatus String?
  customerNotificationType String?
  customerNotificationSentAt DateTime?
  customerNotificationProviderId String?
  customerNotificationError String?

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([paymentReference])
  @@index([paymentWebhookReference])
  @@index([fulfillmentStatus])
  @@index([statusUpdatedAt])
  @@index([customerNotificationStatus])
}

model CommerceOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug String
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal       @db.Decimal(12, 2)
  lineTotal   Decimal       @db.Decimal(12, 2)
  currency    String        @default("GHS")
  snapshot    Json?
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([productSlug])
}

model BusinessProfileContent {
  key       String   @id
  value     Json
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([isPublic])
}

enum SiteRole {
  ADMIN
  VIEWER
}

model SiteUser {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         SiteRole   @default(VIEWER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdById  String?
  createdBy    SiteUser?  @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers SiteUser[] @relation("CreatedBy")
}
