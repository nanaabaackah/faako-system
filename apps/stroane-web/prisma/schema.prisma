generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Float
  inventory   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

model CatalogueCategory {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String?
  tags        Json?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  products    CatalogueProduct[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, sortOrder])
}

model CatalogueProduct {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  categorySlug         String?
  category             CatalogueCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  subcategory          String?
  brand                String?
  sku                  String?            @unique
  shortDescription     String?
  longDescription      String?
  price                Decimal?           @db.Decimal(12, 2)
  compareAtPrice       Decimal?           @db.Decimal(12, 2)
  priceLabel           String?
  currency             String             @default("GHS")
  unit                 String?
  image                String?
  images               Json?
  tag                  String?
  stockStatus          String             @default("unavailable")
  stockQuantity        Int?
  availableQuantity    Int?
  reservedQuantity     Int?
  lowStockThreshold    Int?
  reorderThreshold     Int?
  allowBackorder       Boolean            @default(false)
  isPurchasable        Boolean            @default(false)
  availability         String?
  quoteOnly            Boolean            @default(true)
  features             Json?
  specifications       Json?
  tags                 Json?
  useCases             Json?
  inquiryCta           String?
  sourceRefs           Json?
  isPublished          Boolean            @default(true)
  publishingStatus     String             @default("active")
  isFeatured           Boolean            @default(false)
  manualReviewRequired Boolean            @default(false)
  supplierLinks        CatalogueProductSupplier[]
  inventoryItems       InventoryItem[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([categorySlug])
  @@index([isPublished, updatedAt])
  @@index([publishingStatus, updatedAt])
  @@index([isFeatured])
  @@index([stockStatus])
  @@index([isPurchasable])
  @@index([name])
}

model Supplier {
  id             String                     @id @default(cuid())
  name           String
  slug           String                     @unique
  status         String                     @default("active")
  email          String?
  phone          String?
  website        String?
  location       String?
  notes          String?
  contacts       SupplierContact[]
  productLinks   CatalogueProductSupplier[]
  inventoryItems InventoryItem[]
  movements      InventoryMovement[]
  auditEntries   InventoryAuditEntry[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status])
  @@index([name])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@index([email])
}

model CatalogueProductSupplier {
  id                  String            @id @default(cuid())
  productId           String?
  product             CatalogueProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug         String
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku         String?
  supplierProductName String?
  costPrice           Decimal?          @db.Decimal(12, 2)
  currency            String            @default("GHS")
  leadTimeDays        Int?
  minimumOrderQuantity Int?
  isPreferred         Boolean           @default(false)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([productSlug, supplierId])
  @@index([productId])
  @@index([productSlug])
  @@index([supplierId])
}

model InventoryItem {
  id                       String              @id @default(cuid())
  productId                String?
  product                  CatalogueProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSlug              String
  variantId                String?
  sku                      String?
  supplierId               String?
  supplier                 Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantityOnHand           Int?
  reservedQuantity         Int?
  availableQuantity        Int?
  reorderThreshold         Int?
  lowStockThreshold        Int?
  stockStatus              String              @default("unavailable")
  inventoryTrackingEnabled Boolean             @default(true)
  allowBackorder           Boolean?
  isPurchasable            Boolean?
  lastCountedAt            DateTime?
  lastRestockedAt          DateTime?
  notes                    String?
  movements                InventoryMovement[]
  auditEntries             InventoryAuditEntry[]
  alerts                   InventoryAlert[]
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([productSlug, variantId])
  @@index([productId])
  @@index([productSlug])
  @@index([variantId])
  @@index([stockStatus])
  @@index([inventoryTrackingEnabled])
  @@index([supplierId])
}

model InventoryAlert {
  id                        String                   @id @default(cuid())
  inventoryItemId           String
  inventoryItem             InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  alertType                 String
  status                    String                   @default("ACTIVE")
  reason                    String?
  availableQuantity         Int?
  reservedQuantity          Int?
  reorderThreshold          Int?
  firstDetectedAt           DateTime                 @default(now())
  lastDetectedAt            DateTime                 @default(now())
  lastNotificationAttemptAt DateTime?
  lastNotifiedAt            DateTime?
  notificationCount         Int                      @default(0)
  resolvedAt                DateTime?
  dispatches                InventoryAlertDispatch[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@unique([inventoryItemId, alertType])
  @@index([status, alertType])
  @@index([lastNotifiedAt])
}

model InventoryAlertDispatch {
  id             String          @id @default(cuid())
  alertId        String?
  alert          InventoryAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  batchKey       String
  trigger        String
  alertType      String
  channel        String
  status         String
  recipientCount Int             @default(0)
  providerId     String?
  error          String?
  payloadSummary Json?
  createdAt      DateTime        @default(now())

  @@index([alertId])
  @@index([batchKey])
  @@index([channel, status])
  @@index([createdAt])
}

model InventoryMovement {
  id              String         @id @default(cuid())
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  productSlug     String
  variantId       String?
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movementType    String
  quantityDelta   Int
  quantityBefore  Int?
  quantityAfter   Int?
  reservedBefore  Int?
  reservedAfter   Int?
  reason          String?
  referenceType   String?
  referenceId     String?
  supplierNote    String?
  purchaseNote    String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime       @default(now())

  @@index([inventoryItemId])
  @@index([productSlug])
  @@index([variantId])
  @@index([supplierId])
  @@index([movementType])
  @@index([createdAt])
}

model InventoryAuditEntry {
  id              String         @id @default(cuid())
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  action          String
  entityType      String
  entityId        String?
  productSlug     String?
  variantId       String?
  beforeState     Json?
  afterState      Json?
  note            String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime       @default(now())

  @@index([inventoryItemId])
  @@index([supplierId])
  @@index([productSlug])
  @@index([action])
  @@index([createdAt])
}

enum CatalogueInquiryStatus {
  RECEIVED
  IN_REVIEW
  RESPONDED
  ARCHIVED
  SPAM
}

model CatalogueInquiry {
  id           String                 @id
  status       CatalogueInquiryStatus @default(RECEIVED)
  name         String
  email        String?
  phone        String?
  businessName String?
  message      String
  productSlug  String?
  productName  String?
  source       String?
  userAgent    String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  respondedAt  DateTime?
  archivedAt   DateTime?

  @@index([status, createdAt])
  @@index([productSlug])
  @@index([email])
}

enum CommerceOrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CustomerAccountStatus {
  INVITED
  ACTIVE
  LOCKED
}

model CustomerAccount {
  id                     String                @id @default(cuid())
  email                  String                @unique
  passwordHash           String?
  status                 CustomerAccountStatus @default(INVITED)
  name                   String
  phone                  String?
  businessName           String?
  preferredContactMethod String?
  defaultDeliveryAddress String?
  deliveryNotes          String?
  inviteTokenHash        String?               @unique
  inviteExpiresAt        DateTime?
  invitedAt              DateTime?
  passwordResetTokenHash String?               @unique
  passwordResetExpiresAt DateTime?
  passwordResetRequestedAt DateTime?
  activatedAt            DateTime?
  lastLoginAt            DateTime?
  createdById            String?
  createdBy              SiteUser?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orders                 CommerceOrder[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([inviteExpiresAt])
  @@index([passwordResetExpiresAt])
}

model CommerceOrder {
  id               String              @id @default(cuid())
  orderNumber      String              @unique
  status           CommerceOrderStatus @default(PAYMENT_PENDING)
  customerId        String?
  customerAccount   CustomerAccount?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerEmail    String
  customerPhone    String
  preferredContactMethod String?
  businessName     String?
  deliveryAddress  String
  deliveryPlaceId  String?
  deliveryLocationLabel String?
  deliveryLocationProvider String?
  deliveryLatitude Decimal?            @db.Decimal(10, 7)
  deliveryLongitude Decimal?           @db.Decimal(10, 7)
  deliveryMapUrl   String?
  deliveryNotes    String?
  currency         String              @default("GHS")
  subtotal         Decimal             @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  paymentProvider  String?
  paymentReference String?
  paymentStatus    String?
  paymentMetadata  Json?
  paymentConfirmationSource String?
  paymentWebhookEvent String?
  paymentWebhookReference String?
  paymentWebhookProcessedAt DateTime?
  paymentWebhookMetadata Json?
  source           String?
  userAgent        String?
  items            CommerceOrderItem[]
  receipts         CommerceReceipt[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  paymentInitializedAt DateTime?
  paymentVerifiedAt    DateTime?
  paymentFailedAt      DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  fulfillmentStatus String?
  deliveryMethod   String?
  expectedDeliveryDate DateTime?
  adminDeliveryNotes String?
  internalNotes    String?
  statusUpdatedAt  DateTime?
  statusUpdatedById String?
  customerNotificationStatus String?
  customerNotificationType String?
  customerNotificationSentAt DateTime?
  customerNotificationProviderId String?
  customerNotificationError String?

  @@index([status, createdAt])
  @@index([customerId])
  @@index([customerEmail])
  @@index([deliveryPlaceId])
  @@index([paymentReference])
  @@index([paymentWebhookReference])
  @@index([fulfillmentStatus])
  @@index([statusUpdatedAt])
  @@index([customerNotificationStatus])
}

model CommerceOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSlug String
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal       @db.Decimal(12, 2)
  lineTotal   Decimal       @db.Decimal(12, 2)
  currency    String        @default("GHS")
  snapshot    Json?
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([productSlug])
}

model CommerceReceipt {
  id               String        @id @default(cuid())
  receiptNumber    String        @unique
  orderId          String
  order            CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           String        @default("issued")
  customerName     String
  customerEmail    String
  currency         String        @default("GHS")
  subtotal         Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  paymentReference String?
  paymentStatus    String?
  issuedAt         DateTime      @default(now())
  sentAt           DateTime?
  downloadedAt     DateTime?
  resendStatus     String?
  resendProviderId String?
  resendError      String?
  notes            String?
  createdById      String?
  createdByName    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([customerEmail])
  @@index([status, issuedAt])
  @@index([issuedAt])
}

enum AccountingLedgerEntryType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
  ADJUSTMENT
}

model AccountingLedgerEntry {
  id            String                    @id @default(cuid())
  entryType     AccountingLedgerEntryType
  category      String
  expenseClass  String?
  counterparty  String?
  description   String
  amount        Decimal                   @db.Decimal(12, 2)
  currency      String                    @default("GHS")
  entryDate     DateTime
  dueDate       DateTime?
  paymentStatus String?
  source        String                    @default("manual_lump_sum")
  reference     String?
  notes         String?
  status        String                    @default("active")
  createdById   String?
  createdByName String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([entryType, entryDate])
  @@index([status, entryDate])
  @@index([expenseClass])
  @@index([paymentStatus])
  @@index([dueDate])
  @@index([category])
  @@index([createdAt])
}

model BusinessProfileContent {
  key       String   @id
  value     Json
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([isPublic])
}

enum SiteRole {
  ADMIN
  OWNER
  VIEWER
  CUSTOM
}

model PortalRole {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  permissions Json
  isSystem    Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       SiteUser[]

  @@index([isActive])
  @@index([isSystem])
}

model SiteUser {
  id                   String     @id @default(cuid())
  username             String     @unique
  passwordHash         String
  role                 SiteRole   @default(VIEWER)
  customRoleId         String?
  customRole           PortalRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  isActive             Boolean    @default(true)
  firstName            String?
  lastName             String?
  personalEmail        String?
  phone                String?
  jobTitle             String?
  department           String?
  bio                  String?
  avatarUrl            String?
  appearancePreference String     @default("system")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  createdById          String?
  createdBy            SiteUser?  @relation("CreatedBy", fields: [createdById], references: [id])
  createdUsers         SiteUser[] @relation("CreatedBy")
  createdCustomers     CustomerAccount[] @relation("CustomerCreatedBy")

  @@index([personalEmail])
  @@index([customRoleId])
}
