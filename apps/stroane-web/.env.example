# Frontend
# Leave blank when the API is served from the same origin.
# Set this to the deployed backend URL when the API is hosted separately.
VITE_BACKEND_BASE_URL=http://localhost:3000

# Preview access gate
VITE_AUTH_USERNAME=
VITE_AUTH_PASSWORD=

# Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/stroane
CORS_ORIGINS=http://localhost:5175
# Set to the number of trusted reverse-proxy hops in production, for example 1.
TRUST_PROXY_HOPS=
