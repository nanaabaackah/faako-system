# Frontend
# Leave blank when the API is served from the same origin.
# Set this to the deployed backend URL when the API is hosted separately.
VITE_API_BASE_URL=http://localhost:3000
# Legacy fallback only. Prefer VITE_API_BASE_URL for new catalogue/API wiring.
VITE_BACKEND_BASE_URL=
# Cloudflare Pages surface: storefront or portal. Leave blank for local
# development so localhost can expose both route areas for testing.
VITE_APP_SURFACE=
VITE_STOREFRONT_BASE_URL=https://example.com
VITE_PORTAL_BASE_URL=https://portal.example.com
VITE_GA_MEASUREMENT_ID=
VITE_ENABLE_GA_IN_DEV=false

# Backend
NODE_ENV=development
APP_ENV=development
PORT=3000
# Use DATABASE_URL for Railway Postgres single-env deployments.
# Use DATABASE_URL_DEVELOPMENT / DATABASE_URL_PRODUCTION when you want strict environment separation.
DATABASE_URL=postgresql://user:password@localhost:5432/app_db
DATABASE_URL_DEVELOPMENT=postgresql://user:password@localhost:5432/app_dev
DATABASE_URL_PRODUCTION=
CORS_ORIGINS=http://localhost:5175
# Set to the number of trusted reverse-proxy hops in production, for example 1.
TRUST_PROXY_HOPS=
# Backend token signing for private admin/viewer auth. Keep server-side only.
APP_AUTH_SECRET=

# Future inquiry notification values. Not used by the current backend yet.
# Keep provider API keys server-side only; never expose them as VITE_* values.
INQUIRY_NOTIFICATION_EMAIL=hello@example.com

# Customer-safe order confirmation email after verified payment.
# Keep the provider API key server-side only; never expose it as a VITE_* value.
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM="Example Store <orders@example.com>"
ORDER_NOTIFICATION_REPLY_TO=hello@example.com
# Non-production emails are delivered here instead of input/customer addresses.
EMAIL_FORCE_TO=dev@nanaabaackah.com

# Private inventory-owner alerting. Keep recipient details and scheduler secrets
# on the API service only; never expose them as VITE_* values.
APP_ALERT_EMAILS=owner@example.com
APP_ALERT_WHATSAPP_NUMBERS=
APP_ALERT_FROM="Example Store Operations <alerts@example.com>"
APP_ALERT_REPLY_TO=hello@example.com
# Minimum delay before the same active stock warning can be attempted again.
APP_ALERT_COOLDOWN_MINUTES=720
# Private bearer secret for a Railway cron/scheduler calling the internal route.
APP_ALERT_CRON_SECRET=

# Paystack checkout initialization, return-page status checks, and signed webhook confirmation.
# Keep secret values server-side only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with your Paystack secret key. Leave this blank to use
# PAYSTACK_SECRET_KEY, or set the same backend-only signing secret explicitly.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=
PAYSTACK_CURRENCY=GHS
# Keep false/blank for test mode. Set true only when intentionally using sk_live_*.
PAYSTACK_ALLOW_LIVE=false
