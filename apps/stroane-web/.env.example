# Frontend
# Leave blank when the API is served from the same origin.
# Set this to the deployed backend URL when the API is hosted separately.
VITE_BACKEND_BASE_URL=http://localhost:3000

# Backend
NODE_ENV=development
APP_ENV=development
PORT=3000
# Use DATABASE_URL for Railway Postgres single-env deployments.
# Use DATABASE_URL_DEVELOPMENT / DATABASE_URL_PRODUCTION when you want strict environment separation.
DATABASE_URL=postgresql://user:password@localhost:5432/stroane
DATABASE_URL_DEVELOPMENT=postgresql://user:password@localhost:5432/stroane_dev
DATABASE_URL_PRODUCTION=
CORS_ORIGINS=http://localhost:5175
# Set to the number of trusted reverse-proxy hops in production, for example 1.
TRUST_PROXY_HOPS=
# Backend token signing for private SiteUser admin/viewer auth. Keep server-side only.
STROANE_AUTH_SECRET=

# Optional monitoring/deployment metadata. Do not put secrets in these.
STROANE_WEB_BASE_URL=https://stroanesolutions.com
STROANE_API_BASE_URL=
STROANE_BACKEND_BASE_URL=

# Future inquiry notification values. Not used by the current backend yet.
# Keep provider API keys server-side only; never expose them as VITE_* values.
INQUIRY_NOTIFICATION_EMAIL=info@stroanesolutions.com

# Customer-safe order confirmation email after verified payment.
# Keep the provider API key server-side only; never expose it as a VITE_* value.
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM="Stroane Solutions <orders@stroanesolutions.com>"
ORDER_NOTIFICATION_REPLY_TO=info@stroanesolutions.com

# Paystack checkout initialization, return-page status checks, and signed webhook confirmation.
# Keep secret values server-side only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack signs webhooks with your Paystack secret key. Leave this blank to use
# PAYSTACK_SECRET_KEY, or set the same backend-only signing secret explicitly.
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=
PAYSTACK_CURRENCY=GHS
# Keep false/blank for test mode. Set true only when intentionally using sk_live_*.
PAYSTACK_ALLOW_LIVE=false
