---
import "@faako/theme/system.css";
import "@faako/ui/compat.css";
import "../styles/global.css";
import "../styles/components/base.css";
import "../styles/components/shared.css";
import "../styles/components/editorial.css";
import "../styles/components/interactions.css";
import "../styles/components/motion.css";
import { organization } from "../content/home.js";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import CookieNotice from "../components/CookieNotice.astro";
import FloatingUtilities from "../components/FloatingUtilities.astro";
import SiteSearch from "../components/SiteSearch.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import { isIndexable, productionOrigin } from "../lib/indexability.js";
import { socialMetadata } from "../lib/social-metadata.js";
import { imageMetadata } from "astro/assets/utils";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { personSchema, articleSchema, eventSchema } from "../lib/page-schema.js";
import {
  buildBreadcrumbList,
  buildFaqPage,
  canonicalUrl,
  normalizeDiscoveryPath,
  serializeJsonLd,
} from "@faako/discovery";

const {
  title = `${organization.name} | Mental health advocacy and support in Ghana`,
  description = organization.seo?.description || "The Thriving Network GH advances mental wellness through education, counselling, advocacy, community support, research, and policy engagement.",
  path = Astro.url.pathname,
  overlayHeader = false,
  pageStyles = [],
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  seo = {},
  breadcrumbs = [],
  faqItems = [],
  noIndex = false,
  people = [],
  article,
  event,
} = Astro.props;

const siteUrl = new URL(productionOrigin);
const normalizedPath = normalizeDiscoveryPath(path);
const canonical = canonicalUrl(normalizedPath, siteUrl);
const isPreviewDomain = !isIndexable(Astro.site || Astro.url, import.meta.env.PUBLIC_SITE_INDEXABLE);
const social = socialMetadata({ title, description, path: normalizedPath, seo, siteSeo: organization.seo, image: image ? { url: image, alt: imageAlt || title, width: imageWidth, height: imageHeight } : undefined, article: Boolean(article) });
const absoluteImage = social.image.url;
if (new URL(absoluteImage).origin === productionOrigin) {
  const bytes = await readFile(resolve("public", `.${new URL(absoluteImage).pathname}`));
  Object.assign(social.image, await imageMetadata(bytes, absoluteImage));
}
const graph = [
  ...people.map(person => personSchema(person, siteUrl)),
  ...[articleSchema(article), eventSchema(event)].filter(Boolean),
  {
    "@type": "NGO",
    "@id": new URL("/#organization", siteUrl).toString(),
    name: organization.name,
    alternateName: organization.shortName,
    slogan: organization.tagline,
    description: "The Thriving Network GH advances mental wellness through education, counselling, advocacy, community support, research, and policy engagement.",
    url: siteUrl.toString(),
    logo: new URL("/ttngh-logo-transparent.png", siteUrl).toString(),
    image: absoluteImage,
    foundingDate: "2023-07",
    founder: { "@type": "Person", name: "Anthonia Nonye Tony-Dibie" },
    address: {
      "@type": "PostalAddress",
      postOfficeBoxNumber: "CO 4743",
      addressLocality: "Tema",
      addressCountry: "GH",
    },
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "general enquiries",
      email: organization.email,
      telephone: organization.phoneHref,
      areaServed: "GH",
      availableLanguage: "English",
    },
    sameAs: organization.socials.filter((social) => social.href).map((social) => social.href),
  },
  {
    "@type": "WebSite",
    "@id": new URL("/#website", siteUrl).toString(),
    name: organization.name,
    url: siteUrl.toString(),
    publisher: { "@id": new URL("/#organization", siteUrl).toString() },
  },
  {
    "@type": "WebPage",
    "@id": canonical,
    name: title,
    description,
    url: canonical,
    isPartOf: { "@id": new URL("/#website", siteUrl).toString() },
    about: { "@id": new URL("/#organization", siteUrl).toString() },
    primaryImageOfPage: { "@type": "ImageObject", url: absoluteImage, caption: social.image.alt },
  },
];

if (breadcrumbs.length) {
  graph.push(buildBreadcrumbList(breadcrumbs, siteUrl));
}

if (faqItems.length) {
  graph.push(buildFaqPage(faqItems));
}

const structuredData = serializeJsonLd({ "@context": "https://schema.org", "@graph": graph });
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "";
---

<!doctype html>
<html lang="en-GH" data-faako-theme="ttngh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={organization.name} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <meta name="robots" content={isPreviewDomain || noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon_io/site.webmanifest" />
    {pageStyles.map((href) => <link rel="stylesheet" href={href} />)}
    <meta property="og:locale" content="en_GH" />
    <meta property="og:type" content={social.type} />
    <meta property="og:site_name" content={organization.name} />
    <meta property="og:title" content={social.title} />
    <meta property="og:description" content={social.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content={social.image.width} />
    <meta property="og:image:height" content={social.image.height} />
    <meta property="og:image:alt" content={social.image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={social.title} />
    <meta name="twitter:description" content={social.description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={social.image.alt} />
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body id="top" class:list={{ "has-overlay-header": overlayHeader }}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <FloatingUtilities />
    <SiteSearch />
    <CookieNotice />
    <AnalyticsConsent />
    <script>import "../scripts/editorial-motion";</script>
  </body>
</html>
