---
import Icon from "./Icon.jsx";
import "../styles/components/team-grid.css";
import { team } from "../content/team.js";
---
{team.length > 0 ? (
  <div class="team-grid">{team.map(member => (
    <article class="team-member">
      <img src={member.image} alt={member.alt || member.name} width="800" height="1000" loading="lazy" decoding="async" />
      <h3>{member.name}</h3>
      <p>{member.role}</p>
      {member.biography && <p class="team-biography">{member.biography}</p>}
      {member.publicLinks?.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <Icon name="external" /></a>)}
    </article>
  ))}</div>
) : (
  <p class="team-empty">Team profiles are not available yet. <a href="/contact">Contact the team</a>.</p>
)}
