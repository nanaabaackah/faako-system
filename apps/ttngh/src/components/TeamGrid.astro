---
import Icon from "./Icon.jsx";
import { team } from "../content/team.js";
---
<div class="team-grid">{team.map(member => <article class="team-member"><img src={member.image} alt={member.alt||member.name} width="800" height="1000" loading="lazy" decoding="async" /><h3>{member.name}</h3><p>{member.role}</p>{member.biography&&<p class="team-biography">{member.biography}</p>}{member.publicLinks?.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <Icon name="external" /></a>)}</article>)}</div>
<style>
.team-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:2.5rem 1.5rem}.team-member img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 25%;border-radius:8px}.team-member h3{margin:.9rem 0 .3rem;font-size:1rem;line-height:1.4}.team-member p{margin:0;font-size:.85rem;color:var(--muted)}
.team-member .team-biography{grid-column:1/-1;margin-top:1rem}
@media(max-width:900px){.team-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){.team-grid{grid-template-columns:1fr;gap:1.5rem}.team-member{display:grid;grid-template-columns:95px 1fr;column-gap:1rem;align-content:center}.team-member img{grid-row:1/3}.team-member h3{align-self:end;margin:0 0 .3rem}.team-member p{grid-column:2}}
</style>
