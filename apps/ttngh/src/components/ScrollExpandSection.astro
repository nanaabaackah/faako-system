---
import "../styles/components/scroll-expand.css";
import { FaArrowRight } from "react-icons/fa6";

const {
  image,
  alt = "",
  eyebrow = "",
  title,
  text,
  href = "/contact",
  linkLabel = "Contact us",
  frameTitle = "Peace over everything.",
  id = "scroll-expand-title",
} = Astro.props;
---

<scroll-expand-section class:list={["scroll-expand", { "scroll-expand--colour": !image }]} data-scroll-expand>
  <div class="scroll-expand__track">
    <section class="scroll-expand__stage" aria-labelledby={id}>
      <div class="scroll-expand__frame">
        {image && <img class="scroll-expand__media" src={image} alt={alt} width="1600" height="1066" loading="lazy" decoding="async" />}
        <div class="scroll-expand__scrim" aria-hidden="true"></div>
        <div class="scroll-expand__overlay">
          <p class="eyebrow">{eyebrow}</p>
          <h2 id={id}>{title}</h2>
          {text && <p>{text}</p>}
          <a class="button button-primary" href={href}><span class="button-label">{linkLabel}</span><span class="button-icon" aria-hidden="true"><FaArrowRight focusable="false" /></span></a>
        </div>
      </div>
      <p class="scroll-expand__title" aria-hidden="true">{frameTitle}</p>
      <p class="scroll-expand__hint" aria-hidden="true">Scroll to open</p>
    </section>
  </div>
</scroll-expand-section>

<script>
  // Motion model adapted from React Bits' Scroll Expand component.
  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
  const smoothstep = (start, end, value) => {
    const progress = clamp((value - start) / (end - start || 0.000001), 0, 1);
    return progress * progress * (3 - 2 * progress);
  };

  class ScrollExpandElement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";

      const track = this.querySelector(".scroll-expand__track");
      const stage = this.querySelector(".scroll-expand__stage");
      const frame = this.querySelector(".scroll-expand__frame");
      const media = this.querySelector(".scroll-expand__media");
      const scrim = this.querySelector(".scroll-expand__scrim");
      const overlay = this.querySelector(".scroll-expand__overlay");
      const title = this.querySelector(".scroll-expand__title");
      const hint = this.querySelector(".scroll-expand__hint");
      if (!track || !stage || !frame || !scrim || !overlay || !title || !hint) return;

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let stageHeight = 0;
      let frameId = 0;
      let active = true;

      const apply = (progress) => {
        const eased = smoothstep(0, 1, progress);
        const mobile = window.innerWidth < 700;
        const startWidth = mobile ? 86 : 52;
        const startHeight = mobile ? 54 : 58;
        const width = startWidth + (100 - startWidth) * eased;
        const height = startHeight + (100 - startHeight) * eased;
        const insetX = Math.max(0, (100 - width) / 2);
        const insetY = Math.max(0, (100 - height) / 2);
        const radius = 30 * (1 - eased);

        frame.style.clipPath = `inset(${insetY}% ${insetX}% ${insetY}% ${insetX}% round ${radius}px)`;
        if (media) media.style.transform = `scale(${1.18 - 0.18 * eased})`;
        scrim.style.opacity = `${0.86 * eased}`;

        const titleOut = smoothstep(0.34, 0.82, progress);
        title.style.opacity = `${1 - titleOut}`;
        title.style.transform = `translate3d(0, ${-24 * titleOut}px, 0)`;
        hint.style.opacity = `${1 - smoothstep(0, 0.14, progress)}`;

        const overlayIn = smoothstep(0.64, 1, progress);
        overlay.style.opacity = `${overlayIn}`;
        overlay.style.transform = `translate3d(0, ${18 * (1 - overlayIn)}px, 0)`;
      };

      const measure = () => {
        stageHeight = Math.max(560, window.innerHeight);
        stage.style.height = `${stageHeight}px`;
        track.style.height = reduceMotion ? `${stageHeight}px` : `${stageHeight * 2.05}px`;
        update();
      };

      const update = () => {
        if (!active) return;
        cancelAnimationFrame(frameId);
        frameId = requestAnimationFrame(() => {
          const progress = reduceMotion ? 1 : clamp(-track.getBoundingClientRect().top / (stageHeight * 0.9), 0, 1);
          apply(progress);
        });
      };

      const observer = new IntersectionObserver(([entry]) => {
        active = entry.isIntersecting;
        if (active) update();
      }, { rootMargin: "100px" });

      observer.observe(this);
      measure();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", measure, { passive: true });
    }
  }

  if (!customElements.get("scroll-expand-section")) {
    customElements.define("scroll-expand-section", ScrollExpandElement);
  }
</script>
