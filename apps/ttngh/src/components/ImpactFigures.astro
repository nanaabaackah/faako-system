---
import { verifiedImpact } from "../lib/verified-impact.js";
const { stats = [] } = Astro.props;
const verified = verifiedImpact(stats);
---
{verified.length ? <div class="impact-figures">{verified.map(stat => <article class="impact-figure"><strong>{stat.value}</strong><p>{stat.label}</p><p class="impact-meta">{stat.period} · Source: {stat.source}</p></article>)}</div> : <p class="impact-pending">Verified impact figures will be published here.</p>}
