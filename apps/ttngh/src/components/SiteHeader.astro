---
import Icon from "./Icon.jsx";
import { organization } from "../content/home.js";
import "../styles/components/navigation.css";
const links = [
  ["About", "/about"], ["Events", "/events"], ["News", "/news"], ["Contact", "/contact"],
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="site-header">
  <a class="header-logo" href="/" aria-label={organization.name + " home"}><img src="/ttngh-logo-transparent.png" alt={organization.name} width="1927" height="816" /></a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {links.map(([label, href]) => <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>)}
  </nav>
  <button class="header-search" type="button" data-search-open aria-label="Search the site"><Icon name="search" aria-hidden="true" /></button>
  <a class="header-donate" href="/get-involved">Collaborate <span aria-hidden="true"><Icon name="external" /></span></a>
  <details class="compact-menu">
    <summary aria-label="Navigation menu"><span class="menu-bars" aria-hidden="true"><Icon name="menu" /></span><span>Menu</span></summary>
    <nav class="compact-menu-panel" aria-label="Mobile navigation">
      {links.map(([label, href]) => <a href={href} aria-current={path === href ? "page" : undefined}>{label}<span aria-hidden="true"><Icon name="external" /></span></a>)}
      <div class="compact-menu-secondary"><a href="/programmes">Programmes</a><a href="/get-involved">Get involved</a><a href="/team">Our team</a><a href="/impact">Our impact</a><a href="/support-us">Support / Donate</a><button type="button" data-search-open>Search the site</button></div>
    </nav>
  </details>
</header>
<script>
  const menu = document.querySelector(".compact-menu");
  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener("toggle", () => document.body.classList.toggle("menu-open", menu.open));
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && menu.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
    });
    document.addEventListener("click", event => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.querySelectorAll("a, button").forEach(item => item.addEventListener("click", () => { menu.open = false; }));
  }
</script>
