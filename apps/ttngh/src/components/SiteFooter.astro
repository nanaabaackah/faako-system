---
import { organization } from "../content/home.js";
import SharedFaakoFooter from "./SharedFaakoFooter.jsx";
import SocialIcon from "./SocialIcon.jsx";
import { FaArrowRight, FaMagnifyingGlass } from "react-icons/fa6";
import "../styles/components/footer.css";
---

<footer class="site-footer">
  <div class="site-footer-panel">
    <div class="footer-action-strips">
      <a class="footer-contact-strip" href="/contact"><span>Contact us</span><span class="footer-strip-icon" aria-hidden="true"><FaArrowRight focusable="false" /></span></a>
    </div>

    <div class="footer-main">
      <div class="footer-statement">
        <h2>Get in touch.</h2>
        <button class="footer-search-box" type="button" data-search-open aria-haspopup="dialog" aria-controls="site-search-dialog">
          <span>Search the site</span>
          <span class="footer-search-icon" aria-hidden="true"><FaMagnifyingGlass focusable="false" /></span>
        </button>
      </div>

      <div class="footer-details">
        <dl>
          <div><dt>Based in</dt><dd>{organization.location}</dd></div>
          <div><dt>Phone</dt><dd><a href={`tel:${organization.phoneHref}`}>{organization.phoneDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${organization.email}`}>{organization.email}</a></dd></div>
        </dl>

        <nav class="footer-navigation" aria-label="Footer navigation">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/team">Our team</a>
          <a href="/programmes">Programs</a>
          <a href="/events">Events</a>
          <a href="/news">News</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </div>

    <ul class="footer-social" aria-label="Social media">
      {organization.socials.map((social) => (
        <li>
          {social.href ? (
            <a href={social.href} target="_blank" rel="noreferrer noopener" aria-label={`${social.platform}: ${social.label}`} title={`${social.platform}: ${social.label}`}>
              <SocialIcon name={social.icon} />
            </a>
          ) : (
            <span aria-label={`${social.platform}: ${social.label}`} title={`${social.platform}: ${social.label}`}>
              <SocialIcon name={social.icon} />
            </span>
          )}
        </li>
      ))}
    </ul>

    <div class="footer-bottom">
      <div class="footer-legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <button type="button" data-cookie-settings>Cookie notice</button>
      </div>
      <SharedFaakoFooter businessName={organization.name} />
      <a href="#top">Back to top</a>
    </div>
  </div>
</footer>
