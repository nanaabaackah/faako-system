---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "";
---

<div data-analytics-config data-measurement-id={measurementId} hidden></div>

<script>
  import {
    initializeGoogleAnalytics,
    setGoogleAnalyticsConsent,
    trackGoogleAnalyticsPageView,
  } from "@faako/utils";

  const storageKey = "ttngh-cookie-consent-v1";
  const config = document.querySelector("[data-analytics-config]");
  const measurementId = config?.getAttribute("data-measurement-id")?.trim() || "";
  let started = false;

  const readConsent = () => {
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) || "null");
      return saved?.essential === true && typeof saved.analytics === "boolean" ? saved : null;
    } catch {
      return null;
    }
  };

  const applyConsent = (analytics: boolean) => {
    if (!measurementId) return;

    if (!analytics) {
      setGoogleAnalyticsConsent(measurementId, { analytics: false, marketing: false });
      return;
    }

    if (!started) {
      started = initializeGoogleAnalytics({
        measurementId,
        consent: { analytics: true, marketing: false },
        respectDoNotTrack: true,
      });
    } else {
      setGoogleAnalyticsConsent(measurementId, { analytics: true, marketing: false });
    }

    if (started) trackGoogleAnalyticsPageView({ measurementId });
  };

  const savedConsent = readConsent();
  if (savedConsent) applyConsent(savedConsent.analytics);

  document.addEventListener("ttngh:consent-changed", (event) => {
    const detail = (event as CustomEvent<{ analytics?: boolean }>).detail;
    const analytics = Boolean(detail?.analytics);
    applyConsent(analytics);
  });
</script>
