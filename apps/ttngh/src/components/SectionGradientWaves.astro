---
import GradientWaves from "./GradientWaves/GradientWaves.jsx";
import "../styles/components/section-gradient-waves.css";
---

<div class="section-gradient-waves" aria-hidden="true">
  <GradientWaves
    client:load
    horizonColor="#fff8fb"
    waveColor="#e52477"
    crestColor="#ffc3dd"
    speed={0.15}
    amplitude={3.8}
    waveScale={0.6}
    waveRatio={0.9}
    swell={5}
    turbulence={18}
    tilt={1.08}
    zoom={1.02}
    height={4.2}
    fogDepth={140}
    detail="low"
    brightness={1.04}
    opacity={0.9}
    mouseInteraction={false}
    parallaxStrength={0}
    grain={false}
    grainIntensity={0}
    maxFps={15}
  />
</div>
