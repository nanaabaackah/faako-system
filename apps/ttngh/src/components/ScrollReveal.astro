---
import "../styles/components/scroll-reveal.css";
---
<script>
  // Gentle blur/translate reveal inspired by React Bits Scroll Reveal,
  // implemented without hydrating static content into React.
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  const nodes = [...document.querySelectorAll<HTMLElement>("main > section:not(.home-hero):not(.page-hero), .home-calendar, .programme-row")];
  if (!motion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        const node = entry.target as HTMLElement;
        node.classList.toggle("is-revealed", entry.isIntersecting);
      });
    }, { threshold: 0, rootMargin: "0px 0px -30px 0px" });
    nodes.forEach(node => {
      // Never conceal first-view content or a focused descendant.
      if (node.getBoundingClientRect().top < innerHeight) return;
      node.classList.add("scroll-reveal");
      observer.observe(node);
    });
    motion.addEventListener("change", () => {
      if (motion.matches) { observer.disconnect(); nodes.forEach(node => node.classList.remove("scroll-reveal")); }
    });
  }
</script>
