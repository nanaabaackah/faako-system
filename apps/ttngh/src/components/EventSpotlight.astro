---
import Icon from "./Icon.jsx";
import { eventPath, formatEventDate, eventRegistrationLabel } from "../lib/events.js";
import "../styles/components/event-spotlight.css";
const { event, previous = false } = Astro.props;
const id = previous ? "previous-event" : "next-up";
---
<section id={id} class:list={["event-spotlight", { "event-spotlight--previous": previous }]} data-reveal aria-labelledby={`${id}-title`}>
  <header><h2 id={`${id}-title`}>{previous ? "Previous event" : "Next up"}</h2></header>
  <div class="event-spotlight__layout">
    <a class="event-spotlight__image" href={eventPath(event)} aria-label={`View event details: ${event.title}`} tabindex="-1">
      <img src={`${event.image.url}?w=1200&auto=format`} srcset={`${event.image.url}?w=640&auto=format 640w, ${event.image.url}?w=1200&auto=format 1200w`} sizes="(max-width: 780px) 100vw, 55vw" width={event.image.width} height={event.image.height} alt={event.image.alt} loading="lazy" decoding="async" />
    </a>
    <div class="event-spotlight__copy">
      <p class="event-date"><time datetime={event.start}>{formatEventDate(event)}</time> · {event.timezone}</p>
      <h3>{event.title}</h3>
      <p>{event.summary}</p>
      <p>{event.format === "online" ? "Online" : `In person · ${event.venue}`}</p>
      <p class="event-spotlight__state">{previous ? "Event completed" : eventRegistrationLabel(event)}</p>
      <a class="text-link" href={eventPath(event)} aria-label={`View event details: ${event.title}`}>View event details <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>
