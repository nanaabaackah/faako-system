---
import { FaArrowLeft, FaArrowRight, FaCalendarDay } from "react-icons/fa6";

const calendarId = import.meta.env.PUBLIC_TTNGH_GOOGLE_CALENDAR_ID?.trim() || "";
const calendarUrl = calendarId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calendarId)}&ctz=Africa%2FAccra&mode=MONTH&showTitle=0&showPrint=0&showCalendars=0&showTz=0`
  : "";
---

<section class="event-calendar-section" aria-labelledby="calendar-title">
  <div class="section-heading">
    <p class="eyebrow">Programme calendar</p>
    <h2 id="calendar-title">Plan around confirmed dates.</h2>
    <p>{calendarId ? "TTNGH's public Google Calendar is ready to provide confirmed event dates and details." : "No public dates are currently confirmed. The calendar is prepared to connect to TTNGH's public Google Calendar without publishing guessed event information."}</p>
  </div>

  <event-calendar class="event-calendar">
    {calendarUrl ? (
      <>
        <div class="event-calendar-gate" data-calendar-gate>
          <span class="event-calendar-gate-icon" aria-hidden="true"><FaCalendarDay focusable="false" /></span>
          <div><strong>View TTNGH's live event calendar</strong><p>Loading the calendar connects to Google Calendar. Google may receive technical information such as your IP address and browser details.</p></div>
          <button class="button button-primary" type="button" data-calendar-load><span class="button-label">Load calendar</span><span class="button-icon" aria-hidden="true"><FaArrowRight focusable="false" /></span></button>
        </div>
        <iframe
          class="event-calendar-embed"
          data-calendar-embed
          data-src={calendarUrl}
          title="The Thriving Network GH public events calendar"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          hidden
        ></iframe>
      </>
    ) : (
      <>
        <div class="event-calendar-toolbar">
          <button type="button" data-calendar-previous aria-label="Show previous month"><FaArrowLeft focusable="false" /></button>
          <h3 data-calendar-heading aria-live="polite"></h3>
          <button type="button" data-calendar-next aria-label="Show next month"><FaArrowRight focusable="false" /></button>
        </div>
        <div class="event-calendar-weekdays" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
        <ol class="event-calendar-grid" data-calendar-grid aria-label="Calendar dates"></ol>
        <div class="event-calendar-empty"><FaCalendarDay focusable="false" aria-hidden="true" /><p><strong>No confirmed public events for this month.</strong><span>Registration details will appear here after TTNGH publishes them.</span></p><a class="text-link" href="/contact">Ask about upcoming events →</a></div>
      </>
    )}
  </event-calendar>
</section>

<script>
  class EventCalendar extends HTMLElement {
    date = new Date(new Date().getFullYear(), new Date().getMonth(), 1);

    connectedCallback() {
      const loadButton = this.querySelector("[data-calendar-load]");
      const embed = this.querySelector("[data-calendar-embed]");
      if (loadButton instanceof HTMLButtonElement && embed instanceof HTMLIFrameElement) {
        loadButton.addEventListener("click", () => {
          const source = embed.dataset.src;
          if (!source) return;
          embed.src = source;
          embed.hidden = false;
          this.querySelector("[data-calendar-gate]")?.setAttribute("hidden", "");
        }, { once: true });
        return;
      }

      this.querySelector("[data-calendar-previous]")?.addEventListener("click", () => this.changeMonth(-1));
      this.querySelector("[data-calendar-next]")?.addEventListener("click", () => this.changeMonth(1));
      this.render();
    }

    changeMonth(amount) {
      this.date = new Date(this.date.getFullYear(), this.date.getMonth() + amount, 1);
      this.render();
    }

    render() {
      const heading = this.querySelector("[data-calendar-heading]");
      const grid = this.querySelector("[data-calendar-grid]");
      if (!(heading instanceof HTMLElement) || !(grid instanceof HTMLOListElement)) return;
      heading.textContent = new Intl.DateTimeFormat("en-GH", { month: "long", year: "numeric" }).format(this.date);
      grid.replaceChildren();

      const year = this.date.getFullYear();
      const month = this.date.getMonth();
      const firstDay = (new Date(year, month, 1).getDay() + 6) % 7;
      const totalDays = new Date(year, month + 1, 0).getDate();

      for (let index = 0; index < firstDay; index += 1) {
        const empty = document.createElement("li");
        empty.className = "is-empty";
        empty.setAttribute("aria-hidden", "true");
        grid.append(empty);
      }

      for (let day = 1; day <= totalDays; day += 1) {
        const item = document.createElement("li");
        const time = document.createElement("time");
        const isoDate = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
        time.dateTime = isoDate;
        time.textContent = String(day);
        item.append(time);
        grid.append(item);
      }
    }
  }

  if (!customElements.get("event-calendar")) customElements.define("event-calendar", EventCalendar);
</script>
