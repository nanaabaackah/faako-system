---
import Icon from "./Icon.jsx";
import MonthCalendar from "./MonthCalendar.astro";
import EventListings from "./EventListings.astro";
import { getPublishedEvents } from "../lib/event-source.js";
const { showListings = false, featuredEventId } = Astro.props;
const events = await getPublishedEvents();

const calendarId = import.meta.env.PUBLIC_TTNGH_GOOGLE_CALENDAR_ID?.trim() || "";
const calendarUrl = calendarId
  ? `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calendarId)}&ctz=Africa%2FAccra&mode=MONTH&showTitle=0&showPrint=0&showCalendars=0&showTz=0`
  : "";
---

<section class="event-calendar-section" aria-labelledby="calendar-title">
  <div class="section-heading">
    <h2 id="calendar-title">Plan around confirmed dates.</h2>
    <p>Find time for connection, reflection, and community. Contact the team for confirmed programme dates.</p>
  </div>

  <event-calendar class="event-calendar">
    <MonthCalendar events={events} />
    {calendarUrl ? (
      <>
        <div class="event-calendar-gate" data-calendar-gate>
          <span class="event-calendar-gate-icon" aria-hidden="true"><Icon name="calendar" focusable="false" /></span>
          <div><strong>View TTNGH's live event calendar</strong><p>Loading the calendar connects to Google Calendar. Google may receive technical information such as your IP address and browser details.</p></div>
          <button class="button button-primary" type="button" data-calendar-load><span class="button-label">View full Google calendar</span><span class="button-icon" aria-hidden="true"><Icon name="arrow-right" focusable="false" /></span></button>
        </div>
        <iframe
          class="event-calendar-embed"
          data-calendar-embed
          data-src={calendarUrl}
          title="The Thriving Network GH public events calendar"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          hidden
        ></iframe>
      </>
    ) : !events.length && (
      <>
        <div class="event-calendar-empty"><Icon name="calendar" focusable="false" aria-hidden="true" /><p><strong>Confirmed dates will appear here.</strong><span>Contact the team for the latest availability and registration information.</span></p><a class="text-link" href="/contact?topic=events">Ask about upcoming events <Icon name="arrow-right" /></a></div>
      </>
    )}
  </event-calendar>
  {showListings && events.length > 0 && <div class="calendar-event-listings"><EventListings compact featuredEventId={featuredEventId} /></div>}
</section>

<script>
  class EventCalendar extends HTMLElement {
    connectedCallback() {
      const loadButton = this.querySelector("[data-calendar-load]");
      const embed = this.querySelector("[data-calendar-embed]");
      if (!(loadButton instanceof HTMLButtonElement) || !(embed instanceof HTMLIFrameElement)) return;
      loadButton.addEventListener("click", () => {
        const source = embed.dataset.src;
        if (!source) return;
        embed.src = source;
        embed.hidden = false;
        this.querySelector("[data-calendar-gate]")?.setAttribute("hidden", "");
      }, { once: true });
    }
  }
  if (!customElements.get("event-calendar")) customElements.define("event-calendar", EventCalendar);
</script>
