---
import { partners } from "../content/home-page.js";
---

<section class="home-partners" aria-label="Partners and collaborators">
  <div class="partner-marquee" aria-label="Partner logos">
    <div class="partner-track">
      <div class="partner-track-group">
        {partners.map((partner) => (
          <img src={partner.logo} alt={partner.name} width="560" height="280" loading="lazy" decoding="async" />
        ))}
      </div>
      <div class="partner-track-group" aria-hidden="true">
        {partners.map((partner) => (
          <img src={partner.logo} alt="" width="560" height="280" loading="lazy" decoding="async" />
        ))}
      </div>
    </div>
  </div>
</section>
