---
import { partners as originalPartners } from "../content/partners.js";
import { contentOfType, cmsConfigured } from "../lib/cms-source.js";
const homepage=(await contentOfType("homePage"))[0];
const records=await contentOfType("partner");
const partners=cmsConfigured?records.filter(p=>!homepage?.partners?.length||homepage.partners.includes(p._id)).map(p=>({...p,logo:`${p.logo.url}?w=400&auto=format`,alt:p.logo.alt})):originalPartners;
---
{partners.length>0&&<section class="home-partners home-shell" aria-labelledby="partners-title"><h2 id="partners-title">Our partners.</h2><div class="partner-logos">{partners.map(partner => partner.link?<a href={partner.link} rel="noopener noreferrer" target="_blank"><img src={partner.logo} alt={partner.alt||partner.name} width="280" height="140" loading="lazy" decoding="async" /></a>:<img src={partner.logo} alt={partner.alt||partner.name} width="280" height="140" loading="lazy" decoding="async" />)}</div></section>}
