---
import EditorialImage from "./EditorialImage.astro";
const images = [
  { src: "/images/home/vision-gathering.jpg", alt: "Participants gathered for TTNGH's Vision with Clarity programme", caption: "Vision with Clarity" },
  { src: "/images/home/programme-audience.jpg", alt: "Students attending a TTNGH mental health education programme in Tema", caption: "School outreach" },
  { src: "/images/refresh/tema-school-conversation-1600.webp", alt: "TTNGH team members talking with people in a school hall", caption: "School outreach · Tema" },
  { src: "/images/home/vision-reflection.jpg", alt: "Participants completing a guided reflection exercise", caption: "Guided reflection" },
  { src: "/images/home/programme-team.jpg", alt: "The TTNGH team during a school programme in Tema", caption: "Programme delivery" },
  { src: "/images/home/vision-facilitator.jpg", alt: "A facilitator leading a Vision with Clarity session", caption: "Facilitated learning" },
];
---

<section class="event-gallery-rail" aria-labelledby="event-gallery-title">
  <div class="section-heading"><h2 id="event-gallery-title">Moments of learning, reflection, and connection.</h2></div>
  <div class="event-gallery-viewport">
    <div class="event-gallery-track" tabindex="0" role="region" aria-label="Event photography gallery">
      {images.map((image) => <figure><EditorialImage src={image.src} alt={image.alt} sizes="350px" loading="lazy" /><figcaption>{image.caption}</figcaption></figure>)}
    </div>
  </div>
</section>
