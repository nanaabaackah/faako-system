---
import EditorialImage from "./EditorialImage.astro";
import "../styles/components/photo-ribbon.css";
const { id = "event-gallery-title", title = "Moments of learning, reflection, and connection." } = Astro.props;
const images = [
  { src: "/images/refresh/vision-conversation-1600.webp", alt: "Participants listening together around a table", caption: "Vision with Clarity" },
  { src: "/images/refresh/tema-school-conversation-1600.webp", alt: "TTNGH team members talking with people in a school hall", caption: "School outreach · Tema" },
  { src: "/images/refresh/vision-reflection-1600.webp", alt: "Participants writing at tables during Vision with Clarity", caption: "Vision with Clarity" },
  { src: "/images/refresh/tema-school-speaker-1600.webp", alt: "A speaker holding a microphone in a school hall", caption: "School outreach · Tema" },
];
---
<section class="photo-ribbon" aria-labelledby={id} data-photo-ribbon>
  <div class="section-heading"><h2 id={id}>{title}</h2><button type="button" class="text-link" data-ribbon-toggle aria-pressed="false" hidden>Pause gallery</button></div>
  <div class="photo-ribbon-viewport" tabindex="0" role="region" aria-label="Programme photography">
    <div class="photo-ribbon-track">
      <div class="photo-ribbon-group">{images.map(image => <figure><EditorialImage src={image.src} alt={image.alt} sizes="(max-width: 600px) 80vw, 350px" loading="lazy" /><figcaption>{image.caption}</figcaption></figure>)}</div>
      <div class="photo-ribbon-group photo-ribbon-clone" aria-hidden="true" inert>{images.map(image => <figure><EditorialImage src={image.src} alt="" sizes="(max-width: 600px) 80vw, 350px" loading="lazy" /><figcaption>{image.caption}</figcaption></figure>)}</div>
    </div>
  </div>
</section>
<script>
  for (const ribbon of document.querySelectorAll<HTMLElement>("[data-photo-ribbon]")) {
    const button = ribbon.querySelector<HTMLButtonElement>("[data-ribbon-toggle]");
    const viewport = ribbon.querySelector<HTMLElement>(".photo-ribbon-viewport");
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const visibility = () => { ribbon.dataset.suspended = String(document.hidden); };
    document.addEventListener("visibilitychange", visibility);
    visibility();
    if ("IntersectionObserver" in window) new IntersectionObserver(([entry]) => {
      ribbon.dataset.offscreen = String(!entry.isIntersecting);
    }).observe(ribbon);
    const sync = () => { ribbon.dataset.animate = String(!motion.matches); button.hidden = motion.matches; };
    sync(); motion.addEventListener("change", sync);
    const pause = (paused: boolean) => {
      ribbon.dataset.paused = String(paused);
      button.setAttribute("aria-pressed", String(paused));
      button.textContent = paused ? "Resume gallery" : "Pause gallery";
    };
    button.addEventListener("click", () => pause(ribbon.dataset.paused !== "true"));
    viewport.addEventListener("pointerdown", event => { if (event.pointerType !== "mouse") pause(true); });
  }
</script>
