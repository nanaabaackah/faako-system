---
import Icon from "./Icon.jsx";
import "../styles/components/month-calendar.css";
const api = import.meta.env.PUBLIC_TTNGH_API_ORIGIN?.trim() || "";
---
<month-calendar data-api={api}>
  <div class="month-toolbar">
    <button type="button" data-month-prev aria-label="Previous month"><Icon name="arrow-left" /></button>
    <h3 data-month-label aria-live="polite">Event calendar</h3>
    <button type="button" data-month-next aria-label="Next month"><Icon name="arrow-right" /></button>
    <button type="button" data-month-today>Today</button>
  </div>
  <p class="month-status" data-month-status role="status">Loading the live calendar…</p>
  <button type="button" class="month-retry" data-month-retry hidden>Try again</button>
  <table class="month-grid" aria-busy="true">
    <caption class="month-caption">Dates and times are in Ghana time (Africa/Accra). Use arrow keys to choose a day, or select it to read its agenda.</caption>
    <thead><tr>{["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].map(day => <th scope="col">{day}</th>)}</tr></thead>
    <tbody>{Array.from({ length: 6 }, () => <tr>{Array.from({ length: 7 }, () => <td><span class="month-placeholder" aria-hidden="true" /></td>)}</tr>)}</tbody>
  </table>
  <section class="month-agenda" aria-label="Selected day events" aria-live="polite" aria-atomic="true">
    <h4 data-agenda-title>Selected day</h4>
    <div data-agenda-events></div>
  </section>
  <noscript>Enable JavaScript to view the live calendar, or <a href="/contact?topic=events">ask about event dates</a>. Reviewed event listings remain available on this page.</noscript>
</month-calendar>
<script>
  import "../scripts/month-calendar.ts";
</script>
