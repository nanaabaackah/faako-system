---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqList from "../components/FaqList.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import { FaArrowRight } from "react-icons/fa6";
import { organization, roadmap, values } from "../content/home.js";
import aboutStyles from "../styles/pages/about.css?url";

const faqItems = [
  { question: "What is The Thriving Network GH?", answer: "The Thriving Network GH is a registered non-governmental organisation based in Tema, Ghana, working in mental health education, support, advocacy, research, and policy engagement." },
  { question: "When was The Thriving Network GH founded?", answer: "The organisation began in July 2023 after an open, judgement-free conversation about mental health grew into a community." },
  { question: "What is TTNGH's mission?", answer: "TTNGH works to eradicate mental health stigma through education, advocacy, and support, empowering people and communities to seek help without fear." },
];
---

<BaseLayout path="/about" pageStyles={[aboutStyles]} title={`About us | ${organization.name}`} description="Learn how The Thriving Network GH began, what guides the organisation, and the future it is working to build." image="/images/home/founder-anthonia.jpg" imageAlt="Anthonia Nonye Tony-Dibie, founder of The Thriving Network GH" breadcrumbs={[{ name: "Home", path: "/" }, { name: "About", path: "/about" }]} faqItems={faqItems}>
  <main id="main-content" class="editorial-main">
    <PageHero eyebrow="About The Thriving Network GH" title="Mental wellness is not a privilege. It is a right." intro="We are a community-centred NGO working to eradicate mental health stigma through education, advocacy, direct support, research, and policy engagement." images={[
      { src: "/images/home/founder-anthonia.jpg", alt: "Anthonia Nonye Tony-Dibie, Founder and Executive Director of TTNGH" },
      { src: "/images/home/vision-conversation.jpg", alt: "A participant during TTNGH's Vision with Clarity programme" },
      { src: "/images/home/programme-team.jpg", alt: "The TTNGH team during a school mental health programme in Tema" },
    ]} />

    <section id="story" aria-labelledby="story-title">
      <div class="section-heading"><p class="eyebrow">Our story</p><h2 id="story-title">One conversation became a growing community.</h2></div>
      <div class="prose-grid">
        <div>
          <p>The Thriving Network GH began in July 2023 after a simple status post invited people into a judgement-free conversation about mental health. The response revealed how many people were carrying depression, anxiety, trauma, and other difficult experiences in silence.</p>
          <p>Today, the network is a registered NGO based in Tema, with more than 100 members, regular virtual and in-person sessions, professional counselling, and community outreach programmes.</p>
          <p><a class="text-link" href="/downloads/ttngh-company-profile-2026.pdf" download>Download our 2026 company profile</a></p>
        </div>
        <dl class="mission-list">
          <div class="glass-card motion-card"><dt>Our vision</dt><dd>A stigma-free society where mental health is embraced as an essential component of overall well-being.</dd></div>
          <div class="glass-card motion-card"><dt>Our mission</dt><dd>To eradicate mental health stigma through education, advocacy, and support, empowering individuals and communities to seek help without fear.</dd></div>
        </dl>
      </div>
    </section>

    <section id="founder" class="photo-feature section-pink" aria-labelledby="founder-title">
      <figure><img src="/images/home/founder-anthonia.jpg" alt="Anthonia Nonye Tony-Dibie, Founder and Executive Director of The Thriving Network GH" width="1066" height="1600" loading="lazy" decoding="async" /></figure>
      <div class="photo-feature-copy">
        <p class="eyebrow">From our founder</p><h2 id="founder-title">A community where people can simply be heard.</h2>
        <blockquote><p>“I wanted to create a judgement-free community space where people could simply come, release, breathe, and be heard.”</p><footer><strong>Anthonia Nonye Tony-Dibie</strong><span>Founder & Executive Director</span></footer></blockquote>
      </div>
    </section>

    <section id="team" class="about-team" aria-labelledby="team-title">
      <div>
        <p class="eyebrow">Our team</p>
        <h2 id="team-title">Meet the people behind the work.</h2>
        <p>Our leadership core team brings together programme delivery, operations, legal affairs, fundraising, communications, projects, administration, and outreach.</p>
        <a class="button button-primary" href="/team"><span class="button-label">Meet the team</span><span class="button-icon" aria-hidden="true"><FaArrowRight focusable="false" /></span></a>
      </div>
      <div class="about-team-portraits" aria-hidden="true">
        <img src="/images/team/emefa-adonu.jpg" alt="" loading="lazy" />
        <img src="/images/team/ruby-adeley.jpg" alt="" loading="lazy" />
        <img src="/images/team/dzifa-tay-ansah.jpg" alt="" loading="lazy" />
      </div>
    </section>

    <section id="values" class="section-dark" aria-labelledby="values-title">
      <div class="section-heading"><p class="eyebrow">What guides us</p><h2 id="values-title">Our values</h2></div>
      <div class="grid grid-four">{values.map((value) => <article class="bubble-card motion-card"><h3>{value.title}</h3><p>{value.description}</p></article>)}</div>
    </section>

    <section id="roadmap" aria-labelledby="roadmap-title">
      <div class="section-heading"><p class="eyebrow">Our direction</p><h2 id="roadmap-title">Building from community reach to national presence.</h2></div>
      <ol class="roadmap-list">{roadmap.map((item) => <li class="glass-card motion-card"><h3>{item.period}</h3><p>{item.description}</p></li>)}</ol>
    </section>
    <FaqList items={faqItems} />
    <ScrollExpandSection image="/images/home/initiative-community.jpg" alt="The Thriving Network GH community gathered in Tema" eyebrow="Work with us" title="Help build a stigma-free society." text="Bring your time, professional expertise, platform, or organisational support to the mission." href="/get-involved" linkLabel="Get involved" frameTitle="The work grows together." id="about-cta-title" />
  </main>
</BaseLayout>
