---
import Icon from "../components/Icon.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import SocialIcon from "../components/SocialIcon.jsx";
import { organization } from "../content/home.js";
import contactStyles from "../styles/pages/contact.css?url";
import contactFormStyles from "../styles/components/contact-form.css?url";
const channels = [
  { icon:"email", title:"General enquiries", topic:"Other enquiry" },
  { icon:"calendar", title:"Events", topic:"Events" },
  { icon:"people", title:"Partnerships", topic:"Partnerships" },
  { icon:"heart", title:"Donations", topic:"Donations" },
];
---
<BaseLayout path="/contact" pageStyles={[contactStyles, contactFormStyles]} title={`Contact us | ${organization.name}`} description="Contact The Thriving Network GH in Tema about support, programmes, volunteering, donations, partnerships, or media." image="/images/refresh/vision-conversation-1600.webp" imageAlt="Participants listening together around a table" breadcrumbs={[{ name:"Home", path:"/" }, { name:"Contact", path:"/contact" }]}>
  <main id="main-content" class="editorial-main contact-page">
    <PageHero variant="conversion" title="Start a conversation." intro="Ask about support, programmes, volunteering, or working together. Tell us what you have in mind." images={[{src:"/images/refresh/vision-conversation-1600.webp",alt:"Participants listening together around a table",caption:"Vision with Clarity · TTNGH"}]} />
    <section class="contact-workspace" id="details" aria-label="Contact TTNGH">
      <div class="contact-workspace-grid">
        <aside class="contact-sidebar" aria-label="Enquiry routes and organisation details">
          <div class="contact-channels">
            {channels.map(channel => <a class="contact-channel-link" href="#enquiry-form" data-contact-topic={channel.topic}><Icon name={channel.icon} /><span><strong>{channel.title}</strong><small>Enquire with the TTNGH team</small></span><Icon name="arrow-right" /></a>)}
          </div>
          <address><p>{organization.address}</p><a href={`mailto:${organization.email}`}>{organization.email}</a><a href={`tel:${organization.phoneHref}`}>{organization.phoneDisplay}</a></address>
          <ul class="contact-socials">{organization.socials.filter(social=>social.href).map(social=><li><a href={social.href} target="_blank" rel="noopener noreferrer"><SocialIcon name={social.icon} /><span>{social.platform}</span></a></li>)}</ul>
        </aside>
        <div id="enquiry-form" class="contact-form-surface"><ContactForm /></div>
      </div>
    </section>
  </main>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-contact-topic]").forEach(link => {
    link.addEventListener("click", () => {
      const field = document.querySelector<HTMLSelectElement>('[data-contact-form] [name="topic"]');
      if (field && !field.disabled) {
        field.value = link.dataset.contactTopic || "";
        field.dispatchEvent(new Event("change", {bubbles:true}));
      }
    });
  });
</script>
