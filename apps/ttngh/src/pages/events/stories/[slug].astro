---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { eventStories } from "../../../content/event-stories.js";
import articleStyles from "../../../styles/pages/press-detail.css?url";
import galleryStyles from "../../../styles/pages/gallery.css?url";
export function getStaticPaths() { return eventStories.map(story => ({params:{slug:story.slug},props:{story}})); }
const { story } = Astro.props;
const path = `/events/stories/${story.slug}`;
const photos = story.photos.filter(photo => photo.src !== story.image.src);
---
<BaseLayout path={path} title={`${story.title} | TTNGH`} description={story.summary} image={story.image.src} imageAlt={story.image.alt} pageStyles={[articleStyles,galleryStyles]} breadcrumbs={[{name:"Home",path:"/"},{name:"Events",path:"/events"},{name:story.title,path}]}>
  <main id="main-content" class="editorial-main">
    <article class="press-detail">
      <header><a class="text-link" href="/events#event-stories">Back to events</a><h1>{story.title}</h1><p>{story.summary}</p></header>
      <figure><img src={story.image.src} width={story.image.width} height={story.image.height} alt={story.image.alt} fetchpriority="high" decoding="async" /></figure>
      <div class="press-body">{story.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
      <section aria-labelledby="event-photos-title"><h2 id="event-photos-title">Moments from the event</h2>
        <div class="gallery-grid">{photos.map(photo => <figure data-reveal style={`--photo-ratio: ${photo.width / photo.height}`}><a href={photo.src} target="_blank" rel="noopener" aria-label={`Open full photograph: ${photo.alt}`}><img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" /></a></figure>)}</div>
      </section>
      {story.gallery && <p><a class="text-link" href={`/gallery#${story.gallery}`}>View the full album</a></p>}
      {story.links.length > 0 && <aside class="press-source"><h2>Related coverage</h2>{story.links.map(link => <p><a class="text-link" href={link.href}>{link.label}</a></p>)}</aside>}
      <p><a class="text-link" href="/events#calendar-title">See the live calendar for confirmed upcoming dates</a></p>
    </article>
  </main>
</BaseLayout>
