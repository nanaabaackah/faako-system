---
import ImpactFigures from "../components/ImpactFigures.astro";
import EventGalleryRail from "../components/EventGalleryRail.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import { highlights, impactStats, organization, roadmap } from "../content/home.js";
---

<BaseLayout path="/impact" title={`Gallery and impact | ${organization.name}`} description="See TTN GH impact figures, programme milestones, outreach highlights, and future direction." image="/images/home/initiative-community.jpg" imageAlt="The Thriving Network GH community at a programme in Tema" breadcrumbs={[{ name: "Home", path: "/" }, { name: "Impact", path: "/impact" }]}>
  <main id="main-content" class="editorial-main">
    <PageHero links={[["Our impact","#numbers-title"],["Milestones","#milestones-title"]]} title="Our work. Our shared impact." intro="Since 2023, The Thriving Network GH has grown from one open conversation into an active network delivering support, education, and outreach." images={[
      { src: "/images/refresh/tema-school-audience-1600.webp", alt: "Students seated in rows during a school outreach event", caption: "School outreach · Presbyterian Senior High School, Tema" },
      { src: "/images/home/vision-facilitator.jpg", alt: "A facilitator leading a TTNGH session" },
      { src: "/images/home/programme-team.jpg", alt: "The TTNGH team during a school programme in Tema" },
    ]} />
    <section aria-labelledby="numbers-title">
      <div class="section-heading"><h2 id="numbers-title">The work in numbers</h2></div>
      <ImpactFigures stats={impactStats} />
    </section>
    <section class="section-dark" aria-labelledby="milestones-title">
      <div class="section-heading"><h2 id="milestones-title">Highlights from our journey</h2></div>
      <ul class="check-list large-list">{highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    </section>
    <EventGalleryRail id="gallery-title" title="Learning and connection, in practice." />
    <section aria-labelledby="future-title">
      <div class="section-heading"><h2 id="future-title">Our path toward national presence</h2></div>
      <ol class="roadmap-list">{roadmap.map((item) => <li class="editorial-item"><h3>{item.period}</h3><p>{item.description}</p></li>)}</ol>
    </section>
    <ScrollExpandSection image="/images/home/closing-community.jpg" alt="Students and TTNGH team members gathered in Tema" title="Help the work reach further." text="Support counselling, education, advocacy, outreach, research, and community spaces." href="/get-involved" linkLabel="Get involved" frameTitle="Impact becomes momentum." id="impact-cta-title" />
  </main>
</BaseLayout>
