---
import Icon from "../components/Icon.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import CmsCards from "../components/CmsCards.astro";
import { contentOfType } from "../lib/cms-source.js";
const resources=await contentOfType("resource");
---
<BaseLayout path="/resources" title="Reviewed resources | TTNGH" description="Explore reviewed educational resources from The Thriving Network GH, with named authors, reviewers and sources." breadcrumbs={[{name:"Home",path:"/"},{name:"Resources",path:"/resources"}]}>
  <main id="main-content" class="editorial-main">
    <PageHero variant="immersive" title="Learn with" accent="trusted context." images={[{src:"/images/refresh/vision-reflection-1600.webp",alt:"Participants writing together during Vision with Clarity"}]} />
    {resources.length ? <CmsCards documents={resources} title="Reviewed resources" /> : <section><h2>No resources published yet.</h2><a class="text-link" href="/contact">Contact the team <Icon name="arrow-right" /></a></section>}
    <ScrollExpandSection image="/images/refresh/vision-listening-1600.webp" alt="Participants listening together around a table" title="Help keep the conversation open." frameTitle="Learning, together." id="resources-cta-title" />
  </main>
</BaseLayout>
