---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqList from "../components/FaqList.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import EventCalendar from "../components/EventCalendar.astro";
import EventListings from "../components/EventListings.astro";
import EventSpotlight from "../components/EventSpotlight.astro";
import { getPublishedEvents } from "../lib/event-source.js";
import { selectEventHighlights } from "../lib/events.js";
import EventGalleryRail from "../components/EventGalleryRail.astro";
import { organization } from "../content/home.js";
import eventStyles from "../styles/pages/events.css?url";
const events = await getPublishedEvents();
const highlights = selectEventHighlights(events);
const heroLinks = [
  ...(highlights.next ? [["Next up", "#next-up"]] : []),
  ...(highlights.upcoming.length ? [["Upcoming", "#upcoming-events"]] : []),
  ["Calendar", "#calendar-title"], ["Recurring events", "#event-types-title"],
];

const faqItems = [
  { question: "What events does TTNGH run?", answer: "TTNGH runs monthly virtual and in-person support group sessions, the annual Vision with Clarity programme, and mental health outreach for schools, workplaces, faith groups, and communities." },
  { question: "Where can I find confirmed event dates?", answer: "Confirmed dates and registration details will be published on this page when they are available. You can also contact the TTNGH team directly." },
];
---

<BaseLayout path="/events" pageStyles={[eventStyles]} title={`Events | ${organization.name}`} description="Discover The Thriving Network GH community sessions, outreach activities, and annual programmes." image="/images/home/vision-gathering.jpg" imageAlt="Participants gathered for TTNGH's Vision with Clarity programme" breadcrumbs={[{ name: "Home", path: "/" }, { name: "Events", path: "/events" }]} faqItems={faqItems}>
  <main id="main-content" class="editorial-main events-page">
    <PageHero variant="immersive" links={heroLinks} title="Events that bring" accent="us together." intro="Our events create welcoming spaces for mental health education, connection, reflection, and community action." images={[
      { src: "/images/refresh/vision-facilitator-1600.webp", alt: "A speaker addressing people seated around a table", caption: "Vision with Clarity · TTNGH" },
    ]} />
    {highlights.next ? <EventSpotlight event={highlights.next} /> : <section class="events-empty" aria-labelledby="events-empty-title">
      <h2 id="events-empty-title">{highlights.previous ? "No new dates have been published yet." : "No event dates have been published yet."}</h2>
      <p>TTNGH runs recurring support, education and community programmes throughout the year. Explore the live calendar or ask the team about upcoming events.</p>
      <div class="hero-actions"><a class="text-link" href="#calendar-title">View calendar</a><a class="text-link" href="/contact?topic=events">Ask about upcoming events</a></div>
    </section>}
    {highlights.upcoming.length > 0 && <EventListings selectedEvents={highlights.upcoming} id="upcoming-events" showEmpty={false} />}
    {highlights.previous && <EventSpotlight event={highlights.previous} previous />}
    <EventCalendar editorialEvents={events} />
    <section class="events-recurring " aria-labelledby="event-types-title">
      <header class="events-recurring-intro">
        <div><h2 id="event-types-title">Recurring spaces for support, reflection, and learning.</h2></div>
        <p>TTNGH brings people together through a regular support rhythm, an annual well-being programme, and outreach developed for institutions and communities.</p>
      </header>

      <div class="recurring-event-list">
        <article id="support-groups" class="recurring-event" data-reveal>
          <div class="recurring-event-copy">
            <p class="recurring-event-rhythm">Monthly · Virtual and in person</p>
            <h3>Support group sessions</h3>
            <p>Running since July 2023, TTNGH's monthly sessions provide safe community spaces for peer support and honest, judgement-free mental health conversations. Virtual and in-person meetings sit alongside the organisation's professional one-on-one counselling services.</p>
          </div>
        </article>

        <article id="vision-with-clarity" class="recurring-event" data-reveal>
          <figure><img src="/images/refresh/vision-reflection-960.webp" alt="Participants writing at a table during Vision with Clarity" width="960" height="640" loading="lazy" decoding="async" /></figure>
          <div class="recurring-event-copy">
            <p class="recurring-event-rhythm">Annual · Launched in 2026</p>
            <h3>Vision with Clarity</h3>
            <p>Vision with Clarity is TTNGH's annual reflection and well-being programme. It brings participants together for guided reflection, intentional planning, facilitated learning, connection, and a renewed focus on personal well-being.</p>
          </div>
        </article>

        <article id="community-outreach" class="recurring-event" data-reveal>
          <figure><img src="/images/home/programme-audience.jpg" alt="Students attending a TTNGH mental health education programme in Tema" width="1600" height="1067" loading="lazy" decoding="async" /></figure>
          <div class="recurring-event-copy">
            <p class="recurring-event-rhythm">By arrangement · Institutions and communities</p>
            <h3>Community outreach</h3>
            <p>TTNGH delivers workshops, seminars, and mental health education in schools, workplaces, churches, and community centres. Documented activities include a workplace well-being talk with DHL Ghana and an education programme at Presbyterian Senior High School, Tema.</p>
          </div>
        </article>
      </div>
    </section>
    <EventGalleryRail />
    <FaqList items={faqItems} />
    <div id="upcoming"><ScrollExpandSection image="/images/refresh/vision-community-1600.webp" alt="Participants gathered for TTNGH's Vision with Clarity programme" title="Help bring people together." text="Donate to support TTNGH community programmes and mental health education." frameTitle="Come as you are." id="dates-title" /></div>
  </main>
</BaseLayout>
