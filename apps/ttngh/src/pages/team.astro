---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import TeamGrid from "../components/TeamGrid.astro";
import { organization } from "../content/home.js";
import { founder, team } from "../content/team.js";
import teamStyles from "../styles/pages/team.css?url";
---

<BaseLayout path="/team" people={[founder, ...team]} pageStyles={[teamStyles]} title={`Our team | ${organization.name}`} description="Meet the founder and leadership core team behind The Thriving Network GH." image={founder.image} imageAlt={`${founder.name}, ${founder.role}`} breadcrumbs={[{ name: "Home", path: "/" }, { name: "About", path: "/about" }, { name: "Our team", path: "/team" }]}>
  <main id="main-content" class="team-page editorial-main">
    <PageHero variant="editorial" title="The people behind the work." intro="A leadership team bringing programmes, operations, communications, and outreach together." links={[["Meet the founder", "#founder-profile-title"], ["Leadership team", "#leadership-title"]]} />

    <section class="founder-profile" aria-labelledby="founder-profile-title">
      <figure><img src={founder.image} alt={`${founder.name}, ${founder.role}`} width="1066" height="1600" /></figure>
      <div>
        <p class="role-caption">{founder.role}</p>
        <h2 id="founder-profile-title">{founder.name}</h2>
        <blockquote>“{founder.quote}”</blockquote>
      </div>
    </section>

    <section class="leadership-team" aria-labelledby="leadership-title">
      <div class="section-heading">

        <h2 id="leadership-title">Many disciplines. One mission.</h2>
      </div>
      <TeamGrid />
    </section>
    <ScrollExpandSection image="/images/home/initiative-team.jpg" alt="The TTNGH team during a school mental health programme in Tema" title="Help build a stigma-free society." text="Support the work of the team through a donation to TTNGH." frameTitle="Many disciplines. One mission." id="team-cta-title" />
  </main>
</BaseLayout>
