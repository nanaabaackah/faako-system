---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FaArrowRight } from "react-icons/fa6";
import { organization } from "../content/home.js";
import legalStyles from "../styles/pages/legal.css?url";
---

<BaseLayout path="/terms" pageStyles={[legalStyles]} title={`Website terms of use | ${organization.name}`} description="Terms for using The Thriving Network GH website and its informational content." breadcrumbs={[{ name: "Home", path: "/" }, { name: "Terms of use", path: "/terms" }]}>
  <main id="main-content" class="editorial-main legal-page">
    <section class="legal-content">
      <aside class="legal-summary"><p class="eyebrow">Website legal</p><h1>Terms of use</h1><p><strong>Last updated:</strong> 18 September 2026</p><p>By using this website, you agree to use its content lawfully and with respect for TTNGH, its community, and the people shown in its photography.</p></aside>
      <div class="legal-sections">
        <section><h2>Website purpose</h2><p>This website provides information about The Thriving Network GH, its mission, programmes, events, team, impact, and ways to contact or support the organisation.</p></section>
        <section><h2>Not medical or emergency advice</h2><p>Website content is general information and does not replace professional medical, psychological, legal, or emergency advice. Contact TTNGH directly to ask about its counselling and support services.</p></section>
        <section><h2>Accuracy and updates</h2><p>TTNGH aims to keep its organisational information accurate. Event dates, programme availability, team details, and donation methods may change and should be confirmed directly when they are not published as current.</p></section>
        <section><h2>Content and photography</h2><p>Text, branding, photographs, and other material on this website belong to TTNGH or are used with permission. Please contact the organisation before copying or republishing them beyond ordinary personal use.</p></section>
        <section><h2>External links</h2><p>External websites and services are responsible for their own content, availability, security, and terms. A link from this website does not transfer that responsibility to TTNGH.</p></section>
        <section><h2>Privacy and measurement</h2><p>The privacy notice explains the local contact-form handoff, consent choices, optional Google Analytics, search-performance reporting, essential browser storage, and routine technical logs.</p><p><a class="text-link" href="/privacy">Read the privacy notice →</a></p></section>
        <section><h2>Contact</h2><p>Use the contact page if you have a question about these terms or the website.</p><a class="button button-primary" href="/contact?topic=privacy"><span class="button-label">Contact the team</span><span class="button-icon" aria-hidden="true"><FaArrowRight focusable="false" /></span></a></section>
      </div>
    </section>
  </main>
</BaseLayout>
