---
import BaseLayout from "../layouts/BaseLayout.astro";
import { galleryAlbums as albums } from "../content/gallery.js";
import { organization } from "../content/home.js";
import galleryStyles from "../styles/pages/gallery.css?url";
---
<BaseLayout path="/gallery" title={`Event gallery | ${organization.name}`} description="Explore approved photographs from The Thriving Network GH events, outreach and community programmes." pageStyles={[galleryStyles]} breadcrumbs={[{name:"Home",path:"/"},{name:"Gallery",path:"/gallery"}]}>
  <main id="main-content" class="editorial-main gallery-page">
    <header class="gallery-intro">
      <h1>Our community, <span>in moments.</span></h1>
      <p>Photographs from TTNGH events, outreach and community programmes.</p>
      <a class="text-link" href="/events">Explore our events</a>
    </header>
    {albums.length > 0 ? <>
      <nav class="gallery-albums" aria-label="Event albums">{albums.map(album => <a class="text-link" href={`#${album.slug}`}>{album.title}</a>)}</nav>
      {albums.map(album => <section class="gallery-album" aria-labelledby={album.slug}>
        <header><h2 id={album.slug}>{album.title}</h2><p>{album.summary}</p></header>
        <div class="gallery-grid">{album.photos.map(photo => <figure data-reveal style={`--photo-ratio: ${photo.width / photo.height}`}>
          <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`${photo.alt} — open larger photograph in a new tab`}>
            <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" />
          </a>
        </figure>)}</div>
      </section>)}
    </> : <section class="gallery-empty"><h2>Event albums are on their way.</h2><p>Approved photographs will appear here when the TTNGH team publishes them.</p></section>}
  </main>
</BaseLayout>
