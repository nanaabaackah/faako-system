---
import Icon from "../components/Icon.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import errorStyles from "../styles/pages/error.css?url";
---

<BaseLayout title="Page not found | The Thriving Network GH" description="This TTNGH page is unavailable. Return home to explore our programmes, events and ways to get involved." path="/404" overlayHeader={true} pageStyles={[errorStyles]} noIndex={true}>
  <main id="main-content" class="error-page">
    <SiteHeader />
    <div class="error-message">

      <h1>This page is not available.</h1>
      <p>The link may be out of date, or the page may have moved.</p>
      <a class="button button-primary" href="/"><span class="button-label">Go back home</span><span class="button-icon" aria-hidden="true"><Icon name="arrow-right" focusable="false" /></span></a>
    </div>
    <p class="error-code" aria-hidden="true">404</p>
  </main>
</BaseLayout>
