---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CmsCards from "../components/CmsCards.astro";
import { contentOfType } from "../lib/cms-source.js";
const publishedProgrammes=await contentOfType("programme");
import FaqList from "../components/FaqList.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import { currentInitiatives, organization, programmePillars } from "../content/home.js";

const faqItems = [
  { question: "What are TTNGH's four programme areas?", answer: "TTNGH works through Mental Health Education, Counselling and Support Services, Advocacy and Awareness, and Research and Policy Engagement." },
  { question: "Does TTNGH provide counselling?", answer: "Yes. The company profile states that TTNGH provides professional one-on-one counselling alongside peer support and safe virtual and in-person community spaces." },
  { question: "Can TTNGH deliver outreach for an organisation?", answer: "TTNGH delivers mental health education for schools, workplaces, churches, community centres, and other community settings. Contact the team to discuss a programme." },
];
---

<BaseLayout path="/programmes" title={`Programs and services | ${organization.name}`} description="Explore TTN GH mental health education, counselling, support groups, advocacy, research, and policy engagement." image="/images/home/programme-audience.jpg" imageAlt="Students attending a TTNGH mental health education programme in Tema" breadcrumbs={[{ name: "Home", path: "/" }, { name: "Programs", path: "/programmes" }]} faqItems={faqItems}>
  <main id="main-content" class="editorial-main">
    <PageHero variant="immersive" links={[["Our pillars","#pillars-title"],["Current initiatives","#initiatives-title"]]} title="Support, education" accent="and advocacy." intro="Our four programme pillars work together to improve access to support, strengthen mental health knowledge, and reduce stigma." images={[
      { src: "/images/refresh/tema-school-speaker-1600.webp", alt: "A speaker holding a microphone in a school hall", caption: "School outreach · Presbyterian Senior High School, Tema" },
    ]} />
    <section class="section-dark" aria-labelledby="pillars-title">
      <div class="section-heading"><h2 id="pillars-title">Four programme pillars</h2></div>
      <div class="editorial-rows">
        {programmePillars.map((programme) => <article class="numbered-card editorial-row"><span>{programme.number}</span><div><h3>{programme.title}</h3><p>{programme.description}</p></div></article>)}
      </div>
    </section>
    <CmsCards documents={publishedProgrammes} title="Explore our programmes" />
    <section class="programme-initiatives" aria-labelledby="initiatives-title">
      <div class="section-heading"><h2 id="initiatives-title">How the work takes shape</h2></div>
      <div class="editorial-rows">{currentInitiatives.map((initiative) => <article class="editorial-row"><h3>{initiative.title}</h3><p>{initiative.description}</p></article>)}</div>
    </section>
    <FaqList items={faqItems} />
    <ScrollExpandSection image="/images/refresh/tema-school-team-1600.webp" alt="The TTNGH team during a mental health education programme in Tema" title="Ask about counselling, support groups, or outreach." text="Tell the team what kind of support or programme you are looking for." href="/contact" linkLabel="Contact our team" frameTitle="Support starts with a conversation." id="programme-contact-title" />
  </main>
</BaseLayout>
