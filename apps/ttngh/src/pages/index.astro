---
import Icon from "../components/Icon.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import EventCalendar from "../components/EventCalendar.astro";
import EditorialImage from "../components/EditorialImage.astro";
import eventStyles from "../styles/pages/events.css?url";
import HomePartnerBand from "../components/HomePartnerBand.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import { impactStats, programmePillars } from "../content/home.js";
import homeStyles from "../styles/pages/home.css?url";
import CmsCards from "../components/CmsCards.astro";
import { getCmsDocuments } from "../lib/cms-source.js";
const documents=await getCmsDocuments();
const homepage=documents.find(doc=>doc._type==="homePage");
const featuredProgrammes=documents.filter(doc=>doc._type==="programme"&&homepage?.featuredProgrammes?.includes(doc._id));
const featuredUpdates=documents.filter(doc=>["newsArticle","resource"].includes(doc._type)&&homepage?.featuredUpdates?.includes(doc._id));
const selectedStats=homepage?.impact?.length?impactStats.filter(stat=>homepage.impact.includes(stat._id)):impactStats;
---
<BaseLayout path="/" overlayHeader={true} pageStyles={[eventStyles, homeStyles]} image="/images/refresh/vision-community-1600.webp" imageAlt="People smiling and raising glasses around a table at Vision with Clarity">
<main id="main-content" class="home-main">
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-content"><h1 id="hero-title">{homepage?.heroTitle||<><span>Peace</span><br />Over Everything.</>}</h1><p class="hero-subtitle">{homepage?.heroSubtitle||"Together, we are building a stigma-free society through mental health education, advocacy, and community support."}</p><div class="actions">{(homepage?.actions?.length?homepage.actions.slice(0,2):[{href:"/programmes",label:"Explore our work"},{href:"/get-involved",label:"Get involved"}]).map((action,index)=><a class={`button button-${index===0?"primary":"secondary"}`} href={action.href}><span class="button-label">{action.label}</span><span class="button-icon" aria-hidden="true"><Icon name="external" /></span></a>)}</div></div>
    <figure class="hero-photograph"><img src="/images/refresh/vision-community-1600.webp" srcset="/images/refresh/vision-community-640.webp 640w, /images/refresh/vision-community-960.webp 960w, /images/refresh/vision-community-1600.webp 1600w" sizes="100vw" width="1600" height="1066" alt="People smiling and raising glasses around a table at Vision with Clarity" fetchpriority="high" decoding="async" /><figcaption>Vision with Clarity · TTNGH</figcaption></figure>
  </section>
  <section class="home-intro home-shell" aria-labelledby="intro-title"><figure><EditorialImage src="/images/refresh/tema-school-conversation-1600.webp" alt="TTNGH team members talking with people in a school hall" sizes="(max-width: 780px) 100vw, 45vw" loading="lazy" /><figcaption>School outreach · Presbyterian Senior High School, Tema</figcaption></figure><div class="intro-statement glass-card"><h2 id="intro-title">Room to speak.<br />Space to <em>thrive.</em></h2>{homepage?.introduction?<p>{homepage.introduction}</p>:<><p>The Thriving Network GH is a registered NGO based in Tema. Since July 2023, our work has brought education, advocacy, counselling, and peer support into communities.</p><p>We exist to challenge mental health stigma and help people seek support without fear.</p></>}<a class="text-link" href="/about">Meet The Thriving Network GH <Icon name="external" /></a></div></section>
  <section class="home-programmes home-shell" aria-labelledby="programmes-title"><div class="section-heading"><h2 id="programmes-title">What we do.</h2><p>Four connected areas of work, guided by one mission.</p></div><div class="programme-list">{programmePillars.map(p=><a href="/programmes" class="programme-row bubble-card motion-card"><span aria-hidden="true">{p.number}</span><h3>{p.title}</h3><p>{p.description}</p><span aria-hidden="true"><Icon name="external" /></span></a>)}</div></section>
  <section class="home-impact" aria-labelledby="impact-title"><div class="home-shell"><div class="section-heading"><h2 id="impact-title">A growing community.<br />A shared purpose.</h2><p>Explore the documented reach of TTNGH's work.</p></div><dl class="home-statistics">{selectedStats.map(stat=><div><dt>{stat.value}</dt><dd>{stat.label}</dd></div>)}</dl><a class="text-link" href="/impact">Explore our impact and milestones <Icon name="external" /></a></div></section>
  <section class="home-activity home-shell" aria-labelledby="activity-title"><figure><img src="/images/refresh/vision-conversation-960.webp" srcset="/images/refresh/vision-conversation-640.webp 640w, /images/refresh/vision-conversation-960.webp 960w" sizes="(max-width: 780px) 100vw, 45vw" width="960" height="640" alt="Participants listening together around a table" loading="lazy" decoding="async" /><figcaption>Vision with Clarity</figcaption></figure><div><h2 id="activity-title">Time to reflect.<br />People to connect with.</h2><p>Vision with Clarity is our annual programme for reflection, intention, and personal well-being, launched in 2026.</p><p>Monthly support groups and school and community outreach continue alongside it. Contact the team for confirmed dates and availability.</p><a class="text-link" href="/events">Explore our events <Icon name="external" /></a></div></section>
  {featuredProgrammes.length>0&&<div class="home-shell"><CmsCards documents={featuredProgrammes} title="Explore our programmes" /></div>}
  <div class="home-calendar home-shell"><EventCalendar showListings featuredEventId={homepage?.featuredEvent} /></div>
  {featuredUpdates.length>0&&<div class="home-shell"><CmsCards documents={featuredUpdates} title="Latest from TTNGH" /></div>}
  <ScrollExpandSection image="/images/refresh/vision-facilitator-1600.webp" alt="A speaker addressing participants at Vision with Clarity" title="There is a place for you in this work." text="Give your time, share your expertise, or partner with TTNGH to bring mental health education and support to more communities." href="/get-involved" linkLabel="Get involved" frameTitle="Together, we thrive." id="get-involved-title" />
  <section class="home-updates home-shell" aria-labelledby="updates-title"><h2 id="updates-title">Keep the conversation going.</h2><div><p>Explore our programme highlights and the topics shaping our work. Approved news and educational resources will be published as they become available.</p><a class="text-link" href="/news">News and resources <Icon name="external" /></a><a class="text-link" href="/support-us">Help fund our work <Icon name="external" /></a></div></section>
  <HomePartnerBand />
</main>
</BaseLayout>
