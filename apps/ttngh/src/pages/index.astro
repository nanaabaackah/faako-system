---
import Icon from "../components/Icon.jsx";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedEvent from "../components/FeaturedEvent.astro";
import ImpactFigures from "../components/ImpactFigures.astro";
import EditorialImage from "../components/EditorialImage.astro";
import HomePartnerBand from "../components/HomePartnerBand.astro";
import ScrollExpandSection from "../components/ScrollExpandSection.astro";
import HomeProgrammes from "../components/HomeProgrammes.astro";
import { impactStats } from "../content/home.js";
import homeStyles from "../styles/pages/home.css?url";
import CmsCards from "../components/CmsCards.astro";
import { getCmsDocuments } from "../lib/cms-source.js";
const documents=await getCmsDocuments();
const homepage=documents.find(doc=>doc._type==="homePage");
const featuredProgrammes=documents.filter(doc=>doc._type==="programme"&&homepage?.featuredProgrammes?.includes(doc._id));
const featuredUpdates=documents.filter(doc=>["newsArticle","resource"].includes(doc._type)&&(!homepage?.featuredUpdates?.length||homepage.featuredUpdates.includes(doc._id))).sort((a,b)=>Date.parse(b.publishedAt)-Date.parse(a.publishedAt)).slice(0,3);
const selectedStats=homepage?.impact?.length?impactStats.filter(stat=>homepage.impact.includes(stat._id)):impactStats;
---
<BaseLayout path="/" overlayHeader={true} pageStyles={[homeStyles]} image="/images/refresh/vision-community-1600.webp" imageAlt="People smiling and raising glasses around a table at Vision with Clarity">
<main id="main-content" class="home-main">
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-content"><h1 id="hero-title">{homepage?.heroTitle||<><span>Peace</span><br />Over Everything.</>}</h1><p class="hero-subtitle">{homepage?.heroSubtitle||"Together, we are building a stigma-free society through mental health education, advocacy, and community support."}</p><div class="actions">{(homepage?.actions?.length?homepage.actions.slice(0,2):[{href:"/programmes",label:"Explore our work"},{href:"/get-involved",label:"Get involved"}]).map((action,index)=><a class={`button button-${index===0?"primary":"secondary"}`} href={action.href}><span class="button-label">{action.label}</span><span class="button-icon" aria-hidden="true"><Icon name="external" /></span></a>)}</div></div>
    <figure class="hero-photograph"><img src="/images/refresh/vision-community-1600.webp" srcset="/images/refresh/vision-community-640.webp 640w, /images/refresh/vision-community-960.webp 960w, /images/refresh/vision-community-1600.webp 1600w" sizes="100vw" width="1600" height="1066" alt="People smiling and raising glasses around a table at Vision with Clarity" fetchpriority="high" decoding="async" /><figcaption>Vision with Clarity · TTNGH</figcaption></figure>
  </section>
  <div class="home-value-strip" data-reveal aria-label="Our work">{[["question", "Education", "Mental health knowledge for everyday life."], ["people", "Community", "Space for connection and conversation."], ["heart", "Support", "Counselling and peer support."], ["external", "Advocacy", "Challenging stigma together."]].map(([icon, label, detail]) => <span><Icon name={icon} /><strong>{label}</strong><small>{detail}</small></span>)}</div>
  <section class="home-intro home-shell" data-reveal aria-labelledby="intro-title"><figure><EditorialImage src="/images/refresh/tema-school-conversation-1600.webp" alt="TTNGH team members talking with people in a school hall" sizes="(max-width: 780px) 100vw, 45vw" loading="lazy" /><figcaption>School outreach · Presbyterian Senior High School, Tema</figcaption></figure><div class="intro-statement"><h2 id="intro-title">Room to speak.<br />Space to <em>thrive.</em></h2>{homepage?.introduction?<p>{homepage.introduction}</p>:<><p>The Thriving Network GH is a registered NGO based in Tema. Since July 2023, our work has brought education, advocacy, counselling, and peer support into communities.</p><p>We exist to challenge mental health stigma and help people seek support without fear.</p></>}<a class="text-link" href="/about">Meet The Thriving Network GH <Icon name="external" /></a></div></section>
  <HomeProgrammes />
  <section class="home-impact" data-reveal aria-labelledby="impact-title"><div class="home-shell"><div class="section-heading"><h2 id="impact-title">A growing community.<br />A shared purpose.</h2><p>Explore the documented reach of TTNGH's work.</p></div><ImpactFigures stats={selectedStats} /><a class="text-link" href="/impact">Explore our impact and milestones <Icon name="external" /></a></div></section>
  {featuredProgrammes.length>0&&<div class="home-shell"><CmsCards documents={featuredProgrammes} title="Explore our programmes" /></div>}
  <FeaturedEvent featuredEventId={homepage?.featuredEvent} />
  <div class="home-shell">{featuredUpdates.length ? <CmsCards documents={featuredUpdates} title="Latest from TTNGH" /> : <section class="home-updates"><h2>Keep the conversation going.</h2><div><p>Approved news and reviewed educational resources will appear here as they become available.</p><a class="text-link" href="/news">Explore news <Icon name="arrow-right" /></a><a class="text-link" href="/resources">Reviewed resources <Icon name="arrow-right" /></a></div></section>}</div>
  <ScrollExpandSection image="/images/refresh/vision-facilitator-1600.webp" alt="A speaker addressing participants at Vision with Clarity" title="There is a place for you in this work." text="Give your time, share your expertise, or partner with TTNGH to bring mental health education and support to more communities." href="/get-involved" linkLabel="Get involved" frameTitle="Together, we thrive." id="get-involved-title" />
  <HomePartnerBand />
</main>
</BaseLayout>
