# TTNGH WEBSITE — copy to apps/ttngh/.env locally.
# Production values go in the website host's build environment.
# PUBLIC_ values are visible to visitors: never put secrets in them.
# Commented examples are placeholders; empty optional values keep services off.
# Restart development / rebuild after changing environment values.

# Optional GA4 measurement ID. Analytics still requires visitor consent.
# Example: PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=

# Optional and non-secret. Use only the ID of TTNGH's approved public Google Calendar.
# Example: PUBLIC_TTNGH_GOOGLE_CALENDAR_ID=REPLACE_WITH_CALENDAR_ID@group.calendar.google.com
PUBLIC_TTNGH_GOOGLE_CALENDAR_ID=
PUBLIC_SITE_URL=https://thethrivingnetworkgh.org
# Enable only for the production deployment. Previews must remain false.
PUBLIC_SITE_INDEXABLE=false

# Build-time CMS configuration. Never prefix a read token with PUBLIC_.
# Approved project: d5k303l7; dataset: production.
# SANITY_PROJECT_ID=d5k303l7
# SANITY_DATASET=production
# Set both only when the private read token and approved content are ready.
# Leave both blank for local content; false below does not disable configured CMS.
SANITY_PROJECT_ID=
SANITY_DATASET=
# Example: SANITY_READ_TOKEN=REPLACE_WITH_READ_ONLY_SANITY_TOKEN
# Use a read-only build token, never an editor/write token.
SANITY_READ_TOKEN=
# Set true after CMS activation: missing configuration must stop production builds.
TTNGH_CMS_REQUIRED=false

# Non-secret, exact HTTPS Railway API origin. Blank keeps the online form disabled.
# Example: PUBLIC_TTNGH_API_ORIGIN=https://REPLACE_WITH_TTNGH_SERVICE.up.railway.app
# No path or trailing slash. Set both API origin and widget key to enable the form.
PUBLIC_TTNGH_API_ORIGIN=
# Example: PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_PUBLIC_TURNSTILE_SITE_KEY
# Public widget key, NOT the Turnstile server secret.
PUBLIC_TURNSTILE_SITE_KEY=

# Approved HTTPS Studio URL. No CMS credentials belong in this public variable.
# Example: PUBLIC_TTNGH_STUDIO_URL=https://REPLACE_WITH_STUDIO_NAME.sanity.studio
PUBLIC_TTNGH_STUDIO_URL=

# OTHER CONFIGURATION FILES — do not copy server secrets into this website file:
# apps/ttngh/studio/.env.example: Sanity Studio identifiers.
# services/ttngh-api/.env.example: Railway, email, Turnstile secret, CMS rebuild
# webhook, Paystack and dedicated PostgreSQL configuration.
# Hosted Paystack checkout requires no public Paystack key in this website.
# Search Console verification, DNS, email routing/SPF/DKIM/DMARC and WAF are
# provider-console setup, not currently consumed website environment variables.
