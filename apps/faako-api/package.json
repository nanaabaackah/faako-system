{
  "name": "@faako/faako-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:backend",
    "dev:backend": "node ../../scripts/run-with-env-file.mjs .env.dev -- node src/server.js",
    "server": "node src/server.js",
    "lint": "eslint .",
    "prisma:generate": "node ../../scripts/run-with-env-file.mjs .env.dev -- prisma generate",
    "prisma:migrate": "node ../../scripts/run-with-env-file.mjs .env.dev -- prisma migrate dev",
    "prisma:migrate:deploy": "node ../../scripts/run-with-env-file.mjs .env.dev -- prisma migrate deploy",
    "predeploy:local": "pnpm run prisma:migrate:deploy && pnpm run prisma:migrate:status",
    "predeploy": "pnpm run predeploy:local",
    "build": "echo \"No build step required for faako-api\"",
    "start": "node src/server.js",
    "prisma:migrate:status": "node ../../scripts/run-with-env-file.mjs .env.dev -- prisma migrate status"
  },
  "dependencies": {
    "@faako/security": "workspace:*",
    "@prisma/client": "^7.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.17.1",
    "pg-connection-string": "^2.12.0",
    "pg-int8": "^1.0.1",
    "pg-pool": "^3.10.1",
    "pg-protocol": "^1.10.3",
    "pg-types": "^2.2.0",
    "pgpass": "^1.0.5",
    "postgres-array": "^2.0.0",
    "postgres-bytea": "^1.0.0",
    "postgres-date": "^1.0.7",
    "postgres-interval": "^1.2.0",
    "split2": "^4.2.0",
    "xtend": "^4.0.2"
  },
  "devDependencies": {
    "prisma": "^7.3.0"
  }
}
