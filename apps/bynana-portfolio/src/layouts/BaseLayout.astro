---
import '@faako/ui/compat.css';
import '../styles/global.css';
import PortfolioApp from '../components/PortfolioApp.jsx';
import {
  DEFAULT_IMAGE,
  SITE_NAME,
  SITE_URL,
  buildStructuredData,
  getSeoForPath,
} from '../content/seo.js';

const { path = Astro.url.pathname, status = 200 } = Astro.props;
const seo = getSeoForPath(path);
const canonical = new URL(path === '/' ? '/' : path, SITE_URL).toString();
const image = new URL(seo.image || DEFAULT_IMAGE, SITE_URL).toString();
const structuredData = buildStructuredData(path, seo);
const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const imageAlt = `${seo.name || 'Nana Aba Ackah'} preview`;

if (status !== 200) Astro.response.status = status;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ebe5d4" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content="Nana Aba Ackah" />
    <meta name="robots" content={seo.noIndex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/assets/icon.svg" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GH" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:type" content={seo.type || 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
  </head>
  <body>
    {
      path === '/contact' ? (
        <PortfolioApp staticLocation={path} client:load />
      ) : (
        <PortfolioApp staticLocation={path} client:idle={{ timeout: 2000 }} />
      )
    }
    <noscript>This portfolio works best with JavaScript enabled, but all page content remains available in the HTML.</noscript>
    <script is:inline>
      document.documentElement.classList.add('js');
      const savedTheme = window.localStorage.getItem('bynana-theme');
      if (savedTheme === 'dark' || savedTheme === 'light') {
        document.documentElement.dataset.theme = savedTheme;
        document.documentElement.dataset.themePreference = savedTheme;
      } else {
        document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        document.documentElement.dataset.themePreference = 'system';
      }

      // The compatibility island still uses React Router links. Keep Astro in
      // control of public routing so each navigation loads the route-specific
      // document head, canonical URL, and structured data.
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!anchor || anchor.target || anchor.hasAttribute('download')) return;

        const destination = new URL(anchor.href, window.location.href);
        if (destination.origin !== window.location.origin) return;
        if (destination.pathname === window.location.pathname && destination.search === window.location.search) return;

        event.preventDefault();
        event.stopImmediatePropagation();
        window.location.assign(destination.href);
      }, true);
    </script>
  </body>
</html>
