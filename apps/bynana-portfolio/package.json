{
  "name": "@faako/bynana-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/optimize-dist-images.mjs",
    "lint": "eslint .",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "pnpm run test:seo && pnpm run test:standards",
    "test:seo": "node --test tests/seo-output.test.mjs",
    "test:standards": "node --test tests/standards-output.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@faako/ui": "workspace:*",
    "animejs": "^4.3.6",
    "astro": "^7.1.3",
    "iconsax-react": "^0.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.2",
    "tailwindcss": "^4.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "sharp": "^0.34.5"
  }
