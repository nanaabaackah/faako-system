# ── Demo access gate (Netlify function) ─────────────────────────────────────
# Required: signs and verifies the one-time access code tokens.
FAAKO_ERP_DEMO_ACCESS_SECRET=replace-with-long-random-secret

# Optional: comma-separated extra origins allowed to call /api/demo-access.
# The deployed site's own origin is always auto-allowed via request headers.
FAAKO_ERP_DEMO_ACCESS_ALLOWED_ORIGINS=https://faako-erp.nanaabaackah.com

# ── Email delivery (Resend) ──────────────────────────────────────────────────
# Required for real email delivery. Without these the gate falls back to
# preview mode and shows the code on screen instead of sending an email.
RESEND_API_KEY=re_replace_with_real_key
RESEND_FROM_EMAIL=faako@nanaabaackah.com
RESEND_FROM_NAME=Faako

# ── Admin / notifications ────────────────────────────────────────────────────
INTAKE_ADMIN_EMAIL=dev@nanaabaackah.com
ADMIN_EMAIL=faako@nanaabaackah.com

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://faako.nanaabaackah.com
