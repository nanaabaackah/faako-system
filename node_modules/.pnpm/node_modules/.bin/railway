#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/Nana/Desktop/Developer/faako-new/node_modules/.pnpm/railway@2.0.17_@types+react@19.2.14/node_modules/railway/node_modules:/Users/Nana/Desktop/Developer/faako-new/node_modules/.pnpm/railway@2.0.17_@types+react@19.2.14/node_modules:/Users/Nana/Desktop/Developer/faako-new/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/Nana/Desktop/Developer/faako-new/node_modules/.pnpm/railway@2.0.17_@types+react@19.2.14/node_modules/railway/node_modules:/Users/Nana/Desktop/Developer/faako-new/node_modules/.pnpm/railway@2.0.17_@types+react@19.2.14/node_modules:/Users/Nana/Desktop/Developer/faako-new/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../railway/dist/index.js" "$@"
else
  exec node  "$basedir/../railway/dist/index.js" "$@"
fi
