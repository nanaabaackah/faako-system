# Dedicated server/operator job only. Never configure these on the Astro website.
# Copy to .env.media-sync (ignored); do not paste secrets into chat or reports.
TTNGH_MEDIA_ENV=staging
GOOGLE_DRIVE_MEDIA_FOLDER_ID=1ifwYbrAS88Q3DrYps1xMpMbkLn3QTa51
# JSON service account with Viewer access to this folder only, no domain delegation.
