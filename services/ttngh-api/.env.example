# TTNGH API — SERVER ONLY. Copy to services/ttngh-api/.env locally.
# Set production values privately in Railway. Never commit real .env files.
# Never prefix secrets with PUBLIC_ or VITE_. Commented values are placeholders.

# Runtime: use production on Railway; Railway may supply PORT automatically.
NODE_ENV=development
PORT=5180
# Exact comma-separated origins; no wildcard, path or trailing slash.
# Production example: TTNGH_ALLOWED_ORIGINS=https://thethrivingnetworkgh.org
TTNGH_ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
# Current in-memory request limits require one replica.
RAILWAY_REPLICA_COUNT=1

# Contact delivery: enable only after widget and email setup are verified.
TTNGH_CONTACT_ENABLED=false
# Example: TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SERVER_SECRET
TURNSTILE_SECRET_KEY=
# Hostnames only; production example: thethrivingnetworkgh.org
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Transactional email, not Cloudflare incoming email-routing credentials.
# Example: RESEND_API_KEY=REPLACE_WITH_RESEND_SEND_ONLY_KEY
RESEND_API_KEY=
# Example: TTNGH_MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER@example.org
# A verified plain email address without a display name.
TTNGH_MAIL_FROM=
# Example: TTNGH_ENQUIRY_TO=REPLACE_WITH_APPROVED_RECEIVING_INBOX@example.org
TTNGH_ENQUIRY_TO=
# Enable only after acknowledgement wording/policy approval.
TTNGH_ACKNOWLEDGEMENT_APPROVED=false
# Example: TTNGH_TRUSTED_PROXY_CIDRS=REPLACE_WITH_VERIFIED_PROXY_CIDRS
# Leave blank until actual Railway proxy topology is verified; never use '*'.
TTNGH_TRUSTED_PROXY_CIDRS=

# Signed CMS publish hook. Identifiers are public; signing secret/hook URL are not.
SANITY_PROJECT_ID=d5k303l7
SANITY_DATASET=production
# Example: SANITY_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SHARED_WEBHOOK_SECRET
# Must match the Sanity webhook signing secret.
SANITY_WEBHOOK_SECRET=
# Example: CLOUDFLARE_BUILD_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/REPLACE_WITH_PRIVATE_HOOK_ID
# Full hook URL is secret. No general Cloudflare API token is needed here.
CLOUDFLARE_BUILD_HOOK_URL=

# Payment foundation only; routes/worker activation is still pending.
# Keep both flags false. Filling values does not complete/enable the integration.
TTNGH_DONATIONS_ENABLED=false
PAYSTACK_MODE=test
# Example: PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_TEST_SECRET_KEY
# Real key must match PAYSTACK_MODE; never put this in the public website.
PAYSTACK_SECRET_KEY=
TTNGH_LIVE_PAYMENTS_APPROVED=false
# Dedicated TTNGH database only. Never reuse REEBS credentials.
# Example: TTNGH_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_TTNGH_DATABASE
# Use provisioned connection settings and a reviewed transport-security policy.
TTNGH_DATABASE_URL=
# For test deployments, use their approved HTTPS origin with /donate/return.
TTNGH_DONATION_RETURN_URL=https://thethrivingnetworkgh.org/donate/return
# GH₵1 minimum/no TTNGH fundraising maximum is enforced in code, not env vars.
