{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pnpm --filter @faako/ttngh-api... install --frozen-lockfile" },
  "deploy": { "startCommand": "pnpm --filter @faako/ttngh-api start", "healthcheckPath": "/health", "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3, "numReplicas": 1 }
}
