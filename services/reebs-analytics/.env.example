# Variable names and JSON shape only. Keep real credentials in the deployment platform.
PORT="8010"
FAAKO_ANALYTICS_LOG_LEVEL="INFO"

# Preferred: one scoped principal per approved backend caller.
# Keep this JSON on one line in Railway. Replace the secret and tenant allow-list.
FAAKO_ANALYTICS_SERVICE_TOKENS='{"reebs-backend":{"secret":"replace-me","applicationIds":["reebs"],"tenantIds":["1"]}}'

# Compatibility-only REEBS credential. Leave unset when the scoped configuration above is used.
FAAKO_ANALYTICS_SERVICE_SECRET=""
REEBS_ANALYTICS_SERVICE_SECRET=""
REEBS_ANALYTICS_TENANT_IDS=""
